<!DOCTYPE html>
<html lang="@ViewData["Language"]">
<head>

    <meta http-equiv="Content-Type" content="text/html,charset=utf-8">
    <meta name="viewport" content="width=1125,user-scalable=no">
    <link href="https://asset.resleriana.jp/static/production/assets/detail-40c27966d39094911ba61291ad622026.css" rel="stylesheet" type="text/css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=M+PLUS+1p:wght@400;700&display=swap" rel="stylesheet">
    <meta name="format-detection" content="telephone=no">
    <meta property="og:type" content="article">
    <meta property="og:site_name" content="Atelier Resleriana">
    <meta property="og:url" content="https://info.resleriana.jp/news/1057360?k=oBri-org&amp;language=ja">
    <meta property="og:image" content="https://asset.resleriana.jp/static/production/images/ogp/ja/001-4ce6375d4fed0dba1b6c999e0c2314c4.jpg">
    <meta property="og:title" content="Atelier Resleriana">
    <meta property="og:description" content="@ViewData["Title"]">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:site" content="@@Atelier_Resleri">
    <title>@ViewData["Title"]</title>
    <link rel="icon" href="data:,">
    <script defer type="text/javascript" src="https://asset.resleriana.jp/static/production/assets/detail-87b4409f9ae9fc95dc94a02f5b1e7b2e.js">
    </script>
</head>

<body class="pc-screen">
    <div id="language" class="hidden" data-language="@ViewData["Language"]"></div>
    <div id="dialog-overlay" class="hidden"></div>
    <div id="portrait-wrapper" class="pc-screen">
        <div class="notice_alert js-dialog hidden"></div>
        <div class="pc-screen notice_main">

            <div class="notice_main_contents">
                <div class="notice_contents_header">
                    <p class="notice_contents_header_sns">

                    </p>
                    <p class="notice_contents_header_date">
                        @ViewData["Date"]
                    </p>
                </div>
                <div class="notice_contents_main">
                    <h1>@ViewData["Title"]</h1>
                    <div class="notice_contents_main_detail">
                        @Html.Raw(ViewData["Content"])
                    </div>
                </div>
            </div>
        </div>
        <div class="notice_bottom hidden js-return-button">
            <div class="notice_bottom_btn">
                <a href=".">
                    <img src="/static/globalproduction/images/en/back-51600874367418cacbc2b7a868a24962.png" width="184px" height="92px">
                </a>
            </div>
        </div>
    </div>
    <script type="text/javascript">
        window.addEventListener("DOMContentLoaded", _ => detail.init())
    </script>
</body>
</html>