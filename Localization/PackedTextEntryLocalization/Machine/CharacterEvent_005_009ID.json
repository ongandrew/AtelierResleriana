[
  {
    "id": 0,
    "properties": {
      "999008199": {
        "text": "キュルル～♪",
        "localizations": {
          "en": "Kyururu~♪"
        }
      },
      "2072370017": {
        "text": "魔物の子ども",
        "localizations": {
          "en": "Monster Offspring"
        }
      }
    }
  },
  {
    "id": 1,
    "properties": {
      "999008199": {
        "text": "にしても、随分美味しそうに食べてくれるねぇ。\n僕も食べてみちゃおうかな",
        "localizations": {
          "en": "You know, it's really enjoying that fruit. Makes me want to try some myself."
        }
      },
      "2072370017": {
        "text": "シトリン",
        "localizations": {
          "en": "Citrine"
        }
      }
    }
  },
  {
    "id": 2,
    "properties": {
      "999008199": {
        "text": "つまみ食いも悪くないけど、\n調合する分は残しといておくれよ",
        "localizations": {
          "en": "A little snack wouldn't hurt, but make sure you leave some for synthesis."
        }
      },
      "2072370017": {
        "text": "イェルカ",
        "localizations": {
          "en": "Jelka"
        }
      }
    }
  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "大丈夫だって。ヴァレリアみたいに\n食い意地張ってないんだから",
        "localizations": {
          "en": "Don't worry about it. I'm not a glutton like Valeria."
        }
      },
      "2072370017": {
        "text": "シトリン",
        "localizations": {
          "en": "Citrine"
        }
      }
    }
  },
  {
    "id": 4,
    "properties": {
      "999008199": {
        "text": "ふぅ……ま、こんなもんかね。\nさ、集落に戻ってゴゥたちと合流しよう",
        "localizations": {
          "en": "*sigh* Well, I guess that's good enough. Come on, let's head back to the settlement and meet up with Gou and the others."
        }
      },
      "2072370017": {
        "text": "イェルカ",
        "localizations": {
          "en": "Jelka"
        }
      }
    }
  },
  {
    "id": 5,
    "properties": {
      "999008199": {
        "text": "おー、よしよしよし、\n小さいうちはかわいいもんだねぇ",
        "localizations": {
          "en": "Aww, there, there, little guy. You're pretty cute when you're this small."
        }
      },
      "2072370017": {
        "text": "シトリン",
        "localizations": {
          "en": "Citrine"
        }
      }
    }
  },
  {
    "id": 6,
    "properties": {
      "999008199": {
        "text": "キュル！\u3000キュルッ！",
        "localizations": {
          "en": "Kyuru! Kyuru!"
        }
      },
      "2072370017": {
        "text": "魔物の子ども",
        "localizations": {
          "en": "Monster Offspring"
        }
      }
    }
  },
  {
    "id": 7,
    "properties": {
      "999008199": {
        "text": "ほらシトリン、遊んでないで帰るよ！",
        "localizations": {
          "en": "Hey Citrine, quit playing around and let's go!"
        }
      },
      "2072370017": {
        "text": "イェルカ",
        "localizations": {
          "en": "Jelka"
        }
      }
    }
  },
  {
    "id": 8,
    "properties": {
      "999008199": {
        "text": "へーい",
        "localizations": {
          "en": "Yeah, yeah..."
        }
      },
      "2072370017": {
        "text": "シトリン",
        "localizations": {
          "en": "Citrine"
        }
      }
    }
  },
  {
    "id": 9,
    "properties": {
      "999008199": {
        "text": "あと半分持つ。サボった分は働いてもらうからね。\n働かざる者食うべからずだよ！",
        "localizations": {
          "en": "You're carrying the other half. Since you slacked off, now you get to work. No work, no food!"
        }
      },
      "2072370017": {
        "text": "イェルカ",
        "localizations": {
          "en": "Jelka"
        }
      }
    }
  },
  {
    "id": 10,
    "properties": {
      "999008199": {
        "text": "へいへーい……",
        "localizations": {
          "en": "Fine, fine..."
        }
      },
      "2072370017": {
        "text": "シトリン",
        "localizations": {
          "en": "Citrine"
        }
      }
    }
  },
  {
    "id": 11,
    "properties": {
      "999008199": {
        "text": "ただいま帰りましたよー……っと。\nんん？",
        "localizations": {
          "en": "We're back... Huh?"
        }
      },
      "2072370017": {
        "text": "シトリン",
        "localizations": {
          "en": "Citrine"
        }
      }
    }
  },
  {
    "id": 12,
    "properties": {
      "999008199": {
        "text": "誰もいない……",
        "localizations": {
          "en": "Nobody's here..."
        }
      },
      "2072370017": {
        "text": "シトリン",
        "localizations": {
          "en": "Citrine"
        }
      }
    }
  },
  {
    "id": 13,
    "properties": {
      "999008199": {
        "text": "あっち！\u3000裏のほうから聞こえるよ！\n悲鳴と、金属の響く音、これは……",
        "localizations": {
          "en": "Over there! I can hear something from the back! Screaming and the clash of metal—..."
        }
      },
      "2072370017": {
        "text": "イェルカ",
        "localizations": {
          "en": "Jelka"
        }
      }
    }
  },
  {
    "id": 14,
    "properties": {
      "999008199": {
        "text": "魔物の襲撃！！",
        "localizations": {
          "en": "It's a monster attack!!"
        }
      },
      "2072370017": {
        "text": "シトリン",
        "localizations": {
          "en": "Citrine"
        }
      }
    }
  }
