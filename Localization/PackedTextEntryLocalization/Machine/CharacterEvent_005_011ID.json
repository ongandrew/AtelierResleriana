      "2072370017": {
        "text": "ゴゥ",
        "localizations": {
          "en": "Gou"
        }
      }
    }
  },
  {
    "id": 7,
    "properties": {
      "999008199": {
        "text": "おお……かっこいい……",
        "localizations": {
          "en": "Wow... so cool..."
        }
