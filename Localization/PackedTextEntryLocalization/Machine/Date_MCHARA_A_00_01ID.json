        "text": "\u30E9\u30A4\u30B6\u5148\u8F29\u306B\u306F\u3001\u79C1\u3088\u308A\u305A\u3063\u3068\n\u591A\u304F\u306E\u3082\u306E\u304C\u898B\u3048\u3066\u3044\u308B\u3093\u3067\u3057\u3087\u3046\u306D",
