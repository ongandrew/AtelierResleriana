        "text": "\u6B21\u306E\u65E5\u304C\u697D\u3057\u307F\u3059\u304E\u308B\u3068\u3001\n\u306A\u304B\u306A\u304B\u5BDD\u4ED8\u3051\u306A\u3044\u3063\u3066\uFF01",
