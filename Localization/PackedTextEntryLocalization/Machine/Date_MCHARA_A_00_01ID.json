  {
    "id": 40,
    "properties": {
      "999008199": {
        "text": "\u307E\u3060\u6210\u529F\u3057\u306A\u3044\u8ABF\u5408\u3082\u3001\n\u565B\u307F\u7815\u3051\u306A\u3044\u7406\u8AD6\u3082\u305F\u304F\u3055\u3093\u3042\u308B\u306E\u306B\u2026\u2026",
