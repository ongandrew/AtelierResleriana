        "text": "\u540C\u3058\u7D20\u6750\u3067\u3082\u3001\u571F\u5730\u306B\u3088\u3063\u3066\n\u5F62\u3084\u751F\u80B2\u5EA6\u304C\u7570\u306A\u308A\u307E\u3059\u3057\u2026\u2026\n\u3042\u3063\u3001\u9B54\u7269\u3082\u9055\u3044\u307E\u3059\u3088\u306D",
        "localizations": {
