        "text": "\u8A66\u4F5C\u3057\u305F\u3089\u3001\u3082\u3089\u3063\u3066\u3044\u305F\u3060\u3051\u307E\u3059\u304B\uFF1F\n\u30E9\u30A4\u30B6\u5148\u8F29\uFF01",
