  {
    "id": 48,
    "properties": {
      "999008199": {
        "text": "\u3053\u3046\u3044\u3046\u306E\u306F\u3001\u8B77\u885B\u3059\u308B\u5074\u3060\u3051\u3058\u3083\u306A\u304F\n\u8B77\u885B\u3055\u308C\u308B\u5074\u306E\u610F\u8B58\u3082\u5927\u5207\u3060\u304B\u3089\u3002\n\u79C1\u306E\u7D4C\u9A13\u5247\u3060\u3051\u3069",
        "localizations": {
          "en": "This isn\u0027t just about the escort,\nbut also about the one being escorted\nbeing aware. That\u0027s from my experience."
