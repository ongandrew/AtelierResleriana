        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 30,
    "properties": {
      "999008199": {
        "text": "\u305D\u308C\u3060\u3051\u3060\u3063\u305F\u3051\u308C\u3069\u3001\u305D\u308C\u3067\u3082\n\u8F9B\u305D\u3046\u306A\u30D5\u30ED\u30C3\u30B1\u306E\u652F\u3048\u306B\u306A\u308C\u3066\u3044\u305F\u306E\u306A\u3089\n\u2026\u2026\u3088\u304B\u3063\u305F\u308F",
        "localizations": {
