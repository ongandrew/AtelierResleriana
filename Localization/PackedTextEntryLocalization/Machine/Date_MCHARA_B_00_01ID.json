  {
    "id": 29,
    "properties": {
      "999008199": {
        "text": "\u2026\u2026\u79C1\u306F\u85AC\u3082\u6599\u7406\u3082\u4F5C\u308C\u306A\u3044\u304B\u3089\u3001\n\u305B\u3081\u3066\u305D\u3070\u306B\u3044\u3088\u3046\u3063\u3066\u601D\u3063\u305F\u306E",
        "localizations": {
          "en": "...I can\u0027t make medicine or cook,\nso I thought I could at least stay by her side."
        }
