    }
  },
  {
    "id": 56,
    "properties": {
      "999008199": {
        "text": "\u306D\u3048\u3001\u30CF\u30A4\u30C7\u30A3\u3001\u30D5\u30ED\u30C3\u30B1\u3002\n\u3053\u308C\u304B\u3089\u306F\u79C1\u3092\u59C9\u3068\u3057\u3066\n\u3082\u3063\u3068\u7518\u3048\u3066\u3044\u3044\u308F\u3088",
        "localizations": {
          "en": "Hey, Heidi, Flocke.\nFrom now on, you can rely on me\nas your big sister too!"
