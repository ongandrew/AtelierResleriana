  },
  {
    "id": 55,
    "properties": {
      "999008199": {
        "text": "\u59C9\u3068\u3057\u3066\u632F\u308B\u821E\u3046\u306E\u3063\u3066\u3001\n\u3053\u3093\u306A\u7D20\u6575\u306A\u3053\u3068\u306A\u306E\u306D\uFF01\n\u306A\u3093\u3060\u308D\u3046\u3001\u3053\u306E\u3057\u3063\u304F\u308A\u304D\u3066\u308B\u611F",
