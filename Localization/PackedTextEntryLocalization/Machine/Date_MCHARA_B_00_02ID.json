    }
  },
  {
    "id": 58,
    "properties": {
      "999008199": {
        "text": "\u9060\u616E\u3057\u306A\u304F\u3066\u3044\u3044\u306E\u3088\u3002\n\u307B\u3089\u3001\u3053\u3063\u3061\u306B\u6765\u306A\u3055\u3044",
