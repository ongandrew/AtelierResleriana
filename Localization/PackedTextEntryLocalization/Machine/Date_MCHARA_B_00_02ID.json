        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 57,
    "properties": {
      "999008199": {
        "text": "\u307E\u3041\u5BB6\u65CF\u69CB\u6210\u7684\u306B\u306F\u3001\u3042\u3093\u305F\u304C\u9577\u5973\n\u3067\u306F\u3042\u308B\u3051\u3069\u3001\u79C1\u306F\u2026\u2026\n\u76F8\u68D2\u3068\u3057\u3066\u306E\u7ACB\u3061\u4F4D\u7F6E\u304C\u5F37\u3044\u304B\u3089\u306A\u3041",
        "localizations": {
          "en": "Well, family-wise you would be the eldest,\nbut I feel more like...\na partner than anything."
