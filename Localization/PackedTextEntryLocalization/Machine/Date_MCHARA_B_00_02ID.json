  {
    "id": 50,
    "properties": {
      "999008199": {
        "text": "\u30A2\u30FC\u30B7\u30E3\u3063\u305F\u3089\uFF01\n\u5B09\u3057\u3044\u3053\u3068\u8A00\u3063\u3066\u304F\u308C\u308B\u3058\u3083\u306A\u3044\uFF01\n\u304A\u4E16\u8F9E\u3060\u3068\u3057\u3066\u3082\u5B09\u3057\u3044\u308F",
        "localizations": {
          "en": "Oh, Ayesha!\nYou\u0027re saying such sweet things!\nEven if it\u0027s just flattery, I\u0027m happy!"
