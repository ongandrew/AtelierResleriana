    }
  },
  {
    "id": 51,
    "properties": {
      "999008199": {
        "text": "\u304A\u4E16\u8F9E\u306A\u3093\u304B\u3058\u3083\u306A\u3044\u3067\u3059\u3088\u3002\n\u308F\u305F\u3057\u3082\u304A\u59C9\u3061\u3083\u3093\u307F\u305F\u3044\u306B\u306A\u308A\u305F\u3044\u3067\u3059",
        "localizations": {
          "en": "It\u0027s not flattery at all.\nI want to be just like you, Big Sis!"
