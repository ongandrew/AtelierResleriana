  {
    "id": 52,
    "properties": {
      "999008199": {
        "text": "\u305D\u3046\u306A\u306E\uFF1F\n\u306A\u3089\u4ECA\u5EA6\u3001\u8272\u3093\u306A\u3053\u3068\u3092\u6559\u3048\u3066\u3042\u3052\u308B\uFF01",
