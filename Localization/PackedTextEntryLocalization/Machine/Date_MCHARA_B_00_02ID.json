  {
    "id": 49,
    "properties": {
      "999008199": {
        "text": "\u305D\u308C\u306F\u304A\u59C9\u3061\u3083\u3093\u306E\u771F\u4F3C\u3092\u3057\u3066\u308B\u304B\u3089\u3067\u3059\uFF01",
