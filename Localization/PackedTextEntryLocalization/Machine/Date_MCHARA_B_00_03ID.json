      "2072370017": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 34,
    "properties": {
      "999008199": {
        "text": "\u305D\u3093\u306A\u3053\u3068\u3042\u308A\u307E\u305B\u3093\u3002\n\u30F4\u30A1\u30EC\u30EA\u30A2\u3055\u3093\u306F\u5341\u5206\u304A\u59C9\u3061\u3083\u3093\u3067\u3059\u3088\uFF01",
        "localizations": {
          "en": "That\u0027s not true at all. You\u0027re a wonderful big sister, Valeria!"
        }
      },
      "2072370017": {
        "text": "\u30A2\u30FC\u30B7\u30E3",
        "localizations": {
          "en": "Ayesha"
        }
      }
    }
  },
  {
    "id": 35,
    "properties": {
      "999008199": {
        "text": "\u305D\u3046\u304B\u306A\u2026\u2026\uFF1F",
        "localizations": {
          "en": "You really think so...?"
        }
      },
      "2072370017": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 36,
    "properties": {
      "999008199": {
        "text": "\u305D\u3046\u3067\u3059\u3088\u3002\n\u3060\u304B\u3089\u5143\u6C17\u3092\u51FA\u3057\u3066\u304F\u3060\u3055\u3044\uFF01",
        "localizations": {
          "en": "I do! So please cheer up!"
        }
      },
      "2072370017": {
        "text": "\u30A2\u30FC\u30B7\u30E3",
        "localizations": {
          "en": "Ayesha"
        }
      }
    }
  },
  {
    "id": 37,
    "properties": {
      "999008199": {
        "text": "\u2026\u2026\u3046\u3093\u3002\u3042\u308A\u304C\u3068\u3046\u3001\u30A2\u30FC\u30B7\u30E3",
        "localizations": {
          "en": "...Thanks, Ayesha."
        }
      },
      "2072370017": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 38,
    "properties": {
      "999008199": {
        "text": "\uFF08\u59C9\u3068\u3044\u3046\u306E\u306F\u3001\u85AC\u8349\u304C\u5224\u5225\u3067\u304D\u308B\u3068\u304B\u3001\u6599\u7406\u304C\u3067\u304D\u308B\n\u3000\u3068\u304B\u3001\u305D\u3046\u3044\u3046\u3053\u3068\u3060\u3051\u3058\u3083\u306A\u3044\u3068\u601D\u3044\u307E\u3059\uFF09",
        "localizations": {
          "en": "(Being a big sister isn\u0027t just about knowing herbs or being able to cook...)"
        }
      },
      "2072370017": {
        "text": "\u30A2\u30FC\u30B7\u30E3",
        "localizations": {
          "en": "Ayesha"
        }
      }
    }
  },
  {
    "id": 39,
    "properties": {
      "999008199": {
        "text": "\uFF08\u59C9\u306E\u6570\u3060\u3051\u3001\u59C9\u306E\u5728\u308A\u65B9\u304C\n\u3000\u5B58\u5728\u3057\u3066\u3044\u308B\u3093\u3058\u3083\u306A\u3044\u304B\u306A\u2026\u2026\uFF09",
        "localizations": {
          "en": "(I think there are as many ways to be a big sister as there are sisters in the world...)"
        }
      },
      "2072370017": {
        "text": "\u30A2\u30FC\u30B7\u30E3",
        "localizations": {
          "en": "Ayesha"
        }
      }
    }
  }
