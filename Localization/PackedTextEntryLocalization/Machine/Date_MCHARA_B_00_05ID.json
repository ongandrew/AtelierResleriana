[
  {
    "id": 0,
    "properties": {
      "999008199": {
        "text": "\u30A2\u30FC\u30B7\u30E3\u3002\u85AC\u8349\u306F\u96C6\u3081\u7D42\u308F\u3063\u305F\uFF1F",
        "localizations": {
          "en": "Ayesha, have you finished gathering medicinal herbs?"
        }
      },
      "2072370017": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 1,
    "properties": {
      "999008199": {
        "text": "\u3042\u3068\u3082\u3046\u5C11\u3057\u3067\u3059\uFF01\n\u2026\u2026\u3088\u3057\u3001\u3053\u308C\u3067\u30D0\u30C3\u30C1\u30EA\uFF01",
        "localizations": {
          "en": "Almost done!\n...There! Perfect!"
        }
      },
      "2072370017": {
        "text": "\u30A2\u30FC\u30B7\u30E3",
        "localizations": {
          "en": "Ayesha"
        }
      }
    }
  },
  {
    "id": 2,
    "properties": {
      "999008199": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2\u3055\u3093\u3001\u304A\u5F85\u305F\u305B\u3057\u307E\u3057\u305F\uFF01",
        "localizations": {
          "en": "Sorry to keep you waiting, Valeria!"
        }
      },
      "2072370017": {
        "text": "\u30A2\u30FC\u30B7\u30E3",
        "localizations": {
          "en": "Ayesha"
        }
      }
    }
  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "\u305D\u308C\u3058\u3083\u8857\u306B\u623B\u308B\u308F\u3088\u3002\n\u30A2\u30FC\u30B7\u30E3\u3001\u79C1\u306E\u305D\u3070\u304B\u3089\u96E2\u308C\u306A\u3044\u3067\u306D\uFF1F",
        "localizations": {
          "en": "Let\u0027s head back to town then.\nAyesha, stay close to me, okay?"
        }
      },
      "2072370017": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 4,
    "properties": {
      "999008199": {
        "text": "\u306F\u3044\uFF01",
        "localizations": {
          "en": "Yes!"
        }
      },
      "2072370017": {
        "text": "\u30A2\u30FC\u30B7\u30E3",
        "localizations": {
          "en": "Ayesha"
        }
      }
    }
  },
  {
    "id": 5,
    "properties": {
      "999008199": {
        "text": "\u4ECA\u65E5\u3082\u308F\u305F\u3057\u306B\u4ED8\u304D\u5408\u3063\u3066\u304F\u308C\u3066\n\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3057\u305F\uFF01",
        "localizations": {
          "en": "Thank you for accompanying me today!"
        }
      },
      "2072370017": {
        "text": "\u30A2\u30FC\u30B7\u30E3",
        "localizations": {
          "en": "Ayesha"
        }
      }
    }
  },
  {
    "id": 6,
    "properties": {
      "999008199": {
        "text": "\u3053\u306E\u524D\u306E\u3001\u9B54\u7269\u304B\u3089\u53D7\u3051\u305F\u50B7\u306E\u5177\u5408\u306F\u3069\u3046\u3067\u3059\u304B\uFF1F\n\u3069\u3053\u304B\u75DB\u3080\u5834\u6240\u306F\u3042\u3063\u305F\u308A\u3057\u307E\u305B\u3093\u304B\uFF1F",
        "localizations": {
          "en": "How\u0027s that injury you got from the monster the other day?\nDoes anything still hurt?"
        }
      },
      "2072370017": {
        "text": "\u30A2\u30FC\u30B7\u30E3",
        "localizations": {
          "en": "Ayesha"
        }
      }
    }
  },
  {
    "id": 7,
    "properties": {
      "999008199": {
        "text": "\u5927\u4E08\u592B\u3001\u898B\u3066\u306E\u901A\u308A\u30D4\u30F3\u30D4\u30F3\u3057\u3066\u308B\u308F\uFF01\n\u3053\u308C\u3082\u3001\u3042\u306E\u6642\u3082\u3089\u3063\u305F\u30A2\u30FC\u30B7\u30E3\u306E\u50B7\u85AC\u306E\u304A\u304B\u3052\u306D\uFF01",
        "localizations": {
          "en": "I\u0027m fine, fit as a fiddle as you can see!\nAll thanks to that medicine you gave me!"
        }
      },
      "2072370017": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 8,
    "properties": {
      "999008199": {
        "text": "\u30A2\u30FC\u30B7\u30E3\u306E\u85AC\u306F\u672C\u5F53\u306B\u3088\u304F\u52B9\u304F\u304B\u3089\u3001\n\u3044\u3064\u3082\u5927\u52A9\u304B\u308A\uFF01\u3000\u3082\u3046\u611F\u8B1D\u3057\u304B\u306A\u3044\u308F\uFF01",
        "localizations": {
          "en": "Your medicine works wonders,\nit\u0027s always such a huge help! I can\u0027t thank you enough!"
        }
      },
      "2072370017": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 9,
    "properties": {
      "999008199": {
        "text": "\u611F\u8B1D\u3059\u308B\u306E\u306F\u308F\u305F\u3057\u306E\u307B\u3046\u3067\u3059",
        "localizations": {
          "en": "I\u0027m the one who should be thankful"
        }
      },
      "2072370017": {
        "text": "\u30A2\u30FC\u30B7\u30E3",
        "localizations": {
          "en": "Ayesha"
        }
      }
    }
  },
  {
    "id": 10,
    "properties": {
      "999008199": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2\u3055\u3093\u306E\u304A\u304B\u3052\u3067\u3001\n\u3053\u3046\u3057\u3066\u85AC\u3092\u4F5C\u308C\u3066\u308B\u3093\u3067\u3059\u304B\u3089\uFF01",
        "localizations": {
          "en": "Thanks to you, I\u0027m able to make medicine like this!"
        }
      },
      "2072370017": {
        "text": "\u30A2\u30FC\u30B7\u30E3",
        "localizations": {
          "en": "Ayesha"
        }
      }
    }
  },
  {
    "id": 11,
    "properties": {
      "999008199": {
        "text": "\u3058\u3083\u3042\u3001\u304A\u4E92\u3044\u611F\u8B1D\u3063\u3066\u3053\u3068\u306D\uFF01",
        "localizations": {
          "en": "Then I guess we\u0027re both grateful!"
        }
      },
      "2072370017": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 12,
    "properties": {
      "999008199": {
        "text": "\u3042\u308C\u3001\u307E\u305F\u85AC\u8349\u96C6\u3081\u306B\u884C\u3063\u3066\u305F\u3093\u3060",
        "localizations": {
          "en": "Oh? Out gathering herbs again?"
        }
      },
      "2072370017": {
        "text": "\u30CF\u30A4\u30C7\u30A3",
        "localizations": {
          "en": "Heidi"
        }
      }
    }
  },
  {
    "id": 13,
    "properties": {
      "999008199": {
        "text": "\u306F\u3044\u3002\u30F4\u30A1\u30EC\u30EA\u30A2\u3055\u3093\u3092\u304A\u501F\u308A\u3057\u3066\u307E\u3057\u305F",
        "localizations": {
          "en": "Yes, Valeria was kind enough to help me."
        }
      },
      "2072370017": {
        "text": "\u30A2\u30FC\u30B7\u30E3",
        "localizations": {
          "en": "Ayesha"
        }
      }
    }
  },
  {
    "id": 14,
    "properties": {
      "999008199": {
        "text": "\u3042\u308C\uFF1F\n\u304A\u59C9\u3061\u3083\u3093\u306F\u8F9E\u3081\u305F\u3093\u3067\u3059\u304B\uFF1F",
        "localizations": {
          "en": "Huh? Did you stop being her big sister?"
        }
      },
      "2072370017": {
        "text": "\u30D5\u30ED\u30C3\u30B1",
        "localizations": {
          "en": "Flocke"
        }
      }
    }
  },
  {
    "id": 15,
    "properties": {
      "999008199": {
        "text": "\u8F9E\u3081\u305F\u3063\u3066\u3044\u3046\u306E\u306F\u5C11\u3057\u9055\u3046\u308F\u306D\u3002\n\u59C9\u3068\u304B\u59B9\u3068\u304B\u3001\u5F62\u3060\u3051\u306E\u95A2\u4FC2\u306B\n\u3053\u3060\u308F\u308B\u306E\u3092\u3084\u3081\u305F\u306E",
        "localizations": {
          "en": "That\u0027s not quite right.\nI just stopped obsessing over formal relationships\nlike \u0027big sister\u0027 and \u0027little sister.\u0027"
        }
      },
      "2072370017": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 16,
    "properties": {
      "999008199": {
        "text": "\u59C9\u59B9\u3063\u3066\u305D\u3046\u3044\u3046\u3082\u306E\u3058\u3083\u306A\u3044\u3067\u3057\u3087\uFF1F",
        "localizations": {
          "en": "That\u0027s not what being sisters is really about, right?"
        }
      },
      "2072370017": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 17,
    "properties": {
      "999008199": {
        "text": "\u3075\u3045\u3093\u3002\u8A73\u3057\u3044\u4E8B\u60C5\u306F\u5206\u304B\u3093\u306A\u3044\u3051\u3069\u3001\n\u30B9\u30C3\u30AD\u30EA\u3057\u305F\u9854\u3057\u3066\u308B\u3058\u3083\u3093",
        "localizations": {
          "en": "Hmm. Don\u0027t know the details, but\nyou seem pretty content with that."
        }
      },
      "2072370017": {
        "text": "\u30CF\u30A4\u30C7\u30A3",
        "localizations": {
          "en": "Heidi"
        }
      }
    }
  },
  {
    "id": 18,
    "properties": {
      "999008199": {
        "text": "\u59C9\u306B\u306A\u3063\u3066\u3001\u8272\u3093\u306A\u3053\u3068\u306B\u6C17\u4ED8\u3051\u305F\u306E",
        "localizations": {
          "en": "Being a sister has helped me realize a lot of things."
        }
      },
      "2072370017": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 19,
    "properties": {
      "999008199": {
        "text": "\u4ECA\u306F\u307E\u3060\u3067\u304D\u306A\u3044\u3053\u3068\u304C\u591A\u3044\u3051\u3069\u3001\n\u3053\u308C\u304B\u3089\u5C11\u3057\u3065\u3064\u5897\u3084\u305B\u3070\u3044\u3044\u3063\u3066",
        "localizations": {
          "en": "There\u0027s still a lot I can\u0027t do yet,\nbut I can work on that little by little."
        }
      },
      "2072370017": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 20,
    "properties": {
      "999008199": {
        "text": "\u306A\u3093\u3060\u304B\u4ECA\u306E\u30F4\u30A1\u30EC\u30EA\u30A2\u3055\u3093\u3001\n\u3068\u3066\u3082\u5927\u4EBA\u3063\u307D\u304F\u898B\u3048\u307E\u3059\uFF01",
        "localizations": {
          "en": "You seem so mature now, Valeria!"
        }
      },
      "2072370017": {
        "text": "\u30D5\u30ED\u30C3\u30B1",
        "localizations": {
          "en": "Flocke"
        }
      }
    }
  },
  {
    "id": 21,
    "properties": {
      "999008199": {
        "text": "\u3067\u3057\u3087\u3067\u3057\u3087\uFF01\n\u79C1\u306F\u65E5\u3005\u6210\u9577\u3057\u3066\u308B\u306E\u3088\uFF01",
        "localizations": {
          "en": "Right? Right?\nI\u0027m growing every day!"
        }
      },
      "2072370017": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 22,
    "properties": {
      "999008199": {
        "text": "\u307E\u3001\u672C\u5F53\u306B\u3061\u3087\u3063\u3068\u305A\u3064\u3060\u3051\u3069\u306D",
        "localizations": {
          "en": "Well, very slowly, but sure."
        }
      },
      "2072370017": {
        "text": "\u30CF\u30A4\u30C7\u30A3",
        "localizations": {
          "en": "Heidi"
        }
      }
    }
  },
  {
    "id": 23,
    "properties": {
      "999008199": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2\u3055\u3093\u306A\u3089\u3001\n\u5FC5\u305A\u7ACB\u6D3E\u306A\u304A\u59C9\u3055\u3093\u306B\u306A\u308C\u307E\u3059\u3088\uFF01",
        "localizations": {
          "en": "I know you\u0027ll become a wonderful big sister, Valeria!"
        }
      },
      "2072370017": {
        "text": "\u30A2\u30FC\u30B7\u30E3",
        "localizations": {
          "en": "Ayesha"
        }
      }
    }
  },
  {
    "id": 24,
    "properties": {
      "999008199": {
        "text": "\u3042\u308A\u304C\u3068\u3046\u3002\u304D\u3063\u3068\u3053\u308C\u304B\u3089\u3082\u307F\u3093\u306A\u306B\n\u8FF7\u60D1\u3092\u304B\u3051\u308B\u304B\u3082\u3057\u308C\u306A\u3044",
        "localizations": {
          "en": "Thank you. I might still cause trouble\nfor everyone from time to time."
        }
      },
      "2072370017": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 25,
    "properties": {
      "999008199": {
        "text": "\u305D\u306E\u3068\u304D\u306F\u307F\u3093\u306A\u306B\u52A9\u3051\u3066\u307B\u3057\u3044\u306E",
        "localizations": {
          "en": "When that happens, I hope you\u0027ll all help me out."
        }
      },
      "2072370017": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 26,
    "properties": {
      "999008199": {
        "text": "\u5FC5\u305A\u6069\u8FD4\u3057\u306F\u3059\u308B\u304B\u3089\uFF01\n\u305D\u308C\u307E\u3067\u5F85\u3063\u3066\u3066\u3061\u3087\u3046\u3060\u3044\uFF01",
        "localizations": {
          "en": "I\u0027ll definitely repay the favor!\nJust wait and see!"
        }
      },
      "2072370017": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 27,
    "properties": {
      "999008199": {
        "text": "\u306F\u3044\uFF01",
        "localizations": {
          "en": "Of course!"
        }
      },
      "2072370017": {
        "text": "\u30A2\u30FC\u30B7\u30E3",
        "localizations": {
          "en": "Ayesha"
        }
      }
    }
  },
  {
    "id": 28,
    "properties": {
      "999008199": {
        "text": "\u697D\u3057\u307F\u306B\u3057\u3066\u307E\u3059\u306D\uFF01",
        "localizations": {
          "en": "Looking forward to it!"
        }
      },
      "2072370017": {
        "text": "\u30D5\u30ED\u30C3\u30B1",
        "localizations": {
          "en": "Flocke"
        }
      }
    }
  },
  {
    "id": 29,
    "properties": {
      "999008199": {
        "text": "\u8FF7\u60D1\u304B\u3051\u3089\u308C\u6163\u308C\u3066\u308B\u304B\u3089\u3001\n\u4ECA\u3055\u3089\u6C17\u306B\u3057\u306A\u3044\u3063\u3066\u306E",
        "localizations": {
          "en": "We\u0027re used to your trouble by now,\nso don\u0027t worry about it."
        }
      },
      "2072370017": {
        "text": "\u30CF\u30A4\u30C7\u30A3",
        "localizations": {
          "en": "Heidi"
        }
      }
    }
  },
  {
    "id": 30,
    "properties": {
      "999008199": {
        "text": "\u305D\u3057\u3066\u3001\u3044\u3064\u304B\u81EA\u7136\u3068\u307F\u3093\u306A\u306B\u983C\u3089\u308C\u308B\u3001\n\u7ACB\u6D3E\u306A\u59C9\u306B\u306A\u3063\u3066\u3084\u308B\u3093\u3060\u304B\u3089\uFF01",
        "localizations": {
          "en": "And someday, I\u0027ll naturally become the kind of\nbig sister everyone can depend on!"
        }
      },
      "2072370017": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 31,
    "properties": {
      "999008199": {
        "text": "\u305D\u306E\u6642\u306F\u307E\u305F\u547C\u3070\u305B\u3066\u304F\u3060\u3055\u3044\uFF01\n\u30F4\u30A1\u30EC\u30EA\u30A2\u304A\u59C9\u3061\u3083\u3093\u3063\u3066\uFF01",
        "localizations": {
          "en": "When that time comes, let me call you\nBig Sis Valeria again!"
        }
      },
      "2072370017": {
        "text": "\u30A2\u30FC\u30B7\u30E3",
        "localizations": {
          "en": "Ayesha"
        }
      }
    }
  },
  {
    "id": 32,
    "properties": {
      "999008199": {
        "text": "\u3048\u3048\uFF01\u3000\u3082\u3061\u308D\u3093\u3088\uFF01",
        "localizations": {
          "en": "Yes! Of course!"
        }
      },
      "2072370017": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  }
]