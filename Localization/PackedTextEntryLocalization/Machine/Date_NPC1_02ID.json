      "2072370017": {
        "text": "\u9078\u629E\u80A2",
        "localizations": {
          "en": "Selection"
        }
      }
    }
  },
  {
    "id": 82,
    "properties": {
      "999008199": {
        "text": "\u91CC\u5E30\u308A\uFF1F",
        "localizations": {
          "en": "Going back home?"
        }
      },
      "2072370017": {
        "text": "\u30A4\u30B6\u30CA",
        "localizations": {
          "en": "Izana"
        }
      }
    }
  },
  {
    "id": 83,
    "properties": {
      "999008199": {
        "text": "\u81EA\u5206\u306E\u90E8\u5C4B\u3067\u3001\u30A4\u30B6\u30CA\u3061\u3083\u3093\u3068\n\u306E\u3093\u3073\u308A\u904E\u3054\u3057\u305F\u3044\u306A",
        "localizations": {
          "en": "I want to relax with you\nin my room"
        }
      },
      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 84,
    "properties": {
      "999008199": {
        "text": "\u3053\u3053\u306F\u4EBA\u306E\u51FA\u5165\u308A\u304C\u3042\u308B\u304B\u3089\u3001\n\u3061\u3087\u3063\u3068\u6065\u305A\u304B\u3057\u304F\u3066",
        "localizations": {
          "en": "It\u0027s a bit embarrassing here\nwith people coming and going"
        }
      },
      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 85,
    "properties": {
      "999008199": {
        "text": "\u6614\u306F\u304A\u83D3\u5B50\u7247\u624B\u306B\u3001\u30B4\u30ED\u30B4\u30ED\u3057\u305F\u3088\u306D\uFF5E",
        "localizations": {
          "en": "We used to lounge around eating snacks back then~"
        }
      },
      "2072370017": {
        "text": "\u30A4\u30B6\u30CA",
        "localizations": {
          "en": "Izana"
        }
      }
    }
  },
  {
    "id": 86,
    "properties": {
      "999008199": {
        "text": "\u540C\u3058\u90E8\u5C4B\u306B\u3044\u308B\u306E\u306B\u3001\n\u8AAD\u3093\u3067\u305F\u672C\u306F\u5225\u3005\u3060\u3063\u305F",
        "localizations": {
          "en": "We\u0027d be in the same room,\nbut reading different books"
        }
      },
      "2072370017": {
        "text": "\u30A4\u30B6\u30CA",
        "localizations": {
          "en": "Izana"
        }
      }
    }
  },
  {
    "id": 87,
    "properties": {
      "999008199": {
        "text": "\u305D\u306E\u3046\u3061\u3001\u3046\u3068\u3046\u3068\u3057\u3061\u3083\u3063\u3066\u306D",
        "localizations": {
          "en": "And then we\u0027d start dozing off..."
        }
      },
      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 88,
    "properties": {
      "999008199": {
        "text": "\u305D\u3046\u305D\u3046\uFF01",
        "localizations": {
          "en": "Yeah, exactly!"
        }
      },
      "2072370017": {
        "text": "\u30A4\u30B6\u30CA",
        "localizations": {
          "en": "Izana"
        }
      }
    }
  },
  {
    "id": 89,
    "properties": {
      "999008199": {
        "text": "\u3060\u3051\u3069\u3001\u307E\u305A\u306F\u6C17\u306B\u306A\u3063\u3066\u305F\u63A1\u53D6\u5730\u304B\u306A",
        "localizations": {
          "en": "But first, I want to check out that gathering spot I was curious about"
        }
      },
      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 90,
    "properties": {
      "999008199": {
        "text": "\u3046\u3093\u3002\u305D\u308C\u3058\u3083\u3001\u307E\u305F\u660E\u65E5\u3002\u304A\u3084\u3059\u307F\uFF01",
        "localizations": {
          "en": "Sure. Well then, see you tomorrow. Good night!"
        }
      },
      "2072370017": {
        "text": "\u30A4\u30B6\u30CA",
        "localizations": {
          "en": "Izana"
        }
      }
    }
  },
  {
    "id": 91,
    "properties": {
      "999008199": {
        "text": "\uFF08\u5B09\u3057\u304F\u3063\u3066\u304A\u9858\u3044\u3057\u3061\u3083\u3063\u305F\u3051\u3069\u2026\u2026\uFF09",
        "localizations": {
          "en": "(I got excited and made plans, but...)"
        }
      },
      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 92,
    "properties": {
      "999008199": {
        "text": "\uFF08\u304A\u4F11\u307F\u306A\u3057\u3067\u3001\u5927\u4E08\u592B\u304B\u306A\u3042\uFF09",
        "localizations": {
          "en": "(I hope she\u0027ll be okay without taking a break)"
        }
      },
      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 93,
    "properties": {
      "999008199": {
        "text": "\u5F37\u304F\u306A\u308B\u306E\u3082\u7D0D\u5F97\u3060\u306D\uFF01",
        "localizations": {
          "en": "No wonder you\u0027re getting stronger!"
        }
      },
      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 94,
    "properties": {
      "999008199": {
        "text": "\u30D5\u30EA\u30FC\u30B2\u30F3\u306E\u3001\u79C1\u306E\u5BB6\u306F\u3069\u3046\u304B\u306A\uFF1F",
        "localizations": {
          "en": "How about my house in Fliegen?"
        }
