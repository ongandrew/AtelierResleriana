      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 102,
    "properties": {
      "999008199": {
        "text": "\u3042\u30FC\u3042\u3002\u4F55\u304C\u8DB3\u308A\u306A\u304B\u3063\u305F\u3093\u3060\u308D\u3046",
        "localizations": {
          "en": "Sigh. I wonder what I was lacking."
        }
      },
      "2072370017": {
        "text": "\u30A4\u30B6\u30CA",
        "localizations": {
          "en": "Izana"
        }
      }
    }
  },
  {
    "id": 103,
    "properties": {
      "999008199": {
        "text": "\u3061\u3087\u3063\u3068\u3001\u30CF\u30F3\u30DE\u30FC\u3068\u8A9E\u308A\u5408\u3063\u3066\u304F\u308B\u306D",
        "localizations": {
          "en": "I\u0027m going to have a little chat with my hammer."
        }
      },
      "2072370017": {
        "text": "\u30A4\u30B6\u30CA",
        "localizations": {
          "en": "Izana"
        }
      }
    }
  },
  {
    "id": 104,
    "properties": {
      "999008199": {
        "text": "\u5F85\u3063\u3066\u3001\u30A4\u30B6\u30CA\u3061\u3083\u3093\uFF01",
        "localizations": {
          "en": "Wait, Izana!"
        }
      },
      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 105,
    "properties": {
      "999008199": {
        "text": "\uFF08\u5FC3\u914D\u3057\u3066\u305F\u3060\u3051\u306A\u306E\u306B\u3001\n\u3000\u88CF\u76EE\u306B\u51FA\u3061\u3083\u3063\u305F\u2026\u2026\uFF09",
        "localizations": {
          "en": "(I was just worried, but it backfired...)"
        }
      },
      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 106,
    "properties": {
      "999008199": {
        "text": "\uFF08\u3082\u3063\u3068\u4E0A\u624B\u304F\u4F1D\u3048\u3089\u308C\u305F\u3089\n\u3000\u3088\u304B\u3063\u305F\u306E\u306B\u2026\u2026\uFF09",
        "localizations": {
          "en": "(If only I could have explained it better...)"
        }
      },
      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 107,
    "properties": {
      "999008199": {
        "text": "\u52B9\u7387\u7684\u306A\u8EAB\u4F53\u306E\u4F5C\u308A\u65B9\u306A\u3093\u3060\u3051\u3069\u2026\u2026",
        "localizations": {
          "en": "About efficient body building..."
        }
      },
      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 108,
    "properties": {
      "999008199": {
        "text": "\u30A4\u30B6\u30CA\u3061\u3083\u3093\u306F\u3001\n\u30CF\u30F3\u30DE\u30FC\u3068\u540C\u3058\u306A\u3093\u3060\u3088",
        "localizations": {
          "en": "Izana, you\u0027re just like your hammer."
        }
      },
      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  }
