    }
  },
  {
    "id": 4,
    "properties": {
      "999008199": {
        "text": "\u306A\u3093\u3060\u304B\u3001\u9811\u5F35\u308A\u3059\u304E\u3066\u308B\u307F\u305F\u3044\u3067\u2026\u2026\n\u3082\u3063\u3068\u6C17\u3092\u697D\u306B\u3057\u3066\u3082\u3044\u3044\u3093\u3060\u3088\uFF1F",
        "localizations": {
          "en": "You seem to be pushing yourself too hard...\nYou can take it easier, you know?"
