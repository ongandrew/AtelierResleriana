  },
  {
    "id": 12,
    "properties": {
      "999008199": {
        "text": "\u4ED6\u306E\u4EBA\u306E\u4F55\u500D\u3082\u52AA\u529B\u3057\u3066\u3001\n\u82E6\u624B\u306A\u52C9\u5F37\u306B\u3082\u5411\u304D\u5408\u3063\u3066\u304D\u305F\u3088\u306D\u3002\n\u305D\u3093\u306A\u59FF\u3092\u898B\u3066\u304D\u305F\u304B\u3089\u3001\u5FC3\u914D\u3057\u3066\u308B\u306E",
