  },
  {
    "id": 7,
    "properties": {
      "999008199": {
        "text": "\u30A2\u30BF\u30B7\u306D\u3001\u65E9\u304F\u5F37\u304F\u306A\u308A\u305F\u3044\u306E\u3002\n\u9A0E\u58EB\u306B\u306A\u3063\u3066\u3001\u30EC\u30B9\u30CA\u3061\u3083\u3093\u3092\u5B88\u308A\u305F\u3044",
        "localizations": {
          "en": "I want to get stronger quickly.\nI want to become a knight and protect you, Resna!"
