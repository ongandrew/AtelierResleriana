        "text": "\u6B32\u3057\u3044\u3082\u306E\u3001\u96C6\u3081\u3089\u308C\u305F\uFF1F\n\u3082\u3063\u3068\u3044\u3066\u3082\u3088\u304B\u3063\u305F\u3093\u3060\u3088",
        "localizations": {
