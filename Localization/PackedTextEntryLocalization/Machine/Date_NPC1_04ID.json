  },
  {
    "id": 6,
    "properties": {
      "999008199": {
        "text": "\u30EA\u30E9\u3055\u3093\u306B\u7121\u99C4\u306E\u306A\u3044\u52D5\u304D\u3092\n\u6559\u308F\u3063\u305F\u306E\u306B\u3001\u6D3B\u304B\u305B\u306A\u304F\u3066\u6094\u3057\u3044\u3088",
        "localizations": {
          "en": "Lila taught me how to move efficiently,\nbut I can\u0027t put it into practice. It\u0027s frustrating!"
