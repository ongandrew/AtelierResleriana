[
  {
    "id": 0,
    "properties": {
      "999008199": {
        "text": "\u305F\u3060\u3044\u307E\uFF5E\uFF01\n\u30EC\u30B9\u30CA\u3061\u3083\u3093\u304C\u63A1\u53D6\u3057\u305F\u3082\u306E\u3001\n\u3053\u3053\u306B\u7F6E\u3044\u3066\u304A\u304F\u306D",
        "localizations": {
