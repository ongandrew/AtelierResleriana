  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "\u5FC5\u8981\u306A\u3082\u306E\u306F\u63C3\u3063\u305F\u304B\u3089\u5927\u4E08\u592B\u3002\n\u305D\u308C\u3088\u308A\u3001\u6700\u8FD1\u306E\u30A4\u30B6\u30CA\u3061\u3083\u3093\u304C\u5FC3\u914D\u306A\u306E",
        "localizations": {
