    }
  },
  {
    "id": 8,
    "properties": {
      "999008199": {
        "text": "\u3053\u308C\u304B\u3089\u3082\u5927\u5207\u306B\u7740\u3055\u305B\u3066\u3082\u3089\u3044\u307E\u3059\u3088\u3002\n\u3068\u3053\u308D\u3067\u30B6\u30B9\u30AD\u30A2\u3055\u3093\u306F\u2026\u2026",
        "localizations": {
          "en": "I\u0027ll keep taking good care of it.\nBy the way, Saskia..."
