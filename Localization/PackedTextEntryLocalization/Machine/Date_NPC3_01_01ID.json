  },
  {
    "id": 2,
    "properties": {
      "999008199": {
        "text": "\u305D\u308C\u3001\u65B0\u5E74\u306E\u6328\u62F6\u7528\u306E\u8863\u88C5\u3067\u3059\u304B\uFF1F\n\u4F3C\u5408\u3063\u3066\u307E\u3059\u306D\uFF01",
        "localizations": {
          "en": "Is that your outfit for the New Year\u0027s greetings?\nIt really suits you!"
