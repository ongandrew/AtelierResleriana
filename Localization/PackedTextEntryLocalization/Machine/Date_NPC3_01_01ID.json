  },
  {
    "id": 21,
    "properties": {
      "999008199": {
        "text": "\u5F53\u305F\u308A\u524D\u3058\u3083\u306A\u3044\u3002\n\u3082\u3063\u3068\u30EC\u30B9\u30CA\u306E\u982D\u3092\u64AB\u3067\u305F\u308A\u3068\u304B\u3001\n\u4E00\u7DD2\u306B\u304A\u8336\u3057\u305F\u308A\u3068\u304B\u306D",
        "localizations": {
          "en": "Of course!\nLike not patting Resna\u0027s head enough,\nor having tea together more often."
