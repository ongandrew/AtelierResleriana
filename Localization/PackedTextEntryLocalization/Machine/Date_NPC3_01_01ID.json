  },
  {
    "id": 6,
    "properties": {
      "999008199": {
        "text": "\u3042\u3001\u3084\u3063\u3071\u308A\u899A\u3048\u3066\u307E\u3059\uFF1F\n\u53BB\u5E74\u30B6\u30B9\u30AD\u30A2\u3055\u3093\u304B\u3089\u3082\u3089\u3063\u305F\u8863\u88C5\u3067\u3059\u3088\u3002\n\u3042\u305F\u3057\u306E\u304A\u6C17\u306B\u5165\u308A\u306A\u3093\u3067\u3059",
        "localizations": {
          "en": "Ah, you remember?\nIt\u0027s the outfit you gave me last year.\nIt\u0027s my favorite!"
