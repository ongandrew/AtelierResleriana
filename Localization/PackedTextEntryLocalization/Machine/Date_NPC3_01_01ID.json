  },
  {
    "id": 15,
    "properties": {
      "999008199": {
        "text": "\u305D\u3046\u8A00\u308F\u308C\u308C\u3070\uFF11\u5E74\u9593\u3060\u3051\u3067\n\u3068\u3093\u3067\u3082\u306A\u3044\u3053\u3068\u3070\u304B\u308A\u8D77\u3053\u308A\u307E\u3057\u305F\u306D\u2026\u2026",
