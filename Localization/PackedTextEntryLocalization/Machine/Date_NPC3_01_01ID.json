  {
    "id": 20,
    "properties": {
      "999008199": {
        "text": "\u3048\u3063\u3001\u305D\u3046\u306A\u3093\u3067\u3059\u304B\uFF1F\n\u610F\u5916\u306A\u4E8B\u5B9F\u3060\u308F\u2026\u2026\uFF01",
