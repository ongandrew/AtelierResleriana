  },
  {
    "id": 16,
    "properties": {
      "999008199": {
        "text": "\u3060\u304B\u3089\u6FC0\u52D5\u306E\uFF11\u5E74\u3002\n\u79C1\u306B\u3068\u3063\u3066\u3082\u3001\u30EC\u30B9\u30CA\u306B\u3068\u3063\u3066\u3082\u3001\u306D",
