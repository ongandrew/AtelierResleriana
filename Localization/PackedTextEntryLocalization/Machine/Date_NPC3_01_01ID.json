  {
    "id": 13,
    "properties": {
      "999008199": {
        "text": "\u305D\u3046\u3088\u3002\n\u3060\u3063\u3066\u8272\u3005\u306A\u3053\u3068\u304C\u3042\u3063\u305F\u3058\u3083\u306A\u3044\uFF1F",
