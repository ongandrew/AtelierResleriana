  {
    "id": 11,
    "properties": {
      "999008199": {
        "text": "\u305D\u3046\u306D\u3047\u3001\u4E00\u8A00\u3067\u3044\u3048\u3070\u6FC0\u52D5\u306E\uFF11\u5E74\u3002\n\u3063\u3066\u3068\u3053\u308D\u304B\u3057\u3089\uFF1F",
