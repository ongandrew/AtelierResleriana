    }
  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "\u305D\u3046\uFF1F\u3000\u3042\u308A\u304C\u3068\u306D\u3002\n\u307E\u3058\u307E\u3058\u3068\u898B\u3064\u3081\u3089\u308C\u308B\u307B\u3069\n\u3058\u3083\u306A\u3044\u3068\u601D\u3046\u306E\u3060\u3051\u308C\u3069",
        "localizations": {
          "en": "You think so? Thanks, though I don\u0027t think\nit\u0027s worth staring at quite so intently."
