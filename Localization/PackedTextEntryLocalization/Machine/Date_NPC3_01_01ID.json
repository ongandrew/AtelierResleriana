    }
  },
  {
    "id": 14,
    "properties": {
      "999008199": {
        "text": "\u9802\u7363\u3068\u6226\u3063\u305F\u308A\u3001\n\u6975\u591C\u306E\u932C\u91D1\u515A\u3092\u8FFD\u3044\u8A70\u3081\u305F\u308A\u3002\n\u5927\u5909\u3060\u3063\u305F\u308F",
        "localizations": {
          "en": "Fighting the Apex Beasts,\ncornering the Polar Night Alchemists.\nIt was quite challenging."
