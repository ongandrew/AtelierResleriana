  {
    "id": 32,
    "properties": {
      "999008199": {
        "text": "\u305D\u3046\u3060\u3002\u3042\u306A\u305F\u306E\u624B\u304C\u7A7A\u3044\u3066\u3044\u305F\u3089\u3001\n\u53BB\u5E74\u306B\u7D9A\u3044\u3066\u3061\u3087\u3063\u3068\u304A\u624B\u4F1D\u3044\u3092\n\u983C\u307F\u305F\u3044\u306E\u3060\u3051\u308C\u3069\u3001\u3044\u3044\u304B\u3057\u3089\uFF1F",
