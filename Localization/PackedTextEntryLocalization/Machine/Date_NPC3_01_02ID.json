        "text": "\u306F\u3042\uFF5E\u2026\u2026\u5927\u6383\u9664\u9762\u5012\u304F\u3055\u3044\u306A\u3041\u2026\u2026\u3002\n\u30B6\u30B9\u30AD\u30A2\u3055\u3093\u3001\u624B\u3063\u53D6\u308A\u65E9\u304F\u7D42\u308F\u3089\u305B\u308B\n\u65B9\u6CD5\u3068\u304B\u3063\u3066\u306A\u3044\u3093\u3067\u3059\u304B\uFF5E\uFF1F",
