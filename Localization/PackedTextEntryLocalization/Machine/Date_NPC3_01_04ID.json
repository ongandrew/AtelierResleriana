      "2072370017": {
        "text": "\u30DE\u30EA\u30FC",
        "localizations": {
          "en": "Marie"
        }
      }
    }
  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "\u30B6\u30B9\u30AD\u30A2\u3055\u3093\u2026\u2026\uFF01",
        "localizations": {
          "en": "Saskia...!"
