      "2072370017": {
        "text": "\u4E0D\u8981\u30C6\u30AD\u30B9\u30C8",
        "localizations": {
          "en": "Not needed"
        }
      }
    }
  },
  {
    "id": 64,
    "properties": {
      "999008199": {
        "text": "\u611B",
        "localizations": {
          "en": "Love"
        }
      },
      "2072370017": {
        "text": "\u9078\u629E\u80A2",
        "localizations": {
          "en": "Selection"
        }
      }
    }
  },
  {
    "id": 65,
    "properties": {
      "999008199": {
        "text": "\u611B\u3067\u3059",
        "localizations": {
          "en": "Love."
        }
      },
      "2072370017": {
        "text": "\u30DE\u30EA\u30FC",
        "localizations": {
          "en": "Marie"
        }
      }
    }
  },
  {
    "id": 66,
    "properties": {
      "999008199": {
        "text": "\u2026\u2026\u3048\u3063\uFF1F",
        "localizations": {
          "en": "...What?"
        }
      },
      "2072370017": {
        "text": "\u30B6\u30B9\u30AD\u30A2",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 67,
    "properties": {
      "999008199": {
        "text": "\u3060\u3063\u3066\u3001\u611F\u3058\u305F\u3093\u3067\u3059\u3002\n\u78BA\u304B\u306B\u3042\u306A\u305F\u306F\u3042\u305F\u3057\u305F\u3061\u306B\n\u9177\u3044\u3053\u3068\u3092\u3057\u305F\u3051\u308C\u3069\u2026\u2026",
        "localizations": {
          "en": "Because I could feel it. Even though what you did to us was cruel..."
        }
      },
      "2072370017": {
        "text": "\u30DE\u30EA\u30FC",
        "localizations": {
          "en": "Marie"
        }
      }
    }
  },
  {
    "id": 68,
    "properties": {
      "999008199": {
        "text": "\u304D\u3063\u3068\u305D\u308C\u306F\u3042\u305F\u3057\u305F\u3061\u306E\u305F\u3081\n\u3060\u3063\u305F\u3093\u3060\u308D\u3046\u306A\u3063\u3066\u3002\n\u3060\u304B\u3089\u2026\u2026\u611B\u306A\u306E\u304B\u306A\u3063\u3066",
        "localizations": {
          "en": "I\u0027m sure you did it for our sake. That\u0027s why... I think it must have been love."
        }
      },
      "2072370017": {
        "text": "\u30DE\u30EA\u30FC",
        "localizations": {
          "en": "Marie"
        }
      }
    }
  },
  {
    "id": 69,
    "properties": {
      "999008199": {
        "text": "\u2026\u2026\u3075\u3075",
        "localizations": {
          "en": "...Hehe."
        }
      },
      "2072370017": {
        "text": "\u30B6\u30B9\u30AD\u30A2",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 70,
    "properties": {
      "999008199": {
        "text": "\u4E16\u754C\u4E2D\u306E\u4EBA\u3005\u304C\u3042\u306A\u305F\u306E\u3088\u3046\u306B\n\u512A\u3057\u3044\u5FC3\u3092\u6301\u3063\u3066\u3044\u305F\u306A\u3089\u3001\n\u3082\u3063\u3068\u512A\u3057\u3044\u4E16\u754C\u304C\u5E83\u304C\u3063\u3066\u3044\u305F\u306E\u306B\u306D",
        "localizations": {
          "en": "If everyone in the world had a gentle heart like yours, perhaps it would be a much kinder place."
        }
      },
      "2072370017": {
        "text": "\u30B6\u30B9\u30AD\u30A2",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 71,
    "properties": {
      "999008199": {
        "text": "\u305D\u308C\u306F\u30B6\u30B9\u30AD\u30A2\u3055\u3093\u3082\u540C\u3058\u3067\u3057\u3087\uFF1F\n\u512A\u3057\u304F\u306A\u304B\u3063\u305F\u3089\u304A\u5B88\u308A\u306A\u3093\u3066\u914D\u3089\u306A\u3044\u3082\u306E",
        "localizations": {
          "en": "The same goes for you, doesn\u0027t it? Someone without kindness wouldn\u0027t give out protective charms."
        }
      },
      "2072370017": {
        "text": "\u30DE\u30EA\u30FC",
        "localizations": {
          "en": "Marie"
        }
      }
    }
  },
  {
    "id": 72,
    "properties": {
      "999008199": {
        "text": "\u3046\u3075\u3075\u3001\u305D\u3046\u304B\u3082\u3057\u308C\u306A\u3044\u308F\u306D\u2026\u2026",
        "localizations": {
          "en": "Hehehe, maybe you\u0027re right..."
        }
      },
      "2072370017": {
        "text": "\u30B6\u30B9\u30AD\u30A2",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 73,
    "properties": {
      "999008199": {
        "text": "\u5584\u610F",
        "localizations": {
          "en": "Good intentions"
        }
      },
      "2072370017": {
        "text": "\u9078\u629E\u80A2",
        "localizations": {
          "en": "Selection"
        }
      }
    }
  },
  {
    "id": 74,
    "properties": {
      "999008199": {
        "text": "\u5584\u610F\u3001\u3067\u3059",
        "localizations": {
          "en": "Your good intentions."
        }
      },
      "2072370017": {
        "text": "\u30DE\u30EA\u30FC",
        "localizations": {
          "en": "Marie"
        }
      }
    }
  },
