  {
    "id": 20,
    "properties": {
      "999008199": {
        "text": "\u3084\u3063\u3071\u308A\u3001\u30B6\u30B9\u30AD\u30A2\u3055\u3093\u306F\n\u3042\u305F\u3057\u305F\u3061\u306E\u6575\u2026\u2026\u3067\u3059\u3088\u306D",
