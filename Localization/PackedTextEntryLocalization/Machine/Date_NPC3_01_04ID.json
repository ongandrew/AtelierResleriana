[
  {
    "id": 0,
    "properties": {
      "999008199": {
        "text": "\uFF08\u3042\u306E\u65E5\u3002\u30B6\u30B9\u30AD\u30A2\u3055\u3093\u306F\u307F\u3093\u306A\u306E\u524D\u304B\u3089\n\u3000\u59FF\u3092\u6D88\u3057\u305F\uFF09",
        "localizations": {
          "en": "(That day... Saskia disappeared without a word to anyone.)"
        }
      },
      "2072370017": {
        "text": "\u30DE\u30EA\u30FC",
        "localizations": {
          "en": "Marie"
        }
      }
    }
  },
  {
    "id": 1,
    "properties": {
      "999008199": {
        "text": "\uFF08\u8A73\u3057\u3044\u7406\u7531\u306F\u5206\u304B\u3089\u306A\u3044\u3002\n\u3000\u3067\u3082\u30EC\u30B9\u30CA\u305F\u3061\u306F\u3001\u623B\u3063\u3066\u304F\u308B\u3053\u3068\u306F\n\u3000\u306A\u3044\u3060\u308D\u3046\u3068\u8A00\u3046\uFF09",
        "localizations": {
          "en": "(I don\u0027t know exactly why. But Resna and the others say she\u0027s probably never coming back.)"
        }
      },
      "2072370017": {
        "text": "\u30DE\u30EA\u30FC",
        "localizations": {
          "en": "Marie"
        }
      }
    }
  },
  {
    "id": 2,
    "properties": {
      "999008199": {
        "text": "\uFF08\u305D\u3093\u306A\u3042\u308B\u65E5\u3002\n\u3000\u3042\u305F\u3057\u306F\u5076\u7136\u3001\u30B6\u30B9\u30AD\u30A2\u3055\u3093\u3092\u898B\u3064\u3051\u305F\uFF09",
        "localizations": {
          "en": "(Then one day... I happened to find her.)"
        }
