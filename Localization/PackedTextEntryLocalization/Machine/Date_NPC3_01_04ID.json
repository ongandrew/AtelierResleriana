      "2072370017": {
        "text": "\u30DE\u30EA\u30FC",
        "localizations": {
          "en": "Marie"
        }
      }
    }
  },
  {
    "id": 4,
    "properties": {
      "999008199": {
        "text": "\u3042\u3089\u2026\u2026\u3002\n\u305D\u3093\u306A\u306B\u606F\u3092\u5207\u3089\u305B\u3061\u3083\u3063\u3066\u3001\u3069\u3046\u3057\u305F\u306E\uFF1F",
        "localizations": {
          "en": "My... Why are you so out of breath? What\u0027s wrong?"
