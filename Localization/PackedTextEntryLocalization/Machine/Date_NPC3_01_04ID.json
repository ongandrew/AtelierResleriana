      "2072370017": {
        "text": "\u30DE\u30EA\u30FC",
        "localizations": {
          "en": "Marie"
        }
      }
    }
  },
  {
    "id": 6,
    "properties": {
      "999008199": {
        "text": "\u3044\u3063\u305F\u3044\u3001\u4F55\u3092\u8003\u3048\u3066\u3044\u308B\u3093\u3067\u3059\u304B\uFF01",
