  },
  {
    "id": 12,
    "properties": {
      "999008199": {
        "text": "\u3042\u305F\u3057\u306F\u3001\u30B6\u30B9\u30AD\u30A2\u3055\u3093\u306E\u3053\u3068\u3092\u4EF2\u9593\u3060\u3068\n\u601D\u3063\u3066\u3044\u307E\u3059",
        "localizations": {
          "en": "I... I think of you as one of us."
