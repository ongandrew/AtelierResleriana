    }
  },
  {
    "id": 5,
    "properties": {
      "999008199": {
        "text": "\u5F53\u308A\u524D\u3058\u3083\u306A\u3044\u3067\u3059\u304B\uFF01\n\u7A81\u7136\u3001\u3042\u3093\u306A\u3053\u3068\u3092\u3057\u3066\u2026\u2026\n\u307F\u3093\u306A\u306E\u524D\u304B\u3089\u59FF\u3092\u6D88\u3057\u3066",
        "localizations": {
          "en": "How can you ask that?! After what you did... Just disappearing like that without telling anyone!"
        }
