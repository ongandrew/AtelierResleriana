  },
  {
    "id": 15,
    "properties": {
      "999008199": {
        "text": "\u3060\u3063\u3066\u3042\u306A\u305F\u306F\u79C1\u306E\u3053\u3068\u3092\u4EF2\u9593\u3060\u3068\n\u601D\u3063\u3066\u304F\u308C\u3066\u308B\u306E\u3067\u3057\u3087\u3046\uFF1F",
        "localizations": {
          "en": "But you just said you think of me as a friend, didn\u0027t you?"
