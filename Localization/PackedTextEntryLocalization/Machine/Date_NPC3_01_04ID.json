        }
      }
    }
  },
  {
    "id": 76,
    "properties": {
      "999008199": {
        "text": "\u3060\u3063\u3066\u3042\u3093\u306A\u306B\u9762\u5012\u304F\u3055\u3044\u3053\u3068\u3092\u3057\u3066\u307E\u3067\n\u304A\u5B88\u308A\u3092\u914D\u308B\u306A\u3093\u3066\u3001\u5584\u610F\u4EE5\u5916\u306B\u3042\u308A\u307E\u3059\uFF1F",
        "localizations": {
          "en": "Well, why else would you go through all that trouble to make charms for everyone? It has to be good intentions!"
        }
      },
      "2072370017": {
        "text": "\u30DE\u30EA\u30FC",
        "localizations": {
          "en": "Marie"
        }
      }
    }
  },
  {
    "id": 77,
    "properties": {
      "999008199": {
        "text": "\u5584\u610F\u3060\u3051\u3067\u52D5\u3051\u305F\u3089\u3001\u3053\u3093\u306A\u3053\u3068\u306B\u306F\n\u306A\u3089\u306A\u304B\u3063\u305F\u304B\u3082\u3057\u308C\u306A\u3044\u308F\u306D",
        "localizations": {
          "en": "If I could act on good intentions alone, perhaps things wouldn\u0027t have turned out this way."
        }
      },
      "2072370017": {
        "text": "\u30B6\u30B9\u30AD\u30A2",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 78,
    "properties": {
      "999008199": {
        "text": "\uFF08\u306A\u3093\u3060\u304B\u5BC2\u3057\u305D\u3046\u2026\u2026\u3002\n\u3000\u30B6\u30B9\u30AD\u30A2\u3055\u3093\u306E\u6C42\u3081\u3066\u3044\u308B\u3053\u3068\u306F\n\u3000\u8A00\u3048\u306A\u304B\u3063\u305F\u306E\u304B\u3082\uFF09",
        "localizations": {
          "en": "(She looks so lonely... Maybe I couldn\u0027t understand what she really wanted.)"
        }
      },
      "2072370017": {
        "text": "\u30DE\u30EA\u30FC",
        "localizations": {
          "en": "Marie"
        }
      }
    }
  },
  {
    "id": 79,
    "properties": {
      "999008199": {
        "text": "\u5408\u7406\u6027",
        "localizations": {
          "en": "Logic"
        }
      },
      "2072370017": {
        "text": "\u9078\u629E\u80A2",
        "localizations": {
          "en": "Selection"
        }
      }
    }
  },
  {
    "id": 80,
    "properties": {
      "999008199": {
        "text": "\u5408\u7406\u6027\u2026\u2026\u3067\u3059",
        "localizations": {
          "en": "Logic... that\u0027s what I believe in."
        }
      },
      "2072370017": {
        "text": "\u30DE\u30EA\u30FC",
        "localizations": {
          "en": "Marie"
        }
      }
    }
  },
  {
    "id": 81,
    "properties": {
      "999008199": {
        "text": "\u30B6\u30B9\u30AD\u30A2\u3055\u3093\u306F\u3001\u5B9F\u306F\u4ECA\u3082\n\u4F55\u304B\u306E\u8A08\u753B\u901A\u308A\u306B\u52D5\u3044\u3066\u3044\u3066\u2026\u2026",
        "localizations": {
          "en": "You must still be following some kind of plan..."
        }
      },
      "2072370017": {
        "text": "\u30DE\u30EA\u30FC",
        "localizations": {
          "en": "Marie"
        }
      }
    }
  },
  {
    "id": 82,
    "properties": {
      "999008199": {
        "text": "\u306F\u3041\u2026\u2026\u5446\u308C\u305F\u308F",
        "localizations": {
          "en": "*sigh*... How exasperating."
        }
      },
      "2072370017": {
        "text": "\u30B6\u30B9\u30AD\u30A2",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 83,
    "properties": {
      "999008199": {
        "text": "\u3048\u3063\uFF1F",
        "localizations": {
          "en": "Huh?"
        }
      },
      "2072370017": {
        "text": "\u30DE\u30EA\u30FC",
        "localizations": {
          "en": "Marie"
        }
      }
    }
  },
  {
    "id": 84,
    "properties": {
      "999008199": {
        "text": "\u305D\u308C\u306F\u3069\u3046\u8003\u3048\u3066\u3082\u9055\u3046\u3067\u3057\u3087\u3046\uFF1F\n\u79C1\u306E\u3068\u3063\u3066\u308B\u884C\u52D5\u3068\u5408\u7406\u6027\u306A\u3093\u3066\n\u304B\u3051\u96E2\u308C\u3066\u3044\u308B\u3068\u306F\u601D\u308F\u306A\u3044\uFF1F",
        "localizations": {
          "en": "Don\u0027t you think that\u0027s clearly wrong? Aren\u0027t my actions completely divorced from any kind of logic?"
        }
      },
      "2072370017": {
        "text": "\u30B6\u30B9\u30AD\u30A2",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 85,
    "properties": {
      "999008199": {
        "text": "\u3046\u3063\u2026\u2026\u78BA\u304B\u306B\u2026\u2026",
        "localizations": {
          "en": "Ugh... you\u0027re right..."
        }
      },
      "2072370017": {
        "text": "\u30DE\u30EA\u30FC",
        "localizations": {
          "en": "Marie"
        }
      }
    }
  },
  {
    "id": 86,
    "properties": {
      "999008199": {
        "text": "\u3068\u3093\u3060\u6642\u9593\u306E\u7121\u99C4\u4F7F\u3044\u306D",
        "localizations": {
          "en": "What a waste of time."
        }
      },
      "2072370017": {
        "text": "\u30B6\u30B9\u30AD\u30A2",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 87,
    "properties": {
      "999008199": {
        "text": "\u3042\u305F\u3057\u3001\u307E\u3060\u30B6\u30B9\u30AD\u30A2\u3055\u3093\u306E\u3053\u3068\u306F\n\u3061\u3083\u3093\u3068\u4FE1\u3058\u304D\u308B\u3053\u3068\u306F\u3067\u304D\u307E\u305B\u3093",
        "localizations": {
          "en": "I still can\u0027t fully trust you, Saskia."
        }
      },
      "2072370017": {
        "text": "\u30DE\u30EA\u30FC",
        "localizations": {
          "en": "Marie"
        }
      }
    }
  },
  {
    "id": 88,
    "properties": {
      "999008199": {
        "text": "\u3067\u3082\u2026\u2026",
        "localizations": {
          "en": "But..."
        }
      },
      "2072370017": {
        "text": "\u30DE\u30EA\u30FC",
        "localizations": {
          "en": "Marie"
        }
      }
    }
  },
  {
    "id": 89,
    "properties": {
      "999008199": {
        "text": "\u30B6\u30B9\u30AD\u30A2\u3055\u3093\u306E\u611B\u3060\u3051\u306F\u4FE1\u3058\u307E\u3059",
        "localizations": {
          "en": "I believe in your love."
        }
      },
      "2072370017": {
        "text": "\u30DE\u30EA\u30FC",
        "localizations": {
          "en": "Marie"
        }
      }
    }
  },
  {
    "id": 90,
    "properties": {
      "999008199": {
        "text": "\u307F\u3093\u306A\u306B\u304A\u5B88\u308A\u3092\u914D\u308D\u3046\u3068\u3057\u305F\u3001\n\u512A\u3057\u3044\u30B6\u30B9\u30AD\u30A2\u3055\u3093\u306E\u6C17\u6301\u3061\u3060\u3051\u306F\n\u5618\u3092\u3064\u3044\u3066\u3044\u306A\u3044\u3063\u3066\u3001\u4FE1\u3058\u3066\u307E\u3059\u2026\u2026",
        "localizations": {
          "en": "I believe that your kindness in giving everyone those charms... that feeling wasn\u0027t a lie..."
        }
      },
      "2072370017": {
        "text": "\u30DE\u30EA\u30FC",
        "localizations": {
          "en": "Marie"
        }
      }
    }
  },
  {
    "id": 91,
    "properties": {
      "999008199": {
        "text": "\u3075\u3075\u3002\u672C\u5F53\u306B\u3044\u3044\u5B50\u306D\u3001\u3042\u306A\u305F\u306F",
        "localizations": {
          "en": "Hehe. You really are a good child."
        }
      },
      "2072370017": {
        "text": "\u30B6\u30B9\u30AD\u30A2",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 92,
    "properties": {
      "999008199": {
        "text": "\u79C1\u306E\u3053\u3068\u3092\u3042\u306A\u305F\u304C\u305D\u3046\u3044\u3046\u98A8\u306B\n\u601D\u3063\u3066\u304F\u308C\u3066\u3044\u308B\u306E\u306A\u3089\u3001\u79C1\u306F\u305D\u308C\u3067\u5341\u5206",
        "localizations": {
          "en": "If that\u0027s how you think of me, then that\u0027s more than enough."
        }
      },
      "2072370017": {
        "text": "\u30B6\u30B9\u30AD\u30A2",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 93,
    "properties": {
      "999008199": {
        "text": "\u3044\u3044\u3048\u2026\u2026\u3002\n\u5341\u5206\u3059\u304E\u308B\u304B\u3082\u3057\u308C\u306A\u3044\u308F\u306D\u2026\u2026",
        "localizations": {
          "en": "No... Perhaps it\u0027s even more than I deserve..."
        }
      },
      "2072370017": {
        "text": "\u30B6\u30B9\u30AD\u30A2",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 94,
    "properties": {
      "999008199": {
        "text": "\u3042\u305F\u3057\u3001\u30B6\u30B9\u30AD\u30A2\u3055\u3093\u3092\n\u7406\u89E3\u3059\u308B\u3053\u3068\u306F\u3067\u304D\u307E\u305B\u3093",
        "localizations": {
          "en": "I can\u0027t understand you, Saskia."
        }
      },
      "2072370017": {
        "text": "\u30DE\u30EA\u30FC",
        "localizations": {
          "en": "Marie"
        }
      }
    }
  },
  {
    "id": 95,
    "properties": {
      "999008199": {
        "text": "\u5206\u304B\u3089\u306A\u3044\u3053\u3068\u3060\u3089\u3051\u3060\u3057\u3001\n\u88CF\u5207\u3063\u305F\u306E\u3082\u8A31\u305B\u306A\u3044\u2026\u2026",
        "localizations": {
          "en": "There\u0027s so much I don\u0027t know, and I can\u0027t forgive your betrayal..."
        }
      },
      "2072370017": {
        "text": "\u30DE\u30EA\u30FC",
        "localizations": {
          "en": "Marie"
        }
      }
    }
  },
  {
    "id": 96,
    "properties": {
      "999008199": {
        "text": "\u8CB4\u65B9\u306E\u7ACB\u5834\u3068\u3057\u3066\u306F\u3001\u5F53\u7136\u306E\u610F\u898B\u306D\u3002\n\u7406\u89E3\u3057\u3066\u3082\u3089\u304A\u3046\u3068\u601D\u3046\u5FC3\u3092\u6301\u3063\u3066\u306F\n\u3044\u3051\u306A\u3044\u3053\u3068\u3060\u3063\u305F\u308F",
        "localizations": {
          "en": "That\u0027s a natural reaction from your position. I shouldn\u0027t have expected to be understood."
        }
      },
      "2072370017": {
        "text": "\u30B6\u30B9\u30AD\u30A2",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 97,
    "properties": {
      "999008199": {
        "text": "\u307E\u305F\u3044\u3064\u304B\u3001\u7B11\u9854\u3067\u8A71\u305B\u308B\u65E5\u3092\n\u5F85\u3063\u3066\u3044\u308B\u308F",
        "localizations": {
          "en": "I\u0027ll wait for the day when we can talk again with smiles on our faces."
        }
      },
      "2072370017": {
        "text": "\u30B6\u30B9\u30AD\u30A2",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 98,
    "properties": {
      "999008199": {
        "text": "\u30B6\u30B9\u30AD\u30A2\u3055\u3093\u2026\u2026",
        "localizations": {
          "en": "Saskia..."
        }
      },
      "2072370017": {
        "text": "\u30DE\u30EA\u30FC",
        "localizations": {
          "en": "Marie"
        }
      }
    }
  },
  {
    "id": 99,
    "properties": {
      "999008199": {
        "text": "\u5584\u610F\u3001\u306D\u3002\u3046\u30FC\u3093\u3001\u60DC\u3057\u3044\uFF01",
        "localizations": {
          "en": "Good intentions, hm? Close, but not quite!"
        }
      },
      "2072370017": {
        "text": "\u30B6\u30B9\u30AD\u30A2",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  }
