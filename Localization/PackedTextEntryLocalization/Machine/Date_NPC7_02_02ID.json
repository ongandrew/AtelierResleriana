        "text": "\u9078\u629E\u80A2",
        "localizations": {
          "en": "Selection"
        }
      }
    }
  },
  {
    "id": 8,
    "properties": {
      "999008199": {
        "text": "\u30E6\u30CA\u3055\u3093\u3001\u5BD2\u304F\u306A\u3044\u3067\u3059\u304B\uFF1F",
        "localizations": {
          "en": "Juna, aren\u0027t you cold?"
        }
