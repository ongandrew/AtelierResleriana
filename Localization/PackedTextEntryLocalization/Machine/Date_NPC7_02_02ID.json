        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 7,
    "properties": {
      "999008199": {
        "text": "\u5BD2\u304F\u306A\u3044\u3067\u3059\u304B\uFF1F",
