      "2072370017": {
        "text": "\u9078\u629E\u80A2",
        "localizations": {
          "en": "Selection"
        }
      }
    }
  },
  {
    "id": 39,
    "properties": {
      "999008199": {
        "text": "\u3053\u306E\u306C\u3044\u3050\u308B\u307F\u3001\u661F\u8A95\u306E\u4F7F\u8005\u306E\u88C5\u3044\u3092\n\u3057\u3066\u3044\u3066\u304B\u308F\u3044\u3044\u3067\u3059\uFF01",
        "localizations": {
          "en": "This plushie is wearing Star Birth Messenger attire, isn\u0027t it cute?"
        }
      },
      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 40,
    "properties": {
      "999008199": {
        "text": "\u3042\u3042\u3001\u304B\u308F\u3044\u3044\uFF01\u3000\u3053\u306E\u306C\u3044\u3050\u308B\u307F\u3068\u3044\u3044\u3001\n\u4ECA\u65E5\u306E\u30EC\u30B9\u30CA\u3068\u3044\u3044\u3001\u4F7F\u8005\u306E\u88C5\u3044\u306E\u3082\u306E\u306F\n\u3075\u308F\u3075\u308F\u3082\u3053\u3082\u3053\u3067\u304B\u308F\u3044\u3044\u306A",
        "localizations": {
          "en": "Ah, it is cute! Both this plushie and you today, Resna\u2014the Messenger\u0027s attire is always so fluffy and adorable."
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 41,
    "properties": {
      "999008199": {
        "text": "\u3042\u3042\u3001\u306C\u3044\u3050\u308B\u307F\u3082\u30EC\u30B9\u30CA\u3082\u304B\u308F\u3044\u3044\u2026\u2026\n\u3075\u308F\u3075\u308F\u3060\u2026\u2026",
        "localizations": {
          "en": "Ah, both the plushie and Resna are so cute... So fluffy..."
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 42,
    "properties": {
      "999008199": {
        "text": "\uFF08\u79C1\u307E\u3067\u304B\u308F\u3044\u3044\u3063\u3066\u8A00\u308F\u308C\u3066\u3001\n\u3000\u306A\u3093\u3060\u304B\u6065\u305A\u304B\u3057\u3044\u3088\u30FC\uFF01\uFF09",
        "localizations": {
          "en": "(Being called cute alongside the plushie is making me blush!)"
        }
