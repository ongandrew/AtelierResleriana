      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 22,
    "properties": {
      "999008199": {
        "text": "\u93A7\u7528\u304B\u308F\u3044\u3044\u523A\u7E4D\u98FE\u308A",
