      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 21,
    "properties": {
      "999008199": {
        "text": "\u30E6\u30CA\u3055\u3093\u3001\u3053\u308C\u3069\u3046\u3067\u3059\u304B\uFF1F",
        "localizations": {
          "en": "Juna, what do you think about this?"
