        "text": "\u4ECA\u65E5\u306F\u6765\u3066\u304F\u308C\u3066\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\uFF01\n\u6628\u65E5\u306E\u591C\u306F\u96EA\u304C\u964D\u3063\u305F\u307F\u305F\u3044\u3067\u2026\u2026",
