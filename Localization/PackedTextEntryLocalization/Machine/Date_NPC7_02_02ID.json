  {
    "id": 34,
    "properties": {
      "999008199": {
        "text": "\u304A\u3049\u2026\u2026\u3077\u306B\u3077\u306B\u3001\u3082\u3061\u3082\u3061\u2026\u2026\n\u304B\u308F\u3044\u3044\u2026\u2026\uFF01",
        "localizations": {
          "en": "Oh... squishy and soft... How cute...!"
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 35,
    "properties": {
      "999008199": {
        "text": "\u3060\u3001\u3060\u304C\u3001\u9B54\u7269\u3092\u72E9\u308B\u5074\u3067\u3042\u308B\u9A0E\u58EB\u304C\n\u3077\u306B\u306E\u98FE\u308A\u3092\u6301\u3064\u306A\u3069\u3001\n\u30C0\u3001\u30C0\u30E1\u306B\u6C7A\u307E\u3063\u3066\u3044\u308B\uFF01",
        "localizations": {
          "en": "B-but a knight who hunts monsters can\u0027t possibly carry a Puni charm! It\u0027s out of the question!"
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 36,
    "properties": {
      "999008199": {
        "text": "\uFF08\u96E3\u5100\u3057\u3066\u308B\u306A\u3001\u30E6\u30CA\u3055\u3093\u2026\u2026\uFF09",
