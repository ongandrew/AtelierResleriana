  {
    "id": 33,
    "properties": {
      "999008199": {
        "text": "\u3077\u306B\u306E\u5C0F\u3055\u3044\u6A21\u578B\u304C\u4ED8\u3044\u3066\u3044\u308B\u7D10\u98FE\u308A\u3067\u3059\uFF01\n\u3077\u306B\u304C\u5C11\u3057\u900F\u3051\u3066\u3044\u3066\u3001\u5F3E\u529B\u3082\u3042\u3063\u3066\u3001\n\u304B\u308F\u3044\u3044\u3067\u3059\uFF01",
        "localizations": {
          "en": "It\u0027s a string charm with little translucent Puni figures! They\u0027re bouncy and super cute!"
        }
