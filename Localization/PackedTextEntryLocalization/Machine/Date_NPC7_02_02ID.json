  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "\u738B\u90FD\u3067\u3053\u3053\u307E\u3067\u7A4D\u3082\u308B\u306E\u306F\n\u73CD\u3057\u3044\u304B\u3082\u3057\u308C\u306A\u3044",
