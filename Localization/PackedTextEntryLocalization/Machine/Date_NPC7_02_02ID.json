      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 29,
    "properties": {
      "999008199": {
        "text": "\u307B\u3046\u3001\u9762\u767D\u3044\u5546\u54C1\u3060\u306A\u3002\n\u8CBC\u308A\u65B9\u3067\u500B\u6027\u3082\u51FA\u305D\u3046\u3060",
        "localizations": {
          "en": "Hmm, interesting product. You could really express yourself with these."
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 30,
    "properties": {
      "999008199": {
        "text": "\u3060\u304C\u3001\u6B66\u5668\u3092\u4F7F\u3046\u3046\u3061\u306B\u3069\u3093\u3069\u3093\n\u5265\u304C\u308C\u3066\u3057\u307E\u3063\u305F\u308A\u6C5A\u308C\u3066\u3057\u307E\u3063\u305F\u3089\u2026\u2026\n\u8010\u3048\u3089\u308C\u3093\u2026\u2026\uFF01",
        "localizations": {
          "en": "But if they peel off or get dirty while I\u0027m using my weapon... I couldn\u0027t bear it...!"
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 31,
    "properties": {
      "999008199": {
        "text": "\uFF08\u305F\u3057\u304B\u306B\u3001\u9A0E\u58EB\u306E\u30E6\u30CA\u3055\u3093\u306F\u6B66\u5668\u3092\u3088\u304F\n\u3000\u4F7F\u3046\u304B\u3089\u3059\u3050\u306B\u5265\u304C\u308C\u3061\u3083\u3046\u304B\u3082\u2026\u2026\uFF09",
        "localizations": {
          "en": "(That\u0027s true, they might peel off quickly since Juna uses her weapons so much...)"
