    }
  },
  {
    "id": 19,
    "properties": {
      "999008199": {
        "text": "\u305D\u308C\u3058\u3083\u3001\u307E\u305A\u306F\n\u3042\u305D\u3053\u306E\u96D1\u8CA8\u5C4B\u3055\u3093\u304B\u3089\u898B\u3066\u307F\u307E\u305B\u3093\u304B\uFF1F",
        "localizations": {
          "en": "Shall we start by checking out that general store over there?"
        }
