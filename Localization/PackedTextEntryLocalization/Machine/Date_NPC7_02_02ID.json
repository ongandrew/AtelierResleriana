      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 37,
    "properties": {
      "999008199": {
        "text": "\u30E6\u30CA\u3055\u3093\u3001\u3053\u3063\u3061\u306E\u306F\u3069\u3046\u3067\u3059\u304B\uFF1F",
