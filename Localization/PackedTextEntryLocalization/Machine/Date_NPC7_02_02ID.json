      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 27,
    "properties": {
      "999008199": {
        "text": "\u6B66\u5668\u7528\u304B\u308F\u3044\u3044\u88C5\u98FE\u30B7\u30FC\u30EB",
        "localizations": {
          "en": "Cute weapon decoration stickers"
        }
      },
      "2072370017": {
        "text": "\u9078\u629E\u80A2",
        "localizations": {
          "en": "Selection"
        }
      }
    }
  },
  {
    "id": 28,
    "properties": {
      "999008199": {
        "text": "\u3053\u306E\u30B7\u30FC\u30EB\u3001\u6B66\u5668\u306B\u8CBC\u308C\u308B\u307F\u305F\u3044\u3067\u3059\uFF01\n\u3053\u308C\u3067\u6B66\u5668\u3092\u304B\u308F\u3044\u304F\u3057\u305F\u3089\u3001\n\u9B54\u7269\u3068\u306E\u6226\u3044\u3082\u697D\u3057\u304F\u306A\u308A\u305D\u3046\u3067\u3059",
        "localizations": {
          "en": "These stickers can be put on weapons! It could make fighting monsters more fun with cute weapons!"
        }
