      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 20,
    "properties": {
      "999008199": {
        "text": "\u3042\u3042\u3001\u884C\u3053\u3046",
        "localizations": {
          "en": "Yes, let\u0027s go."
