      "2072370017": {
        "text": "\u9078\u629E\u80A2",
        "localizations": {
          "en": "Selection"
        }
      }
    }
  },
  {
    "id": 23,
    "properties": {
      "999008199": {
        "text": "\u3053\u306E\u93A7\u306B\u4ED8\u3051\u3089\u308C\u308B\u523A\u7E4D\u98FE\u308A\u3001\n\u304B\u308F\u3044\u3044\u3067\u3059\uFF01",
        "localizations": {
          "en": "This embroidered decoration for armor is so cute!"
        }
      },
      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 24,
    "properties": {
      "999008199": {
        "text": "\u3042\u3042\u3001\u304B\u308F\u3044\u3044\u2026\u2026\uFF01",
        "localizations": {
          "en": "Ah, it is cute...!"
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 25,
    "properties": {
      "999008199": {
        "text": "\u3060\u304C\u3001\u93A7\u306B\u306A\u3093\u3066\u4ED8\u3051\u3089\u308C\u3093\uFF01\n\u4ED6\u306E\u9A0E\u58EB\u306B\u898B\u3089\u308C\u305F\u3089\u3001\u306A\u3093\u3068\u8A00\u3048\u3070\u2026\u2026\uFF01",
        "localizations": {
          "en": "But I can\u0027t put that on my armor! What would the other knights say...!"
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 26,
    "properties": {
      "999008199": {
        "text": "\uFF08\u304B\u308F\u3044\u3044\u3082\u306E\u597D\u304D\u3092\u96A0\u3057\u305F\u3044\u30E6\u30CA\u3055\u3093\u306B\u306F\n\u3000\u96E3\u3057\u3044\u3082\u306E\u307F\u305F\u3044\u2026\u2026\uFF09",
        "localizations": {
          "en": "(Seems too difficult for Juna, since she wants to hide her love of cute things...)"
        }
