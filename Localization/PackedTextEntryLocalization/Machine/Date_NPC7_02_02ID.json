  {
    "id": 4,
    "properties": {
      "999008199": {
        "text": "\u79C1\u306E\u51FA\u8EAB\u5730\u306E\u30CF\u30A4\u30CD\u5DDE\u306F\u706B\u5C71\u5730\u57DF\u3060\u304B\u3089\u3001\n\u4ECA\u3067\u3082\u96EA\u3092\u898B\u308B\u3068\u3001\n\u73CD\u3057\u3044\u3082\u306E\u3092\u898B\u305F\u6C17\u6301\u3061\u306B\u306A\u308B",
        "localizations": {
          "en": "I\u0027m from the volcanic region of Heine, so even now, seeing snow feels like quite a novelty."
        }
