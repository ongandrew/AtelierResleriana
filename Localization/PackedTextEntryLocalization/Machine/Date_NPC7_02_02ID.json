      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 38,
    "properties": {
      "999008199": {
        "text": "\u661F\u8A95\u306E\u4F7F\u8005\u306E\u88C5\u3044\u306E\u306C\u3044\u3050\u308B\u307F",
        "localizations": {
          "en": "Star Birth Messenger plushie"
