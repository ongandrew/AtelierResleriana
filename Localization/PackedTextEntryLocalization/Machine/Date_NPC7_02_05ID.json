[
  {
    "id": 0,
    "properties": {
      "999008199": {
        "text": "\u512A\u52DD\u306F\uFF01\u3000\u767D\u591C\u306E\u9A0E\u58EB\u3001\u30E6\u30CA\u30FB\u30F4\u30A1\u30A4\u30C4\u3060\u30FC\uFF01",
        "localizations": {
          "en": "The winner is... Juna Waitz, Knight of the Midnight Sun!"
        }
      },
      "2072370017": {
        "text": "\u53F8\u4F1A",
        "localizations": {
          "en": "Announcer"
        }
      }
    }
  },
  {
    "id": 1,
    "properties": {
      "999008199": {
        "text": "\u30E6\u30CA\u3055\u3093\uFF01\u3000\u512A\u52DD\u3067\u3059\uFF01\u3000\u304A\u3081\u3067\u3068\u3046\u3054\u3056\u3044\u307E\u3059\uFF01",
        "localizations": {
          "en": "Juna! You won! Congratulations!"
        }
      },
      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 2,
    "properties": {
      "999008199": {
        "text": "\u3042\u3042\u2026\u2026\u3053\u308C\u3082\u30EC\u30B9\u30CA\u306E\u304A\u304B\u3052\u3060\u3002\u3042\u308A\u304C\u3068\u3046",
        "localizations": {
          "en": "Yes... This victory is thanks to you, Resna. Thank you."
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "\u30E6\u30CA\u3055\u3093\u304A\u3081\u3067\u3068\u30FC\uFF01",
        "localizations": {
          "en": "Congratulations, Juna!"
        }
      },
      "2072370017": {
        "text": "\u89B3\u5BA2\u306E\u5973\u6027",
        "localizations": {
          "en": "Female Spectator"
        }
      }
    }
  },
  {
    "id": 4,
    "properties": {
      "999008199": {
        "text": "\u5B8C\u6557\u3060\u305C\u2026\u2026\uFF01",
        "localizations": {
          "en": "Total defeat...!"
        }
      },
      "2072370017": {
        "text": "\u51FA\u5834\u8005\u306E\u7537\u6027",
        "localizations": {
          "en": "Male Participant"
        }
      }
    }
  },
  {
    "id": 5,
    "properties": {
      "999008199": {
        "text": "\u3053\u3061\u3089\u3001\u512A\u52DD\u8CDE\u54C1\u306E\u3077\u306B\u3050\u308B\u307F\u306B\u306A\u308A\u307E\u30FC\u3059\uFF01",
        "localizations": {
          "en": "Here\u0027s your grand prize\u2014a Puni plushie!"
        }
      },
      "2072370017": {
        "text": "\u53F8\u4F1A",
        "localizations": {
          "en": "Announcer"
        }
      }
    }
  },
  {
    "id": 6,
    "properties": {
      "999008199": {
        "text": "\u304B\u3001\u304B\u308F\u2026\u2026\uFF01\u3000\u3093\u3093\u3063\u3002\u3042\u308A\u304C\u305F\u304F\u3044\u305F\u3060\u3053\u3046",
        "localizations": {
          "en": "It\u0027s... c-cute...! *ahem* I gratefully accept."
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 7,
    "properties": {
      "999008199": {
        "text": "\u2026\u2026\n\u3053\u3046\u3044\u3046\u3082\u306E\u306F\u3001\u79C1\u3088\u308A\u3082\u30EC\u30B9\u30CA\u306E\u65B9\u304C\u4F3C\u5408\u3046\u3060\u308D\u3046",
        "localizations": {
          "en": "...\nSurely something like this would suit you better than me, Resna."
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 8,
    "properties": {
      "999008199": {
        "text": "\u3044\u3048\u3002\u3053\u306E\u3077\u306B\u3050\u308B\u307F\u306F\u3001\n\u30E6\u30CA\u3055\u3093\u306B\u62B1\u304D\u3057\u3081\u3066\u307B\u3057\u3044\u307F\u305F\u3044\u3067\u3059\u3088",
        "localizations": {
          "en": "No, no. This Puni plushie looks like it wants you to hug it, Juna!"
        }
      },
      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 9,
    "properties": {
      "999008199": {
        "text": "\u304E\u3085\u3063\u3066\u3057\u3066\u3042\u3052\u3066\u304F\u3060\u3055\u3044\uFF01",
        "localizations": {
          "en": "Go on, give it a squeeze!"
        }
      },
      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 10,
    "properties": {
      "999008199": {
        "text": "\u306A\u3063\u2026\u2026\uFF01\u3000\u305D\u3001\u305D\u3093\u306A\u3053\u3068\u3001\u79C1\u304C\u2026\u2026\uFF01\uFF1F",
        "localizations": {
          "en": "Wha...! M-me, doing something like that...!?"
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 11,
    "properties": {
      "999008199": {
        "text": "\u30E6\u30CA\u3055\u30FC\u3093\uFF01\u3000\u62B1\u304D\u3057\u3081\u3066\u3042\u3052\u3066\u3088\u30FC\uFF01",
        "localizations": {
          "en": "Come on, Juna! Give it a hug!"
        }
      },
      "2072370017": {
        "text": "\u89B3\u5BA2\u306E\u5973\u6027",
        "localizations": {
          "en": "Female Spectator"
        }
      }
    }
  },
  {
    "id": 12,
    "properties": {
      "999008199": {
        "text": "\u30E6\u30CA\u3055\u3093\u306F\u5F37\u3044\u304B\u3089\u3001\u62B1\u304D\u3057\u3081\u3066\u3082\u3089\u3048\u305F\u3089\n\u3077\u306B\u3050\u308B\u307F\u3082\u5B89\u5FC3\u3059\u308B\u3060\u308D\u3046\u306A\u30FC\u3002\u5B09\u3057\u3044\u3060\u308D\u3046\u306A\u30FC",
        "localizations": {
          "en": "Juna\u0027s so strong, that plushie would feel super safe in her arms. It must be so happy!"
        }
      },
      "2072370017": {
        "text": "\u89B3\u5BA2\u306E\u7537\u6027",
        "localizations": {
          "en": "Male Spectator"
        }
      }
    }
  },
  {
    "id": 13,
    "properties": {
      "999008199": {
        "text": "\u305D\u3001\u305D\u308C\u306A\u3089\u3070\u2026\u2026",
        "localizations": {
          "en": "I-if that\u0027s the case..."
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 14,
    "properties": {
      "999008199": {
        "text": "\u304E\u3085\u30FC\u3063\u3002\u3075\u3075\u3001\u304B\u308F\u3044\u3044\u2026\u2026",
        "localizations": {
          "en": "*squeeze* Hehe, how adorable..."
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 15,
    "properties": {
      "999008199": {
        "text": "\u4ECA\u65E5\u306F\u304A\u75B2\u308C\u3055\u307E\u3067\u3057\u305F\u3002\n\u5C11\u3057\u30A2\u30C8\u30EA\u30A8\u3067\u4F11\u3093\u3067\u3044\u3063\u3066\u304F\u3060\u3055\u3044",
        "localizations": {
          "en": "You must be tired. Why don\u0027t you rest a while at the atelier?"
        }
      },
      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 16,
    "properties": {
      "999008199": {
        "text": "\u3042\u3042\u3002\u304A\u90AA\u9B54\u3059\u308B\u3002\u2026\u2026\u3068\u3053\u308D\u3067\u3001\u8CDE\u54C1\u3060\u304C\n\u79C1\u304C\u3082\u3089\u3063\u3066\u3057\u307E\u3063\u3066\u672C\u5F53\u306B\u3044\u3044\u306E\u304B\uFF1F",
        "localizations": {
          "en": "Yes, I\u0027ll take you up on that offer. ...By the way, are you certain it\u0027s alright for me to keep the prize?"
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 17,
    "properties": {
      "999008199": {
        "text": "\u306F\u3044\uFF01\u3000\u30E6\u30CA\u3055\u3093\u304C\u3082\u3089\u3063\u3066\u304F\u3060\u3055\u3044\uFF01\n\u30E6\u30CA\u3055\u3093\u304C\u3001\u305D\u306E\u3077\u306B\u3050\u308B\u307F\u306B\u60F9\u304B\u308C\u3066\n\u51FA\u5834\u767B\u9332\u3057\u305F\u3093\u3067\u3059\u304B\u3089",
        "localizations": {
          "en": "Of course! You should keep it, Juna! After all, you entered the competition because you were drawn to this Puni plushie."
        }
      },
      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 18,
    "properties": {
      "999008199": {
        "text": "\u305D\u308C\u306B\u3001\u79C1\u306B\u3068\u3063\u3066\u306F\u3001\u30E6\u30CA\u3055\u3093\u3068\u3053\u3046\u3057\u3066\n\u4E00\u7DD2\u306B\u5927\u4F1A\u3092\u512A\u52DD\u3057\u305F\u3063\u3066\u3044\u3046\u601D\u3044\u51FA\u304C\n\u304B\u3051\u304C\u3048\u306E\u306A\u3044\u4F55\u3088\u308A\u306E\u8CDE\u54C1\u3067\u3059\u304B\u3089\uFF01",
        "localizations": {
          "en": "Besides, for me, winning the competition together with you is the most precious prize I could have received!"
        }
      },
      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 19,
    "properties": {
      "999008199": {
        "text": "\u305D\u3046\u304B\u2026\u2026\u3042\u308A\u304C\u3068\u3046\u30EC\u30B9\u30CA\u3002\n\u3053\u306E\u3077\u306B\u3050\u308B\u307F\u3001\u5927\u5207\u306B\u3055\u305B\u3066\u3082\u3089\u3046",
        "localizations": {
          "en": "I see... Thank you, Resna. I\u0027ll treasure this plushie."
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 20,
    "properties": {
      "999008199": {
        "text": "\u306F\u3044\uFF01\u3000\u2026\u2026\u3042\u308C\uFF1F\u3000\u30E6\u30CA\u3055\u3093\u3001\n\u3042\u305D\u3053\u3092\u898B\u3066\u304F\u3060\u3055\u3044\u3002\u3042\u308C\u306F\u306A\u3093\u3067\u3057\u3087\u3046",
        "localizations": {
          "en": "Yes! ...Oh? Juna, look over there. What could that be?"
        }
      },
      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 21,
    "properties": {
      "999008199": {
        "text": "\u3053\u308C\u306F\u3001\u30B1\u30FC\u30AD\u3067\u3059\u306D\u3002\n\u305D\u308C\u3068\u624B\u7D19\u304C\u4ED8\u3044\u3066\u3044\u307E\u3059\u3002\n\u30E6\u30CA\u3055\u3093\u3001\u8AAD\u3093\u3067\u307F\u3066\u304F\u3060\u3055\u3044",
        "localizations": {
          "en": "It\u0027s a cake. And there\u0027s a letter with it. Juna, would you read it?"
        }
      },
      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 22,
    "properties": {
      "999008199": {
        "text": "\u300C\u30E6\u30CA\u3078\u3000\u8CB4\u541B\u306B\u661F\u306E\u5C0E\u304D\u304C\u3042\u308A\u307E\u3059\u3088\u3046\u306B\n\u3000\u661F\u8A95\u306E\u4F7F\u8005\u3088\u308A\u300D\u2026\u2026\u3053\u308C\u306F\u3001\u4F7F\u8005\u304B\u3089\u306E\n\u30D7\u30EC\u30BC\u30F3\u30C8\u3068\u3044\u3046\u3053\u3068\u304B\uFF01\uFF1F",
        "localizations": {
          "en": "\u0027To Juna: May the stars guide your path. From the Star Festival Messenger\u0027... Could this be a present from the Messenger!?"
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 23,
    "properties": {
      "999008199": {
        "text": "\u304D\u3063\u3068\u305D\u3046\u3067\u3059\u3088\uFF01\u3000\u661F\u8A95\u306E\u4F7F\u8005\u306F\u3001\n\u59FF\u3092\u898B\u305B\u305A\u30D7\u30EC\u30BC\u30F3\u30C8\u3060\u3051\u7F6E\u3044\u3066\u3044\u304F\u3068\n\u8A00\u3044\u307E\u3059\u304B\u3089",
        "localizations": {
          "en": "It must be! They say the Star Festival Messenger leaves presents without ever being seen."
        }
      },
      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 24,
    "properties": {
      "999008199": {
        "text": "\u2026\u2026\u305D\u3046\u3060\u306A\u3002\u3042\u308A\u304C\u3068\u3046\u3001\u661F\u8A95\u306E\u4F7F\u8005\u3002\n\u30B1\u30FC\u30AD\u3001\u3068\u3066\u3082\u7F8E\u5473\u3057\u305D\u3046\u3060\u3002\n\u3053\u306E\u307E\u307E\u3053\u3053\u3067\u98DF\u3079\u3066\u3082\u3044\u3044\u3060\u308D\u3046\u304B\uFF1F",
        "localizations": {
          "en": "...Indeed. Thank you, Star Festival Messenger. The cake looks delicious. Would it be alright to eat it here?"
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 25,
    "properties": {
      "999008199": {
        "text": "\u306F\u3044\u3001\u3082\u3061\u308D\u3093\u3067\u3059\uFF01\u3000\u4ECA\u304A\u8336\u6DF9\u308C\u307E\u3059\u306D",
        "localizations": {
          "en": "Yes, of course! I\u0027ll brew some tea right away."
        }
      },
      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 26,
    "properties": {
      "999008199": {
        "text": "\u3042\u308A\u304C\u3068\u3046\u3001\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Thank you, Resna."
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 27,
    "properties": {
      "999008199": {
        "text": "\uFF08\u30E6\u30CA\u3055\u3093\u3068\u5927\u4F1A\u512A\u52DD\u3067\u304D\u307E\u3057\u305F\uFF01\n\u3000\u661F\u8A95\u306E\u4F7F\u8005\u30D7\u30EC\u30BC\u30F3\u30C8\u5927\u4F5C\u6226\u3082\u5927\u6210\u529F\uFF01\n\u3000\u7D20\u6575\u306A\u8056\u8A95\u796D\u306B\u306A\u308A\u307E\u3057\u305F\uFF09",
        "localizations": {
          "en": "(We won the competition together! And Operation Star Festival Messenger Present was a huge success! What a wonderful Star Festival this turned out to be!)"
        }
      },
      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  }
]