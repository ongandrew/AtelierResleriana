  {
    "id": 21,
    "properties": {
      "999008199": {
        "text": "\u3051\u3069\u3001\u4EBA\u306E\u5FC3\u306F\u8907\u96D1\u602A\u5947\u3002\n\u81EA\u5206\u3067\u81EA\u5206\u304C\u5206\u304B\u3089\u306A\u3044\u6642\u3082\u3042\u308B\u3067\u3057\u3087\u3046",
        "localizations": {
          "en": "But the human heart is complex and mysterious.\nSometimes we don\u0027t understand ourselves."
        }
