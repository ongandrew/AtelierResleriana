  },
  {
    "id": 23,
    "properties": {
      "999008199": {
        "text": "\u3068\u306F\u3044\u3048\u3001\u3042\u306A\u305F\u306B\u3068\u3063\u3066\u79C1\u306F\u6575\u306E\u306F\u305A\u3002\n\u305D\u3057\u3066\u3001\u305D\u306E\u9006\u3082\u307E\u305F\u7136\u308A",
        "localizations": {
          "en": "Though I should be your enemy.\nAnd you should be mine."
