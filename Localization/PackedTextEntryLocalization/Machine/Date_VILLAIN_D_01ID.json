  },
  {
    "id": 36,
    "properties": {
      "999008199": {
        "text": "\u305D\u308C\u306F\u3082\u3061\u308D\u3093\u3088\u3002\n\u3042\u306A\u305F\u306E\u671B\u3080\u3082\u306E\u3092\u6E21\u305B\u308B\u306F\u305A\u3060\u308F",
        "localizations": {
