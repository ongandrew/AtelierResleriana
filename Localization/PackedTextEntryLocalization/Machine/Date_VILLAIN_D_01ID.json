      "2072370017": {
        "text": "\u30AF\u30EA\u30BB\u30EB\u30C0",
        "localizations": {
          "en": "Criselda"
        }
      }
    }
  },
  {
    "id": 22,
    "properties": {
      "999008199": {
        "text": "\u305D\u308C\u3067\u3082\u4F55\u304B\u3057\u3089\u306E\u7406\u7531\u3092\u4ED8\u3051\u308B\u306A\u3089\u2026\u2026\n\u304D\u3063\u3068\u3001\u3042\u306A\u305F\u306F\u79C1\u306B\u5C0E\u304B\u308C\u305F\u306E\u3088",
        "localizations": {
          "en": "If I had to give it a reason...\nI\u0027d say you were drawn to me."
