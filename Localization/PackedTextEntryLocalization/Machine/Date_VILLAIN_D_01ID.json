  {
    "id": 20,
    "properties": {
      "999008199": {
        "text": "\u81EA\u5206\u3067\u3082\u5206\u304B\u3089\u306A\u3044\u2026\u2026\uFF1F\n\u4E0D\u601D\u8B70\u306A\u3053\u3068\u3092\u3044\u3046\u306E\u306D",
