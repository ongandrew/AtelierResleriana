    }
  },
  {
    "id": 2,
    "properties": {
      "999008199": {
        "text": "\u304A\u304B\u3048\u308A\u306A\u3055\u3044\u3002\n\u610F\u5916\u3068\u65E9\u304B\u3063\u305F\u308F\u306D\u2015\u2015",
        "localizations": {
          "en": "Welcome back.\nThat was quicker than I expected--"
        }
