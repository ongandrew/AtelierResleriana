      "2072370017": {
        "text": "\u30AF\u30EA\u30BB\u30EB\u30C0",
        "localizations": {
          "en": "Criselda"
        }
      }
    }
  },
  {
    "id": 9,
    "properties": {
      "999008199": {
        "text": "\u7D44\u7E54\u306E\u9577\u3068\u3057\u3066\u3001\u4EF2\u9593\u3068\u3057\u3066\u3001\n\u5FC3\u914D\u306B\u306A\u308B\u3067\u3057\u3087\u3046\uFF1F",
        "localizations": {
          "en": "As both the leader and your companion,\nwouldn\u0027t you expect me to worry?"
        }
