      "2072370017": {
        "text": "\u30AF\u30EA\u30BB\u30EB\u30C0",
        "localizations": {
          "en": "Criselda"
        }
      }
    }
  },
  {
    "id": 57,
    "properties": {
      "999008199": {
        "text": "\u3060\u3051\u3069\u3001\u305D\u308C\u306F\u307E\u305F\u5F8C\u3067\u3002\n\u4ECA\u306F\u3086\u3063\u304F\u308A\u4F11\u307F\u306A\u3055\u3044",
        "localizations": {
