  },
  {
    "id": 17,
    "properties": {
      "999008199": {
        "text": "\u306A\u308B\u307B\u3069\u2026\u2026\n\u3042\u306A\u305F\u3001\u305D\u3046\u3084\u3063\u3066\u3054\u307E\u304B\u3059\u30BF\u30A4\u30D7\u306A\u306E\u306D",
        "localizations": {
          "en": "I see...\nSo you\u0027re the type to make excuses"
