  {
    "id": 20,
    "properties": {
      "999008199": {
        "text": "\u4F3C\u5408\u308F\u306A\u3044\u308F\u3088\u3002\n\u3042\u306A\u305F\u306F\u7D20\u76F4\u306A\u59FF\u304C\u4E00\u756A\u306A\u3093\u3060\u304B\u3089",
        "localizations": {
          "en": "It doesn\u0027t suit you.\nYou\u0027re best when you\u0027re being honest"
