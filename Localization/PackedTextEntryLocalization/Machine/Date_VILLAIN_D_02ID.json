        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 60,
    "properties": {
      "999008199": {
        "text": "\u305D\u308C\u307B\u3069\u307E\u3067\u306B\u9811\u5F35\u3063\u3066\u304F\u308C\u308B\u3001\n\u305D\u306E\u6839\u6E90\u306F\uFF1F",
