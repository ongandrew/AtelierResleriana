      "2072370017": {
        "text": "\u9078\u629E\u80A2",
        "localizations": {
          "en": "Selection"
        }
      }
    }
  },
  {
    "id": 49,
    "properties": {
      "999008199": {
        "text": "\u304A\u4ED5\u7F6E\u304D\u3063\u3066\u2026\u2026\u307E\u308B\u3067\u5B50\u3069\u3082\u6271\u3044\u306D\u3002\n\u305D\u3093\u306A\u306B\u5FC3\u914D\u306A\u306E\uFF1F",
        "localizations": {
          "en": "Punishment... You\u0027re treating me like a child.\nAre you really that worried?"
        }
