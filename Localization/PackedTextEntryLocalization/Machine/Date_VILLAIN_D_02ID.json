  },
  {
    "id": 18,
    "properties": {
      "999008199": {
        "text": "\u3051\u3069\u3001\u5618\u304C\u4E0B\u624B\u3002\n\u5206\u304B\u308A\u3084\u3059\u304F\u76EE\u304C\u53F3\u4E0A\u306B\u6CF3\u3044\u3060\u308F",
        "localizations": {
          "en": "But you\u0027re not very good at lying.\nYour eyes clearly darted to the upper right"
