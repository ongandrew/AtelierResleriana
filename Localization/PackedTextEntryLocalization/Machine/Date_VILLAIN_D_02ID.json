    }
  },
  {
    "id": 1,
    "properties": {
      "999008199": {
        "text": "\u3054\u6240\u671B\u306E\u7D20\u6750\u3001\u63A1\u3063\u3066\u304D\u305F\u308F\u3088\u3002\n\u306F\u3044\u3001\u3053\u308C",
        "localizations": {
          "en": "I got the materials you asked for.\nHere you go"
