        "localizations": {
          "en": "Selection"
        }
      }
    }
  },
  {
    "id": 43,
    "properties": {
      "999008199": {
        "text": "\u2026\u2026\u3042\u3093\u305F\u3001\u9762\u5012\u898B\u304C\u3044\u3044\u306E\u306D",
        "localizations": {
          "en": "...You\u0027re quite the caretaker, aren\u0027t you?"
        }
