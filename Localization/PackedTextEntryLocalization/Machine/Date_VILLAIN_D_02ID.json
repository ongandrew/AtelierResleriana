      "2072370017": {
        "text": "\u30AF\u30EA\u30BB\u30EB\u30C0",
        "localizations": {
          "en": "Criselda"
        }
      }
    }
  },
  {
    "id": 42,
    "properties": {
      "999008199": {
        "text": "\u9762\u5012\u898B\u304C\u3044\u3044\u306E\u306D",
