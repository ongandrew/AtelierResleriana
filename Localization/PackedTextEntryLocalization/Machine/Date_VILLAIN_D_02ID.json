        "text": "\u30AF\u30EA\u30BB\u30EB\u30C0",
        "localizations": {
          "en": "Criselda"
        }
      }
    }
  },
  {
    "id": 59,
    "properties": {
      "999008199": {
        "text": "\u7D20\u6750\u3092\u624B\u306B\u5165\u308C\u308B\u305F\u3081\u306B\u306F\n\u6226\u308F\u3056\u308B\u3092\u5F97\u306A\u304B\u3063\u305F\u3001\u305D\u308C\u3060\u3051\u306E\u8A71\u3088",
        "localizations": {
          "en": "I had to fight to get the materials.\nThat\u0027s all there is to it"
