        "text": "\u30AF\u30EA\u30BB\u30EB\u30C0",
        "localizations": {
          "en": "Criselda"
        }
      }
    }
  },
  {
    "id": 58,
    "properties": {
      "999008199": {
        "text": "\u6226\u3046\u4E8B\u304C\u672C\u5F53\u306B\u597D\u304D\u306A\u306E\u306D\u30F4\u30A1\u30EC\u30EA\u30A2",
