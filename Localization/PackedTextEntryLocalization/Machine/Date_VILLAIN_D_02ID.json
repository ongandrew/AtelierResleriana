  {
    "id": 24,
    "properties": {
      "999008199": {
        "text": "\u305D\u306E\u52F2\u7AE0\u306E\u4FA1\u5024\u304C\u3044\u304B\u307B\u3069\u304B\u3001\n\u751A\u3060\u7591\u554F\u306B\u601D\u3048\u308B\u308F",
