        "text": "\u30AF\u30EA\u30BB\u30EB\u30C0",
        "localizations": {
          "en": "Criselda"
        }
      }
    }
  },
  {
    "id": 56,
    "properties": {
      "999008199": {
        "text": "\u305D\u308C\u306A\u3089\u3001\u305D\u306E\u6E07\u671B\u3092\u6E80\u305F\u3057\u3066\u3042\u3052\u308B\u306E\u3082\n\u307E\u305F\u4E00\u8208\u306D\u2026\u2026\u3046\u3093\u3046\u3093",
        "localizations": {
