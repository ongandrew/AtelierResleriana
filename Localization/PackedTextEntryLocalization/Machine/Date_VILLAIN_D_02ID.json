        "text": "\u30AF\u30EA\u30BB\u30EB\u30C0",
        "localizations": {
          "en": "Criselda"
        }
      }
    }
  },
  {
    "id": 37,
    "properties": {
      "999008199": {
        "text": "\u3053\u306E\u30B1\u30AC\u3067\u3088\u304F\u6B69\u3044\u3066\u5E30\u3063\u3066\u304D\u305F\u308F\u306D\u3002\n\u5FC3\u914D\u3092\u901A\u308A\u8D8A\u3057\u3066\u5446\u308C\u3066\u304D\u305F\u308F",
        "localizations": {
          "en": "I can\u0027t believe you walked back with this injury.\nI\u0027m beyond worried and into exasperation"
        }
