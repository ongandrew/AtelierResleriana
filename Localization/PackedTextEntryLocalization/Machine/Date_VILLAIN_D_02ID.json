      "2072370017": {
        "text": "\u30AF\u30EA\u30BB\u30EB\u30C0",
        "localizations": {
          "en": "Criselda"
        }
      }
    }
  },
  {
    "id": 52,
    "properties": {
      "999008199": {
        "text": "\u5FC3\u914D\u306E\uFF11\u3064\u3082\u3059\u308B\u3068\u601D\u3046\u3057\u3001\n\u8CAC\u4EFB\u3092\u611F\u3058\u308B\u306E\u306F\u5F53\u7136\u3088",
        "localizations": {
          "en": "It\u0027s only natural that I\u0027d worry\nand feel responsible"
