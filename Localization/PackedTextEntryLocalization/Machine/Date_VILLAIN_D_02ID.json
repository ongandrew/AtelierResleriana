      "2072370017": {
        "text": "\u30AF\u30EA\u30BB\u30EB\u30C0",
        "localizations": {
          "en": "Criselda"
        }
      }
    }
  },
  {
    "id": 10,
    "properties": {
      "999008199": {
        "text": "\u6B63\u76F4\u306B\u7B54\u3048\u308B",
        "localizations": {
          "en": "Answer honestly"
