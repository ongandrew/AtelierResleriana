    }
  },
  {
    "id": 70,
    "properties": {
      "999008199": {
        "text": "\u3042\u3093\u305F\u306B\u559C\u3093\u3067\u307B\u3057\u3044\u304B\u3089\u7121\u8336\u3092\u3057\u305F\u306E\u3088",
