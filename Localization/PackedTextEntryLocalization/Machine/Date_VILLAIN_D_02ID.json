  {
    "id": 69,
    "properties": {
      "999008199": {
        "text": "\u2026\u2026\u7C21\u5358\u306A\u8A71\u3088\u3002\n\u3059\u3079\u3066\u306F\u3042\u3093\u305F\u306E\u305F\u3081",
        "localizations": {
          "en": "...It\u0027s simple.\nIt\u0027s all for your sake"
