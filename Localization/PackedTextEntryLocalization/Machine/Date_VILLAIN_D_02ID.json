      "2072370017": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 8,
    "properties": {
      "999008199": {
        "text": "\u305D\u3046\u3067\u306A\u304F\u3066\u3082\u3001\u4ECA\u306E\u3042\u306A\u305F\u306F\u79C1\u305F\u3061\u3001\n\u6975\u591C\u306E\u932C\u91D1\u515A\u306E\u4E00\u54E1\u306A\u3093\u3060\u3082\u306E",
        "localizations": {
          "en": "Besides, you\u0027re now a member of our group,\nthe Polar Night Alchemists"
        }
