      "2072370017": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 50,
    "properties": {
      "999008199": {
        "text": "\u5B50\u3069\u3082\u6271\u3044\u3057\u3066\u3044\u308B\u3064\u3082\u308A\u306F\u306A\u3044\u308F\u3002",
        "localizations": {
          "en": "I\u0027m not trying to treat you like a child."
        }
