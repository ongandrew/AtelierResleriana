      "2072370017": {
        "text": "\u30AF\u30EA\u30BB\u30EB\u30C0",
        "localizations": {
          "en": "Criselda"
        }
      }
    }
  },
  {
    "id": 53,
    "properties": {
      "999008199": {
        "text": "\u304A\u4ED5\u7F6E\u304D\u3057\u3066\u307B\u3057\u3044",
        "localizations": {
          "en": "Please punish me"
        }
