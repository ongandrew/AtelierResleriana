  },
  {
    "id": 11,
    "properties": {
      "999008199": {
        "text": "\u63A1\u53D6\u306E\u9014\u4E2D\u3001\u9B54\u7269\u306B\u51FA\u304F\u308F\u3057\u305F\u306E\u3002\n\u305D\u3053\u3067\u3001\u5C11\u3057\u7121\u8336\u3092\u3057\u305F\u3060\u3051\u3088",
        "localizations": {
          "en": "I ran into some monsters while gathering materials.\nI just got a bit reckless, that\u0027s all"
        }
      },
      "2072370017": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 12,
    "properties": {
      "999008199": {
        "text": "\u306F\u3041\u2026\u2026\u3069\u3046\u3057\u3066\u305D\u3093\u306A\u3053\u3068\u3092\uFF1F",
        "localizations": {
          "en": "*sigh*... Why would you do something like that?"
        }
