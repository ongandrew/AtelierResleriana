  {
    "id": 30,
    "properties": {
      "999008199": {
        "text": "\u3068\u306B\u304B\u304F\u3001\u624B\u5F53\u3066\u3057\u3066\u3042\u3052\u308B\u3002\n\u3053\u3063\u3061\u306B\u6765\u306A\u3055\u3044",
