      "2072370017": {
        "text": "\u30AF\u30EA\u30BB\u30EB\u30C0",
        "localizations": {
          "en": "Criselda"
        }
      }
    }
  },
  {
    "id": 13,
    "properties": {
      "999008199": {
        "text": "\u78BA\u304B\u306B\u304A\u9858\u3044\u3057\u305F\u306E\u306F\u79C1\u3060\u3051\u3069\u3001\n\u305D\u3053\u307E\u3067\u3057\u3066\u6B32\u3057\u3044\u3082\u306E\u3067\u3082\u306A\u304B\u3063\u305F\u308F",
        "localizations": {
          "en": "Yes, I made the request, but I never wanted you\nto go this far"
        }
      },
      "2072370017": {
        "text": "\u30AF\u30EA\u30BB\u30EB\u30C0",
        "localizations": {
          "en": "Criselda"
        }
      }
    }
  },
  {
    "id": 14,
    "properties": {
      "999008199": {
        "text": "\u307E\u3063\u305F\u304F\u2026\u2026\u3042\u307E\u308A\u7121\u8336\u306F\u3057\u306A\u3044\u3067\u3002\n\u3042\u306A\u305F\u304C\u50B7\u3064\u304F\u306E\u306F\u60B2\u3057\u3044\u308F",
        "localizations": {
          "en": "Really... Please don\u0027t be so reckless.\nIt pains me to see you hurt"
        }
      },
      "2072370017": {
        "text": "\u30AF\u30EA\u30BB\u30EB\u30C0",
        "localizations": {
          "en": "Criselda"
        }
      }
    }
  },
  {
    "id": 15,
    "properties": {
      "999008199": {
        "text": "\u3054\u307E\u304B\u3059",
        "localizations": {
          "en": "Try to deflect"
