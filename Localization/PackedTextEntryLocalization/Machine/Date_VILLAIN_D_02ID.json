      "2072370017": {
        "text": "\u30AF\u30EA\u30BB\u30EB\u30C0",
        "localizations": {
          "en": "Criselda"
        }
      }
    }
  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "\u3063\u3066\u3001\u305D\u306E\u8107\u8179\u2026\u2026\n\u30B1\u30AC\u3057\u3066\u308B\u308F\u306D\uFF1F",
        "localizations": {
          "en": "Wait, your side...\nYou\u0027re injured?"
        }
