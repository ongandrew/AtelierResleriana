      }
    }
  },
  {
    "id": 16,
    "properties": {
      "999008199": {
        "text": "\u3053\u308C\u306F\u5143\u3005\u3042\u3063\u305F\u30B1\u30AC\u3002\n\u305D\u308C\u304C\u3061\u3087\u3063\u3068\u60AA\u5316\u3057\u305F\u3060\u3051",
        "localizations": {
          "en": "This is an old wound.\nIt just acted up a bit"
