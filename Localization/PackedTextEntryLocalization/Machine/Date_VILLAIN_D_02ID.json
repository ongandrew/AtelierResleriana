        "text": "\u30AF\u30EA\u30BB\u30EB\u30C0",
        "localizations": {
          "en": "Criselda"
        }
      }
    }
  },
  {
    "id": 48,
    "properties": {
      "999008199": {
        "text": "\u305D\u3093\u306A\u306B\u5FC3\u914D\uFF1F",
        "localizations": {
          "en": "Are you that worried?"
        }
