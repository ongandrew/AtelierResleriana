      "2072370017": {
        "text": "\u30AF\u30EA\u30BB\u30EB\u30C0",
        "localizations": {
          "en": "Criselda"
        }
      }
    }
  },
  {
    "id": 51,
    "properties": {
      "999008199": {
        "text": "\u3051\u3069\u3001\u3055\u3063\u304D\u3044\u3063\u305F\u3067\u3057\u3087\uFF1F\n\u7D20\u6750\u306E\u63A1\u53D6\u3092\u304A\u9858\u3044\u3057\u305F\u306E\u306F\u79C1",
        "localizations": {
          "en": "But as I said earlier,\nI\u0027m the one who made the request"
        }
