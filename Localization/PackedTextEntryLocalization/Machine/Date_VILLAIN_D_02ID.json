      "2072370017": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 44,
    "properties": {
      "999008199": {
        "text": "\u305D\u3046\u3088\u3001\u30EF\u30EB\u30BF\u30FC\u306A\u3093\u304B\u521D\u3081\u3066\n\u4F1A\u3063\u305F\u6642\u306F\u5DF1\u306B\u7121\u9813\u7740\u3059\u304E\u3066\n\u898B\u3066\u3044\u3089\u308C\u306A\u304B\u3063\u305F\u3050\u3089\u3044",
        "localizations": {
          "en": "Indeed. When I first met Walther,\nhe was so negligent of himself\nI could barely stand to watch"
        }
      },
      "2072370017": {
        "text": "\u30AF\u30EA\u30BB\u30EB\u30C0",
        "localizations": {
          "en": "Criselda"
        }
      }
    }
  },
  {
    "id": 45,
    "properties": {
      "999008199": {
        "text": "\u307E\u3041\u3001\n\u305B\u3063\u304B\u304F\u4EF2\u9593\u306B\u306A\u3063\u305F\u3093\u3060\u3082\u306E",
        "localizations": {
          "en": "Well, since we\u0027re companions now..."
        }
