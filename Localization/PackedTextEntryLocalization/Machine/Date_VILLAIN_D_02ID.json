      "2072370017": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 55,
    "properties": {
      "999008199": {
        "text": "\u3042\u3089\u2026\u2026\u3002\n\u3082\u3057\u304B\u3057\u3066\u3001\u305D\u3046\u3044\u3046\u306E\u304C\u597D\u307F\u306A\u306E\uFF1F",
        "localizations": {
