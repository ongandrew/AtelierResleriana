      "2072370017": {
        "text": "\u9078\u629E\u80A2",
        "localizations": {
          "en": "Selection"
        }
      }
    }
  },
  {
    "id": 54,
    "properties": {
      "999008199": {
        "text": "\u3042\u3093\u305F\u304C\u305D\u3046\u3057\u305F\u3044\u306A\u3089\u3001\n\u305D\u3046\u3059\u308C\u3070\u3044\u3044\u3058\u3083\u306A\u3044",
        "localizations": {
          "en": "If that\u0027s what you want to do,\nthen go ahead"
