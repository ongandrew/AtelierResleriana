      "2072370017": {
        "text": "\u30AF\u30EA\u30BB\u30EB\u30C0",
        "localizations": {
          "en": "Criselda"
        }
      }
    }
  },
  {
    "id": 4,
    "properties": {
      "999008199": {
        "text": "\u3057\u3066\u308B\u3051\u3069\u2026\u2026\u3060\u304B\u3089\u3001\u306A\u306B\uFF1F\n\u3053\u308C\u304F\u3089\u3044\u5E73\u6C17\u3060\u3057\u3001\u3042\u3093\u305F\u306B\u306F\u95A2\u4FC2\u306A\u3044",
        "localizations": {
          "en": "Yeah, and...? What of it?\nIt\u0027s nothing serious, and it\u0027s none of your concern"
        }
      },
      "2072370017": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 5,
    "properties": {
      "999008199": {
        "text": "\u7D20\u6750\u306E\u63A1\u53D6\u3092\u304A\u9858\u3044\u3057\u305F\u306E\u306F\u79C1\u3088\uFF1F",
        "localizations": {
          "en": "I\u0027m the one who asked you to gather those materials, aren\u0027t I?"
        }
      },
      "2072370017": {
        "text": "\u30AF\u30EA\u30BB\u30EB\u30C0",
        "localizations": {
          "en": "Criselda"
        }
      }
    }
  },
  {
    "id": 6,
    "properties": {
      "999008199": {
        "text": "\u305D\u306E\u305B\u3044\u3067\u30B1\u30AC\u3092\u3057\u305F\u306E\u306A\u3089\u3001\n\u6C17\u306B\u3059\u308B\u306E\u306F\u81EA\u7136\u3058\u3083\u306A\u3044\u304B\u3057\u3089\uFF1F",
        "localizations": {
          "en": "If you got hurt because of that,\nit\u0027s only natural that I\u0027d be concerned"
        }
