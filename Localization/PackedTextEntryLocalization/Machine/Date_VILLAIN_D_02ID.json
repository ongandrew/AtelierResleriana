        "text": "\u30AF\u30EA\u30BB\u30EB\u30C0",
        "localizations": {
          "en": "Criselda"
        }
      }
    }
  },
  {
    "id": 40,
    "properties": {
      "999008199": {
        "text": "\u305D\u308C\u306F\u7121\u7406\u3084\u7121\u8336\u3092\u3057\u3066\u3044\u3044\n\u514D\u7F6A\u7B26\u306B\u306F\u306A\u3089\u306A\u3044\u306E\u3088\uFF1F",
        "localizations": {
          "en": "That doesn\u0027t give you permission to be\nreckless and push yourself too hard"
        }
