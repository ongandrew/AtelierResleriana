  {
    "id": 22,
    "properties": {
      "999008199": {
        "text": "\u3053\u308C\u304F\u3089\u3044\u3069\u3046\u3063\u3066\u3053\u3068\u306A\u3044\u3057\u3001\n\u30B1\u30AC\u306F\u52F2\u7AE0\u307F\u305F\u3044\u306A\u3082\u306E\u3067\u3057\u3087",
        "localizations": {
          "en": "This is nothing.\nWounds are like medals of honor, right?"
