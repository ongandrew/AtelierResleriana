        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 63,
    "properties": {
      "999008199": {
        "text": "\uFF08\u30EC\u30B9\u30CA\u305F\u3061\u3068\u306E\u65C5\u3092\u7D9A\u3051\u308B\u305F\u3081\u2026\u2026\n\u3000\u3060\u304B\u3089\u3001\u3059\u3079\u3066\u805E\u304D\u51FA\u3057\u3066\u2015\u2015\uFF09",
        "localizations": {
          "en": "(To continue traveling with Resna and the others...\nThat\u0027s why I need to learn everything--)"
        }
