        "text": "\u30AF\u30EA\u30BB\u30EB\u30C0",
        "localizations": {
          "en": "Criselda"
        }
      }
    }
  },
  {
    "id": 38,
    "properties": {
      "999008199": {
        "text": "\u3044\u3063\u305F\u3067\u3057\u3087\u3002\n\u3053\u308C\u304F\u3089\u3044\u5E73\u6C17\u3060\u3063\u3066",
        "localizations": {
