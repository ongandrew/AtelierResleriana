        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 39,
    "properties": {
      "999008199": {
        "text": "\u6C17\u4E08\u306A\u3068\u3053\u308D\u306F\n\u3042\u306A\u305F\u306E\u7F8E\u5FB3\u304B\u3082\u3057\u308C\u306A\u3044\u3051\u3069\u2026\u2026",
