      "2072370017": {
        "text": "\u30AF\u30EA\u30BB\u30EB\u30C0",
        "localizations": {
          "en": "Criselda"
        }
      }
    }
  },
  {
    "id": 46,
    "properties": {
      "999008199": {
        "text": "\u3051\u3069\u3001\u305D\u308C\u306F\u305D\u308C\u3002\n\u305B\u3063\u304B\u304F\u4EF2\u9593\u306B\u306A\u3063\u305F\u3093\u3060\u3082\u306E",
        "localizations": {
          "en": "But that aside,\nsince we\u0027re companions now..."
        }
      },
      "2072370017": {
        "text": "\u30AF\u30EA\u30BB\u30EB\u30C0",
        "localizations": {
          "en": "Criselda"
        }
      }
    }
  },
  {
    "id": 47,
    "properties": {
      "999008199": {
        "text": "\u305D\u308C\u305E\u308C\u304C\u52A9\u3051\u5408\u3063\u3066\u3001\n\u5168\u54E1\u304C\u5E78\u305B\u306B\u306A\u308B\u3079\u304D\u3058\u3083\u306A\u3044\uFF1F",
        "localizations": {
          "en": "Shouldn\u0027t we all help each other\nand strive for everyone\u0027s happiness?"
        }
