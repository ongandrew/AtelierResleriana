        "text": "\u30AF\u30EA\u30BB\u30EB\u30C0",
        "localizations": {
          "en": "Criselda"
        }
      }
    }
  },
  {
    "id": 41,
    "properties": {
      "999008199": {
        "text": "\u6B21\u3001\u540C\u3058\u3088\u3046\u306A\u3053\u3068\u304C\u3042\u308C\u3070\u3001\n\u304A\u4ED5\u7F6E\u304D\u3092\u3059\u308B\u304B\u3089\u306D",
        "localizations": {
          "en": "If this happens again,\nyou\u0027ll be getting a punishment"
        }
