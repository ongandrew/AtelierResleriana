  },
  {
    "id": 19,
    "properties": {
      "999008199": {
        "text": "\u305D\u308C\u306B\u4E00\u7DD2\u306B\u3044\u308B\u3060\u3051\u3067\u3082\n\u843D\u3061\u7740\u3044\u3066\u3001\u7652\u3055\u308C\u308B\u3068\u3044\u3046\u304B\u2026\u2026",
        "localizations": {
          "en": "And just being with you calms me down,\nit\u0027s soothing..."
