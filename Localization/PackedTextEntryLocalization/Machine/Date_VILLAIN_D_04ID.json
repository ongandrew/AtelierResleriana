  {
    "id": 20,
    "properties": {
      "999008199": {
        "text": "\u3068\u306B\u304B\u304F\u3001\u79C1\u306B\u3068\u3063\u3066\n\u30D7\u30E9\u30B9\u306B\u306A\u308B\u3053\u3068\u306F\u78BA\u304B\u3088",
