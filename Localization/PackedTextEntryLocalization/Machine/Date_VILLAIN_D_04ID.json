        "text": "\u305D\u308C\u3058\u3083\u3042\u3001\u805E\u304F\u3051\u3069\u2026\u2026\n\u79C1\u306F\u4F55\u3092\u6E07\u671B\u3057\u3066\u3044\u308B\u3068\u601D\u3046\uFF1F",
        "localizations": {
