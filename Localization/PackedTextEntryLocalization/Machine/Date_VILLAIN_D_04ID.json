  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "\u305F\u307E\u306B\u306F\u3053\u3046\u3044\u3046\u6642\u9593\u3082\n\u60AA\u304F\u306A\u3044\u3068\u601D\u308F\u306A\u3044\uFF1F",
        "localizations": {
