  {
    "id": 22,
    "properties": {
      "999008199": {
        "text": "\uFF08\u672A\u3060\u672C\u5FC3\u3092\u8986\u3044\u96A0\u305D\u3046\u3068\u3059\u308B\u306E\u306D\u2026\u2026\n\u3000\u3075\u3075\u3075\u3001\u898B\u304F\u3073\u3089\u308C\u305F\u3082\u306E\u306D\uFF09",
        "localizations": {
          "en": "(Still trying to hide your true feelings...\nHehe, you underestimate me.)"
