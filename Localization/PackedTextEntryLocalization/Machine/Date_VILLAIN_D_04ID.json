  {
    "id": 18,
    "properties": {
      "999008199": {
        "text": "\u3042\u3093\u305F\u3068\u4F1A\u8A71\u3057\u3066\u308B\u3068\u697D\u3057\u3044\u3057\u3001\n\u3042\u3093\u305F\u304C\u559C\u3093\u3067\u308B\u3068\u79C1\u3082\u5B09\u3057\u3044",
