  {
    "id": 13,
    "properties": {
      "999008199": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2\u3002\n\u3042\u306A\u305F\u3001\u79C1\u3068\u4E00\u7DD2\u306B\u3044\u3066\u3069\u3046\uFF1F",
