  },
  {
    "id": 16,
    "properties": {
      "999008199": {
        "text": "ふふっ。今度はあんたが倒れるかもね〜。\nさてと、どこから探す？",
        "localizations": {
          "en": "Hehe. Maybe you'll be the one to collapse this time. Now, where should we start looking?"
        }
      },
      "2072370017": {
        "text": "アイラ",
        "localizations": {
          "en": "Isla"
