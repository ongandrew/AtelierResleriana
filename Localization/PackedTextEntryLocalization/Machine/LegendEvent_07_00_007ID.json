      "2072370017": {
        "text": "アイラ",
        "localizations": {
          "en": "Isla"
        }
      }
    }
  },
  {
    "id": 13,
    "properties": {
      "999008199": {
        "text": "ア？",
        "localizations": {
          "en": "What?"
