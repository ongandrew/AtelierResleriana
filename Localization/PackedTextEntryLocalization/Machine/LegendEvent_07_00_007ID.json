      "2072370017": {
        "text": "ルトガー",
        "localizations": {
          "en": "Rutger"
        }
      }
    }
  },
  {
    "id": 11,
    "properties": {
      "999008199": {
        "text": "お前は安全な場所で休んでろ。オレがあいつらを\n探しに行く",
        "localizations": {
          "en": "You stay somewhere safe and rest. I'll go look for the others."
        }
      },
      "2072370017": {
        "text": "ルトガー",
        "localizations": {
          "en": "Rutger"
        }
      }
