[
  {
    "id": 0,
    "properties": {
      "999008199": {
        "text": "あっぶない……",
        "localizations": {
          "en": "That was close..."
        }
      },
      "2072370017": {
        "text": "アイラ",
        "localizations": {
          "en": "Isla"
        }
      }
    }
  },
  {
    "id": 1,
    "properties": {
      "999008199": {
        "text": "な……んだ……？",
        "localizations": {
          "en": "What's... happening...?"
        }
      },
      "2072370017": {
        "text": "ルトガー",
        "localizations": {
          "en": "Rutger"
        }
      }
    }
  },
  {
    "id": 2,
    "properties": {
      "999008199": {
        "text": "ルトガー！",
        "localizations": {
          "en": "Rutger!"
        }
      },
      "2072370017": {
        "text": "アイラ",
        "localizations": {
          "en": "Isla"
        }
      }
    }
  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "来るな！",
        "localizations": {
          "en": "Stay back!"
        }
      },
      "2072370017": {
        "text": "ルトガー",
        "localizations": {
          "en": "Rutger"
        }
      }
    }
  },
  {
    "id": 4,
    "properties": {
      "999008199": {
        "text": "今のオレは変だ！\u3000頭の中で声が聞こえるんだ！\nクソッ！\u3000わけが分からねぇ！",
        "localizations": {
          "en": "Something's wrong with me! I'm hearing voices in my head! Damn it! None of this makes any sense!"
        }
      },
      "2072370017": {
        "text": "ルトガー",
        "localizations": {
          "en": "Rutger"
        }
      }
    }
  },
  {
    "id": 5,
    "properties": {
      "999008199": {
        "text": "近寄るなって言ったろ！\nオレにも自分が何しでかすか分からねぇんだ！",
        "localizations": {
          "en": "I told you to stay away! I don't even know what I might do!"
        }
      },
      "2072370017": {
        "text": "ルトガー",
        "localizations": {
          "en": "Rutger"
        }
      }
    }
  },
  {
    "id": 6,
    "properties": {
      "999008199": {
        "text": "だからって、放っておけるわけないよ！\nどうにかなるって！",
        "localizations": {
          "en": "That's exactly why I can't leave you alone! We'll figure this out!"
        }
      },
      "2072370017": {
        "text": "アイラ",
        "localizations": {
          "en": "Isla"
        }
      }
    }
  },
  {
    "id": 7,
    "properties": {
      "999008199": {
        "text": "な、なるかよ……",
        "localizations": {
          "en": "Like hell we will..."
        }
      },
      "2072370017": {
        "text": "ルトガー",
        "localizations": {
          "en": "Rutger"
        }
      }
    }
  },
  {
    "id": 8,
    "properties": {
      "999008199": {
        "text": "で、その声はなんて聞こえたわけ？",
        "localizations": {
          "en": "So what are these voices saying?"
        }
      },
      "2072370017": {
        "text": "アイラ",
        "localizations": {
          "en": "Isla"
        }
      }
    }
  },
  {
    "id": 9,
    "properties": {
      "999008199": {
        "text": "さっきは……このへんに来いって……\n来なきゃいけねぇような気になって……",
        "localizations": {
          "en": "Earlier... they were telling me to come here... I felt like I had no choice..."
        }
      },
      "2072370017": {
        "text": "ルトガー",
        "localizations": {
          "en": "Rutger"
        }
      }
    }
  },
  {
    "id": 10,
    "properties": {
      "999008199": {
        "text": "今も……「仲間を増やせ」とか「集まれ」とか……",
        "localizations": {
          "en": "And now... stuff like 'gather more allies' and 'come together'..."
        }
      },
      "2072370017": {
        "text": "ルトガー",
        "localizations": {
          "en": "Rutger"
        }
      }
    }
  },
  {
    "id": 11,
    "properties": {
      "999008199": {
        "text": "ずっと聞こえてるんだ……？",
        "localizations": {
          "en": "You're hearing them constantly...?"
        }
      },
      "2072370017": {
        "text": "アイラ",
        "localizations": {
          "en": "Isla"
        }
      }
    }
  },
  {
    "id": 12,
    "properties": {
      "999008199": {
        "text": "ここがどこだかも分からねぇ。頭の中も変だ。\nどうすりゃいいんだ……",
        "localizations": {
          "en": "I don't even know where we are. My head's all messed up. What am I supposed to do..."
        }
      },
      "2072370017": {
        "text": "ルトガー",
        "localizations": {
          "en": "Rutger"
        }
      }
    }
  },
  {
    "id": 13,
    "properties": {
      "999008199": {
        "text": "そ、そもそも高濃度マナ領域の中だし！\n変なことが起きたって不思議じゃないよ！\u3000多分！",
        "localizations": {
          "en": "W-well, we are in a manabound zone! Weird stuff happening isn't that strange! Probably!"
        }
      },
      "2072370017": {
        "text": "アイラ",
        "localizations": {
          "en": "Isla"
        }
      }
    }
  },
  {
    "id": 14,
    "properties": {
      "999008199": {
        "text": "多分って、なんだよそれ",
        "localizations": {
          "en": "What do you mean 'probably'?"
        }
      },
      "2072370017": {
        "text": "ルトガー",
        "localizations": {
          "en": "Rutger"
        }
      }
    }
  },
  {
    "id": 15,
    "properties": {
      "999008199": {
        "text": "ああもう、しゃらくせえ！\n最初からおかしいことだらけなんだ",
        "localizations": {
          "en": "Ugh, this is getting old! Everything's been weird from the start!"
        }
      },
      "2072370017": {
        "text": "ルトガー",
        "localizations": {
          "en": "Rutger"
        }
      }
    }
  },
  {
    "id": 16,
    "properties": {
      "999008199": {
        "text": "ならよ。この際、どこに集まれって言ってんのか、\n探ってみるのも悪くねぇな",
        "localizations": {
          "en": "You know what? Maybe we should find out where these voices want us to gather. Might as well see what this is all about."
        }
      },
      "2072370017": {
        "text": "ルトガー",
        "localizations": {
          "en": "Rutger"
        }
      }
    }
  }
]