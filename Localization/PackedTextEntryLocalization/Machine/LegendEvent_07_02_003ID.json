[
  {
    "id": 0,
    "properties": {
      "999008199": {
        "text": "なんだ？\u3000人々が同じ方向に向かっているように\n見えるが……",
        "localizations": {
          "en": "What's going on? Everyone seems to be heading in the same direction..."
        }
      },
      "2072370017": {
        "text": "ヴィクトル",
        "localizations": {
          "en": "Viktor"
        }
      }
