[
  {
    "id": 0,
    "properties": {
      "999008199": {
        "text": "\u3088\u3063\u3001\u5929\u624D\u932C\u91D1\u8853\u58EB\u306E\u30D5\u30A3\u30EA\u30B9\uFF01",
        "localizations": {
          "en": "Hey, it\u0027s Firis, the genius alchemist!"
        }
      },
      "2072370017": {
        "text": "\u89B3\u5BA2",
        "localizations": {
          "en": "Spectator"
        }
      }
    }
  },
  {
    "id": 1,
    "properties": {
      "999008199": {
        "text": "\u3060\u304B\u3089\u9055\uFF5E\u3046\uFF01\u3000\u5929\u624D\u306F\u30A2\u30BF\u30B7\uFF01\n\u30A4\u30EB\u30E1\u30EA\u30A2\u30FB\u30D5\u30A9\u30F3\u30FB\u30E9\u30A4\u30F3\u30A6\u30A7\u30D0\u30FC\uFF01",
        "localizations": {
          "en": "That\u0027s wrong~! I\u0027m the genius!\nIlmeria Von Leinweber!"
        }
      },
      "2072370017": {
        "text": "\u30A4\u30EB\u30E1\u30EA\u30A2",
        "localizations": {
          "en": "Ilmeria"
        }
      }
    }
  },
  {
    "id": 2,
    "properties": {
      "999008199": {
        "text": "\u4ECA\u3092\u3068\u304D\u3081\u304F\u3001\u8D85\u4E00\u6D41\u306E\u5929\u624D\u932C\u91D1\u8853\u58EB\u3088\uFF01",
        "localizations": {
          "en": "I\u0027m the trending, first-class genius alchemist!"
        }
