  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "\u5929\u624D\u306A\u306E\u306F\u3053\u306E\u308F\u305F\u3057\u3082\u3063\uFF01\n\u30D5\u30A3\u30EA\u30B9\u30FB\u30DF\u30B9\u30C8\u30EB\u30FC\u30C8\uFF01",
        "localizations": {
          "en": "I\u0027m the genius too!\nFiris Mistlud!"
