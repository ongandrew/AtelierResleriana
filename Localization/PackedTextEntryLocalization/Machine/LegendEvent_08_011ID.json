[
  {
    "id": 0,
    "properties": {
      "999008199": {
        "text": "\u306A\u3041\u3001\u304A\u524D\u306E\u63B4\u3093\u3060\u60C5\u5831\u3068\u3044\u3046\u306E\u306F\u78BA\u304B\u306A\u3082\u306E\u306A\u306E\u304B\uFF1F\n\u5F85\u3061\u5408\u308F\u305B\u3068\u306F\u3044\u3048\u3001\u7A7A\u6C17\u304C\u91CD\u82E6\u3057\u304F\u611F\u3058\u308B\u2026\u2026",
        "localizations": {
          "en": "Hey, are you sure this intel of yours is reliable?\nEven for a meetup, the atmosphere feels heavy..."
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 1,
    "properties": {
      "999008199": {
        "text": "\u306A\u306B\u8A00\u3063\u3066\u3093\u306E\u3055\u3001\u3053\u308C\u304B\u3089\u30CD\u30BF\u5408\u308F\u305B\u306A\u3093\u3060\u3088\uFF1F\n\u4ECA\u3058\u3083\u305F\u3063\u305F\uFF11\u56DE\u306E\u30CD\u30BF\u5408\u308F\u305B\u3082\u672C\u6C17\u3067\u3084\u308B\u3093\u3060\u3088\uFF01",
        "localizations": {
          "en": "What are you talking about? We\u0027re here to rehearse!\nNowadays even a single rehearsal has to be taken seriously!"
        }
      },
      "2072370017": {
        "text": "\u30CF\u30A4\u30C7\u30A3",
        "localizations": {
          "en": "Heidi"
        }
      }
    }
  },
  {
    "id": 2,
    "properties": {
      "999008199": {
        "text": "\u305D\u3001\u305D\u3046\u3044\u3046\u3082\u306E\u306A\u306E\u304B\u2026\u2026",
        "localizations": {
          "en": "I-Is that how it works...?"
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "\u2026\u2026\u3042\u3063\u3001\u307B\u3089\u6765\u305F\u3088\u3063\uFF01\u3000\u3082\u3063\u3068\u305D\u3063\u3061\u884C\u3063\u3066\uFF01",
        "localizations": {
          "en": "...Ah, look, they\u0027re here! Quick, move over there!"
        }
      },
      "2072370017": {
        "text": "\u30CF\u30A4\u30C7\u30A3",
        "localizations": {
          "en": "Heidi"
        }
      }
    }
  },
  {
    "id": 4,
    "properties": {
      "999008199": {
        "text": "\u3042\u3063\u3001\u30B3\u30E9\u3063\uFF01\u3000\u305D\u3093\u306A\u306B\u62BC\u3059\u306A\u2026\u2026\uFF01",
        "localizations": {
          "en": "H-Hey! Stop pushing...!"
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 5,
    "properties": {
      "999008199": {
        "text": "\u3053\u3093\u306A\u3068\u3053\u308D\u306B\u547C\u3073\u51FA\u3057\u3066\u3069\u3046\u3057\u305F\u306E\u3088\u3001\u30D5\u30A3\u30EA\u30B9\u3002\n\u305D\u308C\u306B\u305D\u3093\u306A\u9854\u3057\u3061\u3083\u3063\u3066\u3001\u3089\u3057\u304F\u306A\u3044\u308F\u3088\uFF1F",
        "localizations": {
          "en": "Why did you call me out here, Firis?\nAnd what\u0027s with that face? It\u0027s not like you at all."
        }
      },
      "2072370017": {
        "text": "\u30A4\u30EB\u30E1\u30EA\u30A2",
        "localizations": {
          "en": "Ilmeria"
        }
      }
    }
  },
  {
    "id": 6,
    "properties": {
      "999008199": {
        "text": "\u2026\u2026\u3042\u306E\u306D\u3001\u30A4\u30EB\u3061\u3083\u3093\u3002\n\u4ECA\u65E5\u306F\u30A4\u30EB\u3061\u3083\u3093\u306B\u304A\u9858\u3044\u304C\u3042\u3063\u3066\u3053\u3053\u306B\u547C\u3093\u3060\u306E",
        "localizations": {
          "en": "Um, listen, Ilmie.\nI called you here today because I have a favor to ask."
        }
      },
      "2072370017": {
        "text": "\u30D5\u30A3\u30EA\u30B9",
        "localizations": {
          "en": "Firis"
        }
      }
    }
  },
  {
    "id": 7,
    "properties": {
      "999008199": {
        "text": "\u304A\u9858\u3044\uFF1F\u3000\u3042\u3001\u3082\u3057\u304B\u3057\u3066\u4ECA\u306E\u30A2\u30BF\u30B7\u3068\u3069\u3063\u3061\u304C\n\u932C\u91D1\u8853\u306E\u8155\u304C\u4E0A\u304B\u52DD\u8CA0\u3057\u3088\u3046\u3063\u3066\u2026\u2026",
        "localizations": {
          "en": "A favor? Oh, don\u0027t tell me you want to see which of us\nis better at alchemy..."
        }
      },
      "2072370017": {
        "text": "\u30A4\u30EB\u30E1\u30EA\u30A2",
        "localizations": {
          "en": "Ilmeria"
        }
      }
    }
  },
  {
    "id": 8,
    "properties": {
      "999008199": {
        "text": "\u3046\u3046\u3093\u9055\u3046\u3088\u3002\u308F\u305F\u3057\u306D\u3001\n\u3082\u3046\u30A4\u30EB\u3061\u3083\u3093\u306E\u30E2\u30CE\u30DE\u30CD\u306F\u3084\u3081\u308B\u3053\u3068\u306B\u3057\u305F\u306E",
        "localizations": {
          "en": "No, that\u0027s not it. You see,\nI\u0027ve decided to stop doing impersonations of you."
        }
      },
      "2072370017": {
        "text": "\u30D5\u30A3\u30EA\u30B9",
        "localizations": {
          "en": "Firis"
        }
      }
    }
  },
  {
    "id": 9,
    "properties": {
      "999008199": {
        "text": "\u305D\u308C\u306B\u516C\u8A8D\u932C\u91D1\u8853\u58EB\u5236\u5EA6\u304B\u3089\u3082\u3001\u629C\u3051\u305F\u3044\u3093\u3060\u3002\n\u308F\u305F\u3057\u306E\u6027\u306B\u5408\u3063\u3066\u306A\u3044\u3068\u601D\u3046\u3057\u2026\u2026",
        "localizations": {
          "en": "And I want to leave the Licensed Alchemist system too.\nI don\u0027t think it suits me..."
        }
      },
      "2072370017": {
        "text": "\u30D5\u30A3\u30EA\u30B9",
        "localizations": {
          "en": "Firis"
        }
      }
    }
  },
  {
    "id": 10,
    "properties": {
      "999008199": {
        "text": "\u305D\u3046\u2026\u2026",
        "localizations": {
          "en": "I see..."
        }
      },
      "2072370017": {
        "text": "\u30A4\u30EB\u30E1\u30EA\u30A2",
        "localizations": {
          "en": "Ilmeria"
        }
      }
    }
  },
  {
    "id": 11,
    "properties": {
      "999008199": {
        "text": "\u3054\u3001\u3054\u3081\u3093\u306D\u3001\u3044\u304D\u306A\u308A\u3053\u3093\u306A\u304A\u9858\u3044\u3057\u3066\u3002\n\u3073\u3063\u304F\u308A\u3057\u3061\u3083\u3063\u305F\u3088\u306D",
        "localizations": {
          "en": "S-Sorry for suddenly asking this.\nYou must be shocked..."
        }
      },
      "2072370017": {
        "text": "\u30D5\u30A3\u30EA\u30B9",
        "localizations": {
          "en": "Firis"
        }
      }
    }
  },
  {
    "id": 12,
    "properties": {
      "999008199": {
        "text": "\u3044\u3044\u308F\u3088",
        "localizations": {
          "en": "It\u0027s fine."
        }
      },
      "2072370017": {
        "text": "\u30A4\u30EB\u30E1\u30EA\u30A2",
        "localizations": {
          "en": "Ilmeria"
        }
      }
    }
  },
  {
    "id": 13,
    "properties": {
      "999008199": {
        "text": "\u3084\u3063\u3071\u308A\u305D\u3046\u7C21\u5358\u306B\u8A8D\u3081\u3066\u3082\u3089\u3048\u308B\u308F\u3051\u2026\u2026\u3002\n\u3048\u3063\uFF1F\u3000\u30A4\u30EB\u3061\u3083\u3093\u3001\u4ECA\u306A\u3093\u3066\uFF1F",
        "localizations": {
          "en": "I knew it wouldn\u0027t be that easy to get your approv\u2014\nHuh? Ilmie, what did you just say?"
        }
      },
      "2072370017": {
        "text": "\u30D5\u30A3\u30EA\u30B9",
        "localizations": {
          "en": "Firis"
        }
      }
    }
  },
  {
    "id": 14,
    "properties": {
      "999008199": {
        "text": "\u3060\u304B\u3089\u3001\u3044\u3044\u308F\u3088\u3002\u629C\u3051\u3066\u3082\u3002\n\u305D\u308C\u306B\u30B3\u30F3\u30D3\u89E3\u6D88\u306A\u3093\u3066\u9858\u3063\u305F\u308A\u53F6\u3063\u305F\u308A\u3060\u308F",
        "localizations": {
          "en": "I said it\u0027s fine. You can quit.\nBesides, breaking up our duo is exactly what I wanted."
        }
      },
      "2072370017": {
        "text": "\u30A4\u30EB\u30E1\u30EA\u30A2",
        "localizations": {
          "en": "Ilmeria"
        }
      }
    }
  },
  {
    "id": 15,
    "properties": {
      "999008199": {
        "text": "\u3048\uFF5E\uFF01\uFF1F\u3000\u305D\u3001\u305D\u3093\u306A\u3042\u3063\u3055\u308A\uFF01\uFF1F",
        "localizations": {
          "en": "Whaaaat!? J-Just like that!?"
        }
      },
      "2072370017": {
        "text": "\u30D5\u30A3\u30EA\u30B9",
        "localizations": {
          "en": "Firis"
        }
      }
    }
  },
  {
    "id": 16,
    "properties": {
      "999008199": {
        "text": "\u3060\u3063\u3066\u5143\u3005\u82B8\u4EBA\u3067\u901A\u3059\u3064\u3082\u308A\u306A\u3044\u3057\u3001\n\u516C\u8A8D\u932C\u91D1\u8853\u58EB\u3060\u3063\u3066\u2026\u2026",
        "localizations": {
          "en": "Well, I never planned on being an entertainer anyway,\nand as for being a Licensed Alchemist..."
        }
      },
      "2072370017": {
        "text": "\u30A4\u30EB\u30E1\u30EA\u30A2",
        "localizations": {
          "en": "Ilmeria"
        }
      }
    }
  },
  {
    "id": 17,
    "properties": {
      "999008199": {
        "text": "\u3067\u3082\u3067\u3082\u3067\u3082\u3067\u3082\uFF01\u3000\u3082\u3046\u3042\u3093\u306A\u306B\u5927\u52E2\u306E\u524D\u3067\n\u62CD\u624B\u3068\u304B\u3082\u3089\u3048\u306A\u304F\u306A\u308B\u3093\u3060\u3088\uFF01\uFF1F",
        "localizations": {
          "en": "But but but but! We won\u0027t get applause from\nall those people anymore!?"
        }
      },
      "2072370017": {
        "text": "\u30D5\u30A3\u30EA\u30B9",
        "localizations": {
          "en": "Firis"
        }
      }
    }
  },
  {
    "id": 18,
    "properties": {
      "999008199": {
        "text": "\u516C\u8A8D\u932C\u91D1\u8853\u58EB\u5236\u5EA6\u3060\u3063\u3066\u63A8\u85A6\u72B6\u304C\u2026\u2026",
        "localizations": {
          "en": "And the Licensed Alchemist recommendation..."
        }
      },
      "2072370017": {
        "text": "\u30D5\u30A3\u30EA\u30B9",
        "localizations": {
          "en": "Firis"
        }
      }
    }
  },
  {
    "id": 19,
    "properties": {
      "999008199": {
        "text": "\u3082\u3046\uFF01\u3000\u30D5\u30A3\u30EA\u30B9\u306F\u5F15\u304D\u7559\u3081\u3066\u3082\u3089\u3044\u305F\u3044\u306E\uFF01\uFF1F",
        "localizations": {
          "en": "Geez! Do you want me to stop you or something!?"
        }
      },
      "2072370017": {
        "text": "\u30A4\u30EB\u30E1\u30EA\u30A2",
        "localizations": {
          "en": "Ilmeria"
        }
      }
    }
  },
  {
    "id": 20,
    "properties": {
      "999008199": {
        "text": "\u9055\u3046\u3088\uFF01\uFF1F\u3000\u305D\u3001\u305D\u3046\u3058\u3083\u306A\u304F\u3066\n\u306A\u3093\u3067\u3059\u3093\u306A\u308A\u53D7\u3051\u5165\u308C\u3066\u308B\u306E\u304B\u4E0D\u601D\u8B70\u3067\u2026\u2026",
        "localizations": {
          "en": "No!? I-I\u0027m just wondering why\nyou\u0027re accepting this so easily..."
        }
      },
      "2072370017": {
        "text": "\u30D5\u30A3\u30EA\u30B9",
        "localizations": {
          "en": "Firis"
        }
      }
    }
  },
  {
    "id": 21,
    "properties": {
      "999008199": {
        "text": "\u3042\u3041\u3001\u305D\u3046\u3044\u3046\u3053\u3068\uFF1F\n\u3082\u3046\u30A2\u30BF\u30B7\u304C\u6E80\u8DB3\u3057\u3061\u3083\u3063\u305F\u304B\u3089\u3088",
        "localizations": {
          "en": "Oh, is that what this is about?\nI\u0027m just satisfied now, that\u0027s all."
        }
      },
      "2072370017": {
        "text": "\u30A4\u30EB\u30E1\u30EA\u30A2",
        "localizations": {
          "en": "Ilmeria"
        }
      }
    }
  },
  {
    "id": 22,
    "properties": {
      "999008199": {
        "text": "\u6E80\u8DB3\u2026\u2026\uFF1F",
        "localizations": {
          "en": "Satisfied...?"
        }
      },
      "2072370017": {
        "text": "\u30D5\u30A3\u30EA\u30B9",
        "localizations": {
          "en": "Firis"
        }
      }
    }
  },
  {
    "id": 23,
    "properties": {
      "999008199": {
        "text": "\u5143\u3005\u306D\u3001\u3053\u3063\u3061\u306E\u4E16\u754C\u3067\u30D5\u30A3\u30EA\u30B9\u306E\u540D\u58F0\u304C\u9AD8\u3044\u306E\u306F\n\u3059\u3067\u306B\u77E5\u3063\u3066\u305F\u306E\u3002\u3060\u304B\u3089\u5F35\u308A\u5408\u304A\u3046\u3068\u601D\u3063\u3066\u305F\u2026\u2026",
        "localizations": {
          "en": "You know, I already knew you were famous in this world.\nThat\u0027s why I wanted to compete with you..."
        }
      },
      "2072370017": {
        "text": "\u30A4\u30EB\u30E1\u30EA\u30A2",
        "localizations": {
          "en": "Ilmeria"
        }
      }
    }
  },
  {
    "id": 24,
    "properties": {
      "999008199": {
        "text": "\u5F35\u308A\u5408\u3063\u3066\u3001\u30D5\u30A3\u30EA\u30B9\u3088\u308A\u30A2\u30BF\u30B7\u306E\u307B\u3046\u304C\u3059\u3054\u3044\u3093\u3060\uFF01\n\u3063\u3066\u3068\u3053\u308D\u3092\u3001\u307F\u3093\u306A\u306B\u8A3C\u660E\u3057\u3066\u307F\u305B\u305F\u304B\u3063\u305F\u306E",
        "localizations": {
          "en": "I wanted to compete and prove to everyone\nthat I was better than Firis!"
        }
      },
      "2072370017": {
        "text": "\u30A4\u30EB\u30E1\u30EA\u30A2",
        "localizations": {
          "en": "Ilmeria"
        }
      }
    }
  },
  {
    "id": 25,
    "properties": {
      "999008199": {
        "text": "\u3060\u3051\u3069\u3042\u308B\u7A0B\u5EA6\u30A2\u30BF\u30B7\u306E\u3059\u3054\u3055\u306F\u898B\u305B\u3064\u3051\u3089\u308C\u305F\u3057\u3001\n\u305D\u308C\u306B\u30A2\u30BF\u30B7\u4EE5\u5916\u306B\u3082\u5929\u624D\u306F\u3044\u3066\u3082\u3044\u3044\u3063\u3066\u601D\u3063\u305F\u306E",
        "localizations": {
          "en": "But I\u0027ve shown off my skills enough,\nand I realized it\u0027s okay for there to be other geniuses besides me."
        }
      },
      "2072370017": {
        "text": "\u30A4\u30EB\u30E1\u30EA\u30A2",
        "localizations": {
          "en": "Ilmeria"
        }
      }
    }
  },
  {
    "id": 26,
    "properties": {
      "999008199": {
        "text": "\u30A4\u30EB\u3061\u3083\u3093\u2026\u2026",
        "localizations": {
          "en": "Ilmie..."
        }
      },
      "2072370017": {
        "text": "\u30D5\u30A3\u30EA\u30B9",
        "localizations": {
          "en": "Firis"
        }
      }
    }
  },
  {
    "id": 27,
    "properties": {
      "999008199": {
        "text": "\u8003\u3048\u3066\u307F\u308C\u3070\u3053\u306E\u4E16\u754C\u306F\u8272\u3005\u306A\u3068\u3053\u308D\u304B\u3089\n\u3059\u3054\u3044\u932C\u91D1\u8853\u58EB\u305F\u3061\u304C\u305F\u304F\u3055\u3093\u96C6\u307E\u3063\u3066\u6765\u3066\u308B\u3093\u3060\u3082\u306E",
        "localizations": {
          "en": "When you think about it, this world has amazing alchemists\ngathered from all sorts of places."
        }
      },
      "2072370017": {
        "text": "\u30A4\u30EB\u30E1\u30EA\u30A2",
        "localizations": {
          "en": "Ilmeria"
        }
      }
    }
  },
  {
    "id": 28,
    "properties": {
      "999008199": {
        "text": "\u305D\u306E\u4EBA\u305F\u3061\u3092\u8A8D\u3081\u305F\u304F\u306A\u3044\uFF01\u3000\u306A\u3093\u3066\u3001\n\u771F\u306E\u5929\u624D\u932C\u91D1\u8853\u58EB\u304C\u601D\u3046\u3053\u3068\u306A\u3093\u304B\u3058\u3083\u306A\u3044\u308F",
        "localizations": {
          "en": "Refusing to acknowledge them...\nThat\u0027s not how a true genius alchemist should think."
        }
      },
      "2072370017": {
        "text": "\u30A4\u30EB\u30E1\u30EA\u30A2",
        "localizations": {
          "en": "Ilmeria"
        }
      }
    }
  },
  {
    "id": 29,
    "properties": {
      "999008199": {
        "text": "\u3060\u304B\u3089\u3082\u3046\u7D9A\u3051\u308B\u610F\u5473\u3082\u306A\u3044\u304B\u306A\u3063\u3066\u3002\n\u305D\u3046\u3044\u3046\u308F\u3051\u3067\u3001\u3042\u3063\u3055\u308A\u4E86\u627F\u3057\u305F\u306E\u3088",
        "localizations": {
          "en": "So there\u0027s no point in continuing anymore.\nThat\u0027s why I accepted it so easily."
        }
      },
      "2072370017": {
        "text": "\u30A4\u30EB\u30E1\u30EA\u30A2",
        "localizations": {
          "en": "Ilmeria"
        }
      }
    }
  },
  {
    "id": 30,
    "properties": {
      "999008199": {
        "text": "\u305D\u3046\u3060\u3063\u305F\u3093\u3060\u2026\u2026",
        "localizations": {
          "en": "I see..."
        }
      },
      "2072370017": {
        "text": "\u30D5\u30A3\u30EA\u30B9",
        "localizations": {
          "en": "Firis"
        }
      }
    }
  },
  {
    "id": 31,
    "properties": {
      "999008199": {
        "text": "\u305D\u308C\u306B\u4ECA\u56DE\u8272\u3093\u306A\u4EBA\u306B\u30A2\u30BF\u30B7\u306E\u3053\u3068\u3092\u898B\u3066\u3082\u3089\u3063\u305F\u3051\u3069\n\u5225\u306B\u8AB0\u306B\u3069\u3046\u898B\u3089\u308C\u305F\u3063\u3066\u3069\u3046\u3067\u3082\u3044\u3044\u3063\u3066\u6C17\u4ED8\u3044\u305F\u306E",
        "localizations": {
          "en": "Besides, even though lots of people have seen what I can do,\nI realized I don\u0027t really care what most people think of me."
        }
      },
      "2072370017": {
        "text": "\u30A4\u30EB\u30E1\u30EA\u30A2",
        "localizations": {
          "en": "Ilmeria"
        }
      }
    }
  },
  {
    "id": 32,
    "properties": {
      "999008199": {
        "text": "\u8AB0\u304B\u3055\u3093\u306B\u3069\u3046\u898B\u3089\u308C\u3066\u308B\u304B\u306B\u6BD4\u3079\u305F\u3089\u3001\n\u6848\u5916\u3069\u3046\u3067\u3082\u3044\u3044\u3093\u3060\u3063\u3066\u3001\u306D\uFF1F",
        "localizations": {
          "en": "Compared to how a certain someone sees me,\neveryone else\u0027s opinion doesn\u0027t matter much, right?"
        }
      },
      "2072370017": {
        "text": "\u30A4\u30EB\u30E1\u30EA\u30A2",
        "localizations": {
          "en": "Ilmeria"
        }
      }
    }
  },
  {
    "id": 33,
    "properties": {
      "999008199": {
        "text": "\u3060\u304B\u3089\u2026\u2026\u305D\u306E\u2026\u2026\u3002\n\u3053\u308C\u304B\u3089\u3082\u3001\u8CA0\u3051\u306A\u3044\u308F\u3088\uFF01\u3000\u30D5\u30A3\u30EA\u30B9\uFF01",
        "localizations": {
          "en": "So... um...\nI won\u0027t lose to you! Firis!"
        }
      },
      "2072370017": {
        "text": "\u30A4\u30EB\u30E1\u30EA\u30A2",
        "localizations": {
          "en": "Ilmeria"
        }
      }
    }
  },
  {
    "id": 34,
    "properties": {
      "999008199": {
        "text": "\u3046\u3063\u3001\u3046\u3093\uFF01\n\u306A\u3093\u304B\u3088\u304F\u5206\u304B\u3089\u306A\u3044\u3051\u3069\u3001\u308F\u305F\u3057\u3082\u8CA0\u3051\u306A\u3044\u3088\uFF01",
        "localizations": {
          "en": "U-Um, okay!\nI don\u0027t really get it, but I won\u0027t lose either!"
        }
      },
      "2072370017": {
        "text": "\u30D5\u30A3\u30EA\u30B9",
        "localizations": {
          "en": "Firis"
        }
      }
    }
  },
  {
    "id": 35,
    "properties": {
      "999008199": {
        "text": "\u306A\u3093\u3067\u3088\u304F\u5206\u304B\u3089\u306A\u3044\u306E\u3088\uFF01\n\u3042\u3093\u306A\u306B\u30CF\u30C3\u30AD\u30EA\u8A00\u3063\u305F\u306E\u306B\uFF01",
        "localizations": {
          "en": "What do you mean you don\u0027t get it!\nI spelled it out so clearly!"
        }
      },
      "2072370017": {
        "text": "\u30A4\u30EB\u30E1\u30EA\u30A2",
        "localizations": {
          "en": "Ilmeria"
        }
      }
    }
  },
  {
    "id": 36,
    "properties": {
      "999008199": {
        "text": "\u3048\u3047\uFF01\uFF1F\u3000\u308F\u305F\u3057\u3001\u4F55\u304B\u4F1D\u3048\u3089\u308C\u3066\u305F\u306E\uFF01\uFF1F",
        "localizations": {
          "en": "Eh!? Was I supposed to understand something!?"
        }
      },
      "2072370017": {
        "text": "\u30D5\u30A3\u30EA\u30B9",
        "localizations": {
          "en": "Firis"
        }
      }
    }
  },
  {
    "id": 37,
    "properties": {
      "999008199": {
        "text": "\u3053\u306E\u5B50\u3063\u305F\u3089\u2026\u2026\uFF01\u3000\u3082\uFF5E\uFF5E\uFF5E\uFF5E\uFF01\n\u3069\u3046\u3057\u3066\u305D\u3093\u306A\u306B\u920D\u611F\u306A\u306E\u3088\uFF01",
        "localizations": {
          "en": "This girl...! Geez!\nWhy are you so dense!?"
        }
      },
      "2072370017": {
        "text": "\u30A4\u30EB\u30E1\u30EA\u30A2",
        "localizations": {
          "en": "Ilmeria"
        }
      }
    }
  },
  {
    "id": 38,
    "properties": {
      "999008199": {
        "text": "\u3054\u3001\u3054\u3081\u3093\u306A\u3055\u3044\uFF5E\uFF01\uFF1F",
        "localizations": {
          "en": "I-I\u0027m sorry~!?"
        }
      },
      "2072370017": {
        "text": "\u30D5\u30A3\u30EA\u30B9",
        "localizations": {
          "en": "Firis"
        }
      }
    }
  },
  {
    "id": 39,
    "properties": {
      "999008199": {
        "text": "\u2026\u2026\u306D\u3047",
        "localizations": {
          "en": "...Hey"
        }
      },
      "2072370017": {
        "text": "\u30CF\u30A4\u30C7\u30A3",
        "localizations": {
          "en": "Heidi"
        }
      }
    }
  },
  {
    "id": 40,
    "properties": {
      "999008199": {
        "text": "\u2026\u2026\u3069\u3046\u3057\u305F",
        "localizations": {
          "en": "...What is it?"
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 41,
    "properties": {
      "999008199": {
        "text": "\u3053\u306E\u3053\u3068\u306F\u3001\u79C1\u305F\u3061\u3060\u3051\u306E\u79D8\u5BC6\u306B\u3057\u3066\u304A\u3053\u3046\u304B",
        "localizations": {
          "en": "Let\u0027s keep this our little secret."
        }
      },
      "2072370017": {
        "text": "\u30CF\u30A4\u30C7\u30A3",
        "localizations": {
          "en": "Heidi"
        }
      }
    }
  },
  {
    "id": 42,
    "properties": {
      "999008199": {
        "text": "\u305D\u3046\u3060\u306A\u2026\u2026",
        "localizations": {
          "en": "Agreed..."
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  }
]