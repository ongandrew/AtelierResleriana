[
  {
    "id": 0,
    "properties": {
      "999008199": {
        "text": "\u307F\u3093\u306A\u3001\u6B4C\u59EB\u30C7\u30A3\u30AA\u30FC\u30CA\u306E\u6B4C\u306F\u6700\u9AD8\u3060\u3063\u305F\u306A\uFF01\n\u4ECA\u5BB5\u306F\u305D\u306E\u4F59\u97FB\u3092\u80B4\u306B\u5BB4\u3092\u697D\u3057\u3082\u3046\u3067\u306F\u306A\u3044\u304B\uFF01",
        "localizations": {
          "en": "Everyone, wasn\u0027t Diona\u0027s singing amazing tonight? Let\u0027s keep the festivities going and enjoy the afterglow!"
        }
      },
      "2072370017": {
        "text": "\u30ED\u30DE\u30F3",
        "localizations": {
          "en": "Roman"
        }
      }
    }
  },
  {
    "id": 1,
    "properties": {
      "999008199": {
        "text": "\u30AB\u30D5\u30A7\u306F\u3053\u306E\u30ED\u30DE\u30F3\u304C\u8CB8\u3057\u5207\u3063\u305F\uFF01\n\u305D\u3057\u3066\u2026\u2026",
        "localizations": {
          "en": "I\u0027ve rented out the entire cafe for us! And..."
        }
      },
      "2072370017": {
        "text": "\u30ED\u30DE\u30F3",
        "localizations": {
          "en": "Roman"
        }
      }
    }
  },
  {
    "id": 2,
    "properties": {
      "999008199": {
        "text": "\u4ECA\u5BB5\u306E\u4E3B\u5F79\u3001\u30E6\u30CA\u3082\u3082\u3061\u308D\u3093\u547C\u3093\u3067\u3044\u308B\uFF01\n\u7686\u601D\u3046\u5B58\u5206\u697D\u3057\u3093\u3067\u304F\u308C\uFF01",
        "localizations": {
          "en": "Of course, I\u0027ve invited tonight\u0027s guest of honor, Juna! Everyone, please enjoy yourselves to the fullest!"
        }
      },
      "2072370017": {
        "text": "\u30ED\u30DE\u30F3",
        "localizations": {
          "en": "Roman"
        }
      }
    }
  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "\u305D\u308C\u3067\u306F\u2026\u2026\u661F\u8A95\u796D\u306B\u5E78\u3042\u308C\uFF01\u3000\u4E7E\u676F\uFF01",
        "localizations": {
          "en": "Now then... to the Starbirth Festival! Cheers!"
        }
      },
      "2072370017": {
        "text": "\u30ED\u30DE\u30F3",
        "localizations": {
          "en": "Roman"
        }
      }
    }
  },
  {
    "id": 4,
    "properties": {
      "999008199": {
        "text": "\u4E7E\u676F\uFF01",
        "localizations": {
          "en": "Cheers!"
        }
      },
      "2072370017": {
        "text": "\u307F\u3093\u306A",
        "localizations": {
          "en": "Everyone"
        }
      }
    }
  },
  {
    "id": 5,
    "properties": {
      "999008199": {
        "text": "\u3044\u3084\u3042\u3001\u4FFA\u4ECA\u307E\u3067\u30E6\u30CA\u3055\u3093\u306B\u3064\u3044\u3066\u8AA4\u89E3\u3057\u3066\u305F\u3088\uFF01\n\u3082\u3063\u3068\u56FA\u3044\u4EBA\u306A\u3093\u3060\u308D\u3046\u306A\u3068\u601D\u3063\u3066\u305F\u3093\u3060",
        "localizations": {
          "en": "You know, I totally had the wrong idea about Lady Juna! I thought she\u0027d be way more uptight!"
        }
      },
      "2072370017": {
        "text": "\u7537\u6027",
        "localizations": {
          "en": "Man"
        }
      }
    }
  },
  {
    "id": 6,
    "properties": {
      "999008199": {
        "text": "\u3067\u3082\u3001\u5BB6\u65CF\u304C\u4E00\u756A\u5927\u4E8B\u3060\u3063\u305F\u308A\u2026\u2026\n\u79C1\u305F\u3061\u3068\u540C\u3058\u306A\u3093\u3060\u306D\uFF01",
        "localizations": {
          "en": "But she values family above all else... She\u0027s just like us!"
        }
      },
      "2072370017": {
        "text": "\u5973\u6027\uFF11",
        "localizations": {
          "en": "Woman 1"
        }
      }
    }
  },
  {
    "id": 7,
    "properties": {
      "999008199": {
        "text": "\u3042\u3001\u3042\u3042\u3002\u79C1\u306F\u305D\u3093\u306A\u5927\u305D\u308C\u305F\u4EBA\u9593\u3067\u306F\u306A\u3044\u304B\u3089\u306A",
        "localizations": {
          "en": "Ah, well... I\u0027m really not anyone special..."
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 8,
    "properties": {
      "999008199": {
        "text": "\u306D\u3048\u306D\u3048\uFF01\u3000\u5BDD\u5DFB\u3063\u3066\u3069\u3093\u306A\u306E\u7740\u3066\u308B\u306E\uFF1F",
        "localizations": {
          "en": "Hey, hey! What kind of pajamas do you wear?"
        }
      },
      "2072370017": {
        "text": "\u5973\u306E\u5B501",
        "localizations": {
          "en": "Girl 1"
        }
      }
    }
  },
  {
    "id": 9,
    "properties": {
      "999008199": {
        "text": "\u898B\u305F\u3044\u898B\u305F\u3044\uFF01\u3000\u304B\u308F\u3044\u3044\u5BDD\u5DFB\uFF01",
        "localizations": {
          "en": "We wanna see! Show us your cute pajamas!"
        }
      },
      "2072370017": {
        "text": "\u5973\u306E\u5B502",
        "localizations": {
          "en": "Girl 2"
        }
      }
    }
  },
  {
    "id": 10,
    "properties": {
      "999008199": {
        "text": "\u305D\u3001\u305D\u308C\u306F\u30C0\u30E1\u3060\uFF01\u3000\u305D\u308C\u306B\u304B\u308F\u3044\u3044\u3082\u306E\u3067\u306F\u306A\u3044\uFF01",
        "localizations": {
          "en": "N-No, absolutely not! And they\u0027re not cute at all!"
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 11,
    "properties": {
      "999008199": {
        "text": "\u3048\u30FC\u3002\u3058\u3083\u3042\u3001\u4ECA\u5EA6\u591C\u660E\u3051\u306E\u935B\u932C\u3053\u3063\u305D\u308A\u898B\u306B\u884C\u304F\u306D",
        "localizations": {
          "en": "Aww... Then we\u0027ll just have to sneak a peek at your dawn training session!"
        }
      },
      "2072370017": {
        "text": "\u5973\u306E\u5B50\uFF11",
        "localizations": {
          "en": "Girl 1"
        }
      }
    }
  },
  {
    "id": 12,
    "properties": {
      "999008199": {
        "text": "\u306C\u3046\u3046\u3046\u3063\u2026\u2026\uFF01",
        "localizations": {
          "en": "Nnngh...!"
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 13,
    "properties": {
      "999008199": {
        "text": "\u767D\u591C\u306E\u9A0E\u58EB\u3082\u5F62\u7121\u3057\u3060\u306A\u3001\u3042\u308A\u3083",
        "localizations": {
          "en": "Look at that, the Knight of the Midnight Sun\u0027s reputation in shambles!"
        }
      },
      "2072370017": {
        "text": "\u30DE\u30AF\u30C0",
        "localizations": {
          "en": "Magda"
        }
      }
    }
  },
  {
    "id": 14,
    "properties": {
      "999008199": {
        "text": "\u3044\u30FC\u3093\u3058\u3083\u306A\u3044\uFF1F\n\u307F\u3093\u306A\u63A5\u3057\u3084\u3059\u304F\u306A\u3063\u305F\u3068\u3044\u3046\u3053\u3068\u3067\u3055",
        "localizations": {
          "en": "It\u0027s not so bad, right? Everyone\u0027s just getting more comfortable around her."
        }
      },
      "2072370017": {
        "text": "\u30DF\u30FC\u30B1",
        "localizations": {
          "en": "Mieke"
        }
      }
    }
  },
  {
    "id": 15,
    "properties": {
      "999008199": {
        "text": "\u767D\u591C\u306E\u9A0E\u58EB\u306E\u5A01\u53B3\u306F\u3001\u5927\u4E8B\u306A\u3082\u306E\u3067\u306F\u3042\u308B\u304C\n\u5F7C\u5973\u306E\u6027\u683C\u3092\u8003\u3048\u308C\u3070",
        "localizations": {
          "en": "While the dignity of the Knight of the Midnight Sun is important, considering her personality..."
        }
      },
      "2072370017": {
        "text": "\u30D6\u30E9\u30C3\u30C9",
        "localizations": {
          "en": "Brad"
        }
      }
    }
  },
  {
    "id": 16,
    "properties": {
      "999008199": {
        "text": "\u307E\u3042\u3001\u5C11\u3057\u304F\u3089\u3044\u9699\u304C\u3042\u3063\u305F\u65B9\u304C\u3044\u3044\u3060\u308D\u3046\n\u3082\u3046\u5C11\u3057\u81EA\u7136\u4F53\u3067\u3044\u308C\u305F\u65B9\u304C\u3001\u75B2\u308C\u307E\u3044",
        "localizations": {
          "en": "Well, having a few vulnerable moments might be good for her. Being more natural could help prevent exhaustion."
        }
      },
      "2072370017": {
        "text": "\u30D6\u30E9\u30C3\u30C9",
        "localizations": {
          "en": "Brad"
        }
      }
    }
  },
  {
    "id": 17,
    "properties": {
      "999008199": {
        "text": "\uFF08\u305D\u3046\u3067\u306A\u3044\u3068\u3001\u304D\u3063\u3068\u30E4\u30B9\u30DF\u30FC\u30F3\u6BBF\u306E\u3088\u3046\u306B\n\u3000\u5B64\u72EC\u306B\u306A\u3063\u3066\u3057\u307E\u3046\u306E\u3060\u308D\u3046\uFF09",
        "localizations": {
          "en": "(Otherwise, she might end up alone like Lord Yasmine...)"
        }
      },
      "2072370017": {
        "text": "\u30D6\u30E9\u30C3\u30C9",
        "localizations": {
          "en": "Brad"
        }
      }
    }
  },
  {
    "id": 18,
    "properties": {
      "999008199": {
        "text": "\u305D\u3046\u3044\u3084\u3001\u3042\u3063\u3061\u306E\u4EBA\u3060\u304B\u308A\u306F\u306A\u3093\u3060\uFF1F\n\u6EC5\u8336\u82E6\u8336\u76DB\u308A\u4E0A\u304C\u3063\u3066\u308B\u307F\u305F\u3044\u3060\u304C",
        "localizations": {
          "en": "By the way, what\u0027s with that crowd over there? They seem pretty worked up."
        }
      },
      "2072370017": {
        "text": "\u30DE\u30AF\u30C0",
        "localizations": {
          "en": "Magda"
        }
      }
    }
  },
  {
    "id": 19,
    "properties": {
      "999008199": {
        "text": "\u3042\u3042\u3001\u3042\u3061\u3089\u306B\u306F\u30E6\u30CA\u306E\u3054\u5BB6\u65CF\u304C\u3044\u308B\u3093\u3060\u3002\n\u30E6\u30CA\u304C\u30AB\u30D5\u30A7\u306B\u9023\u308C\u3066\u304D\u305F\u3093\u3060\u3088",
        "localizations": {
          "en": "Ah, that\u0027s where Juna\u0027s family is. She brought them to the cafe."
        }
      },
      "2072370017": {
        "text": "\u30ED\u30DE\u30F3",
        "localizations": {
          "en": "Roman"
        }
      }
    }
  },
  {
    "id": 20,
    "properties": {
      "999008199": {
        "text": "\u304D\u3063\u3068\u307F\u3093\u306A\u30E6\u30CA\u306B\u3064\u3044\u3066\u805E\u3044\u3066\u308B\u3093\u3060\u308D\u3046",
        "localizations": {
          "en": "I bet everyone\u0027s asking them about Juna."
        }
      },
      "2072370017": {
        "text": "\u30ED\u30DE\u30F3",
        "localizations": {
          "en": "Roman"
        }
      }
    }
  },
  {
    "id": 21,
    "properties": {
      "999008199": {
        "text": "\u306D\u3048\u30E6\u30CA\u3055\u3093\uFF01\u3000\u304B\u308F\u3044\u3044\u3082\u306E\u304C\u597D\u304D\u3063\u3066\u672C\u5F53\uFF1F",
        "localizations": {
          "en": "Hey Juna! Is it true you like cute things?"
        }
      },
      "2072370017": {
        "text": "\u5973\u6027\uFF11",
        "localizations": {
          "en": "Woman 1"
        }
      }
    }
  },
  {
    "id": 22,
    "properties": {
      "999008199": {
        "text": "\u306A\u3063\u2026\u2026\uFF01\uFF1F\u3000\u3069\u3053\u3067\u305D\u306E\u8A71\u3092\uFF01\uFF1F",
        "localizations": {
          "en": "Wha...!? Where did you hear that!?"
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 23,
    "properties": {
      "999008199": {
        "text": "\u3055\u3063\u304D\u30E6\u30CA\u3055\u3093\u306E\u304A\u6BCD\u69D8\u304C\u8A71\u3057\u3066\u305F\u306E\uFF01\n\u5C0F\u3055\u3044\u3053\u308D\u304B\u3089\u304B\u308F\u3044\u3044\u3082\u306E\u3068\u7518\u3044\u3082\u306E\u304C\u597D\u304D\u3060\u3063\u3066\uFF01",
        "localizations": {
          "en": "Your mother just told us! She said you\u0027ve loved cute things and sweets since you were little!"
        }
      },
      "2072370017": {
        "text": "\u5973\u6027\uFF12",
        "localizations": {
          "en": "Woman 2"
        }
      }
    }
  },
  {
    "id": 24,
    "properties": {
      "999008199": {
        "text": "\u306F\u3001\u6BCD\u4E0A\u3048\u3048\u3048\uFF01",
        "localizations": {
          "en": "M-Mother, whyyyy!"
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 25,
    "properties": {
      "999008199": {
        "text": "\u3042\u3063\u306F\u3063\u306F\uFF01\u3000\u9A0E\u58EB\u304C\u304A\u308D\u304A\u308D\u3057\u3066\u308B\u306E\u3092\u898B\u308B\u306E\u306F\n\u9762\u767D\u3044\u306D\u3048\uFF01",
        "localizations": {
          "en": "Hahaha! It\u0027s hilarious seeing a knight getting all flustered!"
        }
      },
      "2072370017": {
        "text": "\u30DE\u30AF\u30C0",
        "localizations": {
          "en": "Magda"
        }
      }
    }
  },
  {
    "id": 26,
    "properties": {
      "999008199": {
        "text": "\u3044\u30FC\u3058\u3083\u3093\u3002\u7686\u304B\u3089\u597D\u304B\u308C\u308B\u306E\u3082\u82F1\u96C4\u3063\u3066\u3053\u3068\u3060\u306D\u3047",
        "localizations": {
          "en": "It\u0027s all good! Being loved by everyone is part of being a hero, y\u0027know?"
        }
      },
      "2072370017": {
        "text": "\u30DF\u30FC\u30B1",
        "localizations": {
          "en": "Mieke"
        }
      }
    }
  },
  {
    "id": 27,
    "properties": {
      "999008199": {
        "text": "\u3046\u308F\u3042\u3042\u3042\uFF01\u3000\u3082\u3046\u6BBA\u3057\u3066\u304F\u308C\u30FC\uFF01\uFF01\uFF01",
        "localizations": {
          "en": "Aaagh! Someone just end me now!!!"
        }
      },
      "2072370017": {
        "text": "\u30E6\u30CA",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  }
]