      "2072370017": {
        "text": "\u30D7\u30E9\u30D5\u30BF",
        "localizations": {
          "en": "Plachta"
        }
      }
    }
  },
  {
    "id": 32,
    "properties": {
      "999008199": {
        "text": "\u3046\u3093\u3001\u3042\u305F\u3057\u3082\u305D\u3046\u601D\u3046\uFF01",
        "localizations": {
          "en": "Yeah, I think so too!"
        }
      },
      "2072370017": {
        "text": "\u30BD\u30D5\u30A3\u30FC",
        "localizations": {
          "en": "Sophie"
        }
      }
    }
  },
  {
    "id": 33,
    "properties": {
      "999008199": {
