[
  {
    "id": 0,
    "properties": {
      "999008199": {
        "text": "\u3075\u3045\u3002\u3069\u306E\u30C1\u30E7\u30B3\u3082\u7F8E\u5473\u3057\u304B\u3063\u305F\u306A\u30FC",
        "localizations": {
          "en": "Phew... All the chocolates were delicious!"
        }
      },
      "2072370017": {
        "text": "\u30BD\u30D5\u30A3\u30FC",
        "localizations": {
          "en": "Sophie"
        }
      }
    }
  },
  {
    "id": 1,
    "properties": {
      "999008199": {
        "text": "\u3069\u308C\u3082\u500B\u6027\u7684\u3067\u7D20\u6674\u3089\u3057\u304B\u3063\u305F\u3067\u3059\u306D\u3002\n\u5473\u3082\u826F\u3044\u3082\u306E\u3070\u304B\u308A\u3067\u3057\u305F\u3057",
        "localizations": {
          "en": "They were all wonderfully unique, weren\u0027t they? And each one tasted fantastic."
        }
      },
      "2072370017": {
        "text": "\u30D7\u30E9\u30D5\u30BF",
        "localizations": {
          "en": "Plachta"
        }
      }
    }
  },
  {
    "id": 2,
    "properties": {
      "999008199": {
        "text": "\u3060\u306D\u3002\u5473\u3060\u3051\u3058\u3083\u306A\u304F\u3066\u3001\n\u898B\u305F\u76EE\u3068\u304B\u4F5C\u308A\u65B9\u3082\u5DE5\u592B\u3055\u308C\u3066\u3066\u3001\u9762\u767D\u304B\u3063\u305F\uFF01",
        "localizations": {
          "en": "Yeah! Not just the taste, but the appearances and techniques used were really interesting too!"
        }
      },
      "2072370017": {
        "text": "\u30BD\u30D5\u30A3\u30FC",
        "localizations": {
          "en": "Sophie"
        }
      }
    }
  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "\u30C1\u30E7\u30B3\u3063\u3066\u3053\u3093\u306A\u306B\u5965\u304C\u6DF1\u3044\u3093\u3060\u306A\u3041\u3063\u3066\u3001\n\u6539\u3081\u3066\u6C17\u4ED8\u304B\u3055\u308C\u3061\u3083\u3063\u305F\u3088",
        "localizations": {
          "en": "I never realized chocolate could be so complex!"
        }
      },
      "2072370017": {
        "text": "\u30BD\u30D5\u30A3\u30FC",
        "localizations": {
          "en": "Sophie"
        }
      }
    }
  },
  {
    "id": 4,
    "properties": {
      "999008199": {
        "text": "\u3069\u3046\u3067\u3057\u3087\u3046\u304B\u3001\u30BD\u30D5\u30A3\u30FC\u3002\n\u4F5C\u308A\u305F\u3044\u30C1\u30E7\u30B3\u306F\u6C7A\u307E\u3063\u3066\u304D\u307E\u3057\u305F\u304B\uFF1F",
        "localizations": {
          "en": "What do you think, Sophie? Have you decided what kind of chocolate you want to make?"
        }
      },
      "2072370017": {
        "text": "\u30D7\u30E9\u30D5\u30BF",
        "localizations": {
          "en": "Plachta"
        }
      }
    }
  },
  {
    "id": 5,
    "properties": {
      "999008199": {
        "text": "\u3046\u30FC\u3093\u2026\u2026\u305D\u308C\u304C\u306D\u3002\n\u306A\u3093\u3060\u304B\u9006\u306B\u3001\u5206\u304B\u3089\u306A\u304F\u306A\u3063\u3066\u304D\u3061\u3083\u3063\u305F\u3093\u3060\u3088\u306D",
        "localizations": {
          "en": "Hmm... actually... If anything, I\u0027m even more confused now."
        }
      },
      "2072370017": {
        "text": "\u30BD\u30D5\u30A3\u30FC",
        "localizations": {
          "en": "Sophie"
        }
      }
    }
  },
  {
    "id": 6,
    "properties": {
      "999008199": {
        "text": "\u3075\u3080\u2026\u2026\u3068\u8A00\u3046\u3068\u2026\u2026",
        "localizations": {
          "en": "Hmm... what do you mean...?"
        }
      },
      "2072370017": {
        "text": "\u30D7\u30E9\u30D5\u30BF",
        "localizations": {
          "en": "Plachta"
        }
      }
    }
  },
  {
    "id": 7,
    "properties": {
      "999008199": {
        "text": "\u500B\u6027\u8C4A\u304B\u306A\u30C1\u30E7\u30B3\u3092\u898B\u3059\u304E\u3066\u3057\u307E\u3063\u305F\u305F\u3081\u306B\u3001\n\u8EF8\u304C\u5B9A\u307E\u3089\u306A\u304F\u306A\u3063\u305F\u3001\u3068\u304B\u3067\u3057\u3087\u3046\u304B\uFF1F",
        "localizations": {
          "en": "Perhaps seeing so many unique chocolates has made it harder to settle on a direction?"
        }
      },
      "2072370017": {
        "text": "\u30D7\u30E9\u30D5\u30BF",
        "localizations": {
          "en": "Plachta"
        }
      }
    }
  },
  {
    "id": 8,
    "properties": {
      "999008199": {
        "text": "\u3042\u3001\u305D\u3046\uFF01\u3000\u305D\u3093\u306A\u611F\u3058\uFF01",
        "localizations": {
          "en": "Ah, yes! That\u0027s exactly it!"
        }
      },
      "2072370017": {
        "text": "\u30BD\u30D5\u30A3\u30FC",
        "localizations": {
          "en": "Sophie"
        }
      }
    }
  },
  {
    "id": 9,
    "properties": {
      "999008199": {
        "text": "\u306A\u308B\u307B\u3069\u3002\u3067\u3057\u305F\u3089\u5206\u304B\u308A\u307E\u3059\u3002\n\u5B9F\u306F\u3001\u79C1\u3082\u540C\u3058\u306A\u306E\u3067\u2026\u2026",
        "localizations": {
          "en": "I see. I understand completely. Actually, I\u0027m feeling the same way..."
        }
      },
      "2072370017": {
        "text": "\u30D7\u30E9\u30D5\u30BF",
        "localizations": {
          "en": "Plachta"
        }
      }
    }
  },
  {
    "id": 10,
    "properties": {
      "999008199": {
        "text": "\u305D\u3063\u304B\u3001\u30D7\u30E9\u30D5\u30BF\u3082\u306A\u3093\u3060\u3002\n\u3069\u3046\u3057\u305F\u3089\u3044\u3044\u3093\u3060\u308D\u3046\u306D\uFF1F",
        "localizations": {
          "en": "Oh, you too, Plachta? What should we do?"
        }
