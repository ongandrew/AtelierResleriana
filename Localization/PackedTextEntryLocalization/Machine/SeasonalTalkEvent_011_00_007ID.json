[
  {
    "id": 0,
    "properties": {
      "999008199": {
        "text": "\u3046\u30FC\u3093\u3002\n\u30C1\u30E7\u30B3\u306B\u3069\u3093\u306A\u60F3\u3044\u3092\u8FBC\u3081\u305F\u3044\u304B\u3001\u304B\u3041\u2026\u2026",
        "localizations": {
          "en": "Hmm... What feelings should I put into this chocolate..."
