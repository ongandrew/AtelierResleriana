  },
  {
    "id": 2,
    "properties": {
      "999008199": {
        "text": "\u3042\u308C\uFF1F\u3000\u30DE\u30AF\u30C0\u3055\u3093\uFF01",
        "localizations": {
          "en": "Oh? Magda!"
