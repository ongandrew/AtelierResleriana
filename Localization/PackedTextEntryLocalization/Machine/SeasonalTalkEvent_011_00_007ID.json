      "2072370017": {
        "text": "\u30DE\u30AF\u30C0",
        "localizations": {
          "en": "Magda"
        }
      }
    }
  },
  {
    "id": 15,
    "properties": {
      "999008199": {
        "text": "\u3048\uFF1F\u3000\u3060\u3063\u3066\u3001\u30EA\u30F3\u30C7\u796D\u306E\u30C1\u30E7\u30B3\u3063\u3066\u3001\n\u304A\u4E16\u8A71\u306B\u306A\u3063\u3066\u3044\u308B\u4EBA\u306B\u6E21\u3059\u3082\u306E\u3058\u3083\u306A\u3044\u3067\u3059\u304B",
        "localizations": {
          "en": "Huh? But Linde Festival chocolate is supposed to be\nfor people you\u0027re grateful to, right?"
        }
      },
      "2072370017": {
        "text": "\u30BD\u30D5\u30A3\u30FC",
        "localizations": {
          "en": "Sophie"
        }
      }
    }
  },
  {
    "id": 16,
    "properties": {
      "999008199": {
        "text": "\u30DE\u30AF\u30C0\u3055\u3093\u3001\u3088\u304F\u30D6\u30E9\u30C3\u30C9\u3055\u3093\u3068\u4E00\u7DD2\u306B\u3044\u307E\u3059\u3057\u3002\n\u3042\u3052\u308B\u3068\u3057\u305F\u3089\u30D6\u30E9\u30C3\u30C9\u3055\u3093\u306A\u306E\u304B\u306A\u3063\u3066",
        "localizations": {
          "en": "You\u0027re always with Brad, so I thought\nhe\u0027d be the natural choice."
