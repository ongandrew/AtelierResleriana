      "2072370017": {
        "text": "\u30DE\u30AF\u30C0",
        "localizations": {
          "en": "Magda"
        }
      }
    }
  },
  {
    "id": 20,
    "properties": {
      "999008199": {
        "text": "\u91CD\u8981\u306A\u610F\u5473\uFF1F\n\u305D\u308C\u3063\u3066\u306A\u3093\u3067\u3059\u304B\uFF1F\u3000\u6559\u3048\u3066\u304F\u3060\u3055\u3044\uFF01",
        "localizations": {
