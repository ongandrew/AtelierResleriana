  {
    "id": 18,
    "properties": {
      "999008199": {
        "text": "\u3067\u3082\u304A\u524D\u3001\u3042\u308C\u3060\u305C\uFF01\n\u30EA\u30F3\u30C7\u796D\u306E\u30C1\u30E7\u30B3\u3063\u3064\u3063\u3066\u3082\u3001\u3042\u308C\u3060\u305C\uFF01",
