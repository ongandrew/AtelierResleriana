      }
    }
  },
  {
    "id": 28,
    "properties": {
      "999008199": {
        "text": "\u3042\u3093\u306A\u306B\u614C\u3066\u3066\u3069\u3046\u3057\u305F\u3093\u3060\u308D\u3001\u30DE\u30AF\u30C0\u3055\u3093\uFF1F",
        "localizations": {
          "en": "I wonder why Magda ran off in such a hurry?"
