  {
    "id": 24,
    "properties": {
      "999008199": {
        "text": "\u30D6\u30E9\u30C3\u30C9\u3055\u3093\u3001\u5947\u9047\u3067\u3059\u306D\uFF01\n\u3061\u3087\u3046\u3069\u30D6\u30E9\u30C3\u30C9\u3055\u3093\u306E\u8A71\u3092\u3057\u3066\u3044\u305F\u3068\u3053\u308D\u306A\u3093\u3067\u3059\u3088",
        "localizations": {
          "en": "Brad! What a coincidence!\nWe were just talking about you!"
