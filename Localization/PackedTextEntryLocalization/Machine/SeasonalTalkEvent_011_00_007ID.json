        "text": "\u30BD\u30D5\u30A3\u30FC",
        "localizations": {
          "en": "Sophie"
        }
      }
    }
  },
  {
    "id": 30,
    "properties": {
      "999008199": {
        "text": "\u3080\u3057\u308D\u304A\u524D\u304C\u79C1\u306B\u6E21\u3055\u306A\u304B\u3063\u305F\u3089\u3001\u79C1\u306F\u60B2\u3057\u3044\u305E\u3002\n\u5171\u306B\u884C\u52D5\u3057\u3066\u3044\u308B\u3060\u308D\u3046",
        "localizations": {
          "en": "I\u0027d actually be sad if you didn\u0027t give me any.\nWe do work together, after all."
