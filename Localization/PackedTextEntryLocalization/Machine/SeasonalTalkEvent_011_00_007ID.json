      "2072370017": {
        "text": "\u30BD\u30D5\u30A3\u30FC",
        "localizations": {
          "en": "Sophie"
        }
      }
    }
  },
  {
    "id": 29,
    "properties": {
      "999008199": {
        "text": "\u3082\u3063\u3068\u8A73\u3057\u304F\u805E\u304D\u305F\u304B\u3063\u305F\u3051\u3069\u2026\u2026\u3002\n\u3057\u3087\u3046\u304C\u306A\u3044\u304B\u306A",
        "localizations": {
          "en": "I wanted to ask more questions, but...\nGuess it can\u0027t be helped."
