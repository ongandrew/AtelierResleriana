      "2072370017": {
        "text": "\u30BD\u30D5\u30A3\u30FC",
        "localizations": {
          "en": "Sophie"
        }
      }
    }
  },
  {
    "id": 12,
    "properties": {
      "999008199": {
        "text": "\u3042\u3041\u3001\u30D6\u30E9\u30C3\u30C9\u306B\u306F\u6E21\u3059\u305C\u3002\u3042\u3044\u3064\u306F\u574A\u3061\u3083\u3093\u306A\u3060\u3051\n\u3042\u3063\u3066\u3001\u738B\u90FD\u4E0B\u753A\u306E\u3046\u307E\u3044\u5E97\u3092\u307E\u3060\u307E\u3060\u77E5\u3089\u306A\u3044\u304B\u3089\u306A",
        "localizations": {
          "en": "Yeah, I\u0027m giving some to Brad. That young master still doesn\u0027t\nknow all the good spots in the Lower Quarter."
        }
      },
      "2072370017": {
        "text": "\u30DE\u30AF\u30C0",
        "localizations": {
          "en": "Magda"
        }
      }
    }
  },
  {
    "id": 13,
    "properties": {
      "999008199": {
        "text": "\u305D\u3046\u306A\u3093\u3067\u3059\u306D\u30FC\u3002\n\u4EF2\u3001\u3044\u3044\u3067\u3059\u3082\u3093\u306D",
        "localizations": {
          "en": "I see~\nYou two are pretty close, aren\u0027t you?"
