  },
  {
    "id": 25,
    "properties": {
      "999008199": {
        "text": "\u305D\u3046\u3060\u3063\u305F\u306E\u304B\u3002\n\u4F55\u304B\u8A71\u3067\u3082\u3042\u308B\u306E\u304B\u3001\u30DE\u30AF\u30C0\uFF1F",
        "localizations": {
          "en": "Is that so?\nDid you need something, Magda?"
