      "2072370017": {
        "text": "\u30BD\u30D5\u30A3\u30FC",
        "localizations": {
          "en": "Sophie"
        }
      }
    }
  },
  {
    "id": 8,
    "properties": {
      "999008199": {
        "text": "\u2015\u2015\u306A\u308B\u307B\u3069\u306A\u3002\u3069\u3093\u306A\u30C1\u30E7\u30B3\u3092\u4F5C\u308A\u3083\u3044\u3044\u304B\u3001\n\u5206\u304B\u3089\u306A\u304F\u306A\u3063\u3061\u307E\u3063\u305F\u308F\u3051\u304B",
        "localizations": {
          "en": "I see... So you\u0027re having trouble figuring out\nwhat kind of chocolate to make, huh?"
        }
      },
      "2072370017": {
        "text": "\u30DE\u30AF\u30C0",
        "localizations": {
          "en": "Magda"
        }
      }
    }
  },
  {
    "id": 9,
    "properties": {
      "999008199": {
        "text": "\u305D\u3046\u306A\u3093\u3067\u3059\u3002\u30DE\u30AF\u30C0\u3055\u3093\u306F\u3069\u3046\u601D\u3044\u307E\u3059\u304B\uFF1F",
        "localizations": {
          "en": "That\u0027s right. What do you think, Magda?"
        }
      },
      "2072370017": {
        "text": "\u30BD\u30D5\u30A3\u30FC",
        "localizations": {
          "en": "Sophie"
        }
      }
    }
  },
  {
    "id": 10,
    "properties": {
      "999008199": {
        "text": "\u5FC3\u3092\u8FBC\u3081\u308A\u3083\u305D\u308C\u3067\u3044\u3044\u3093\u3058\u3083\u306D\u3047\u304B\uFF1F\u3000\u3093\uFF5E\u2026\u2026\n\u76F8\u8AC7\u306B\u4E57\u3063\u3068\u3044\u3066\u306A\u3093\u3060\u304C\u6B63\u89E3\u306F\u5206\u304B\u3089\u306D\u3047\u3001\u60AA\u3044",
        "localizations": {
          "en": "Ain\u0027t it fine as long as you put your heart into it? Hmm...\nSorry, but I can\u0027t give you a clear answer here."
        }
      },
      "2072370017": {
        "text": "\u30DE\u30AF\u30C0",
        "localizations": {
          "en": "Magda"
        }
      }
    }
  },
  {
    "id": 11,
    "properties": {
      "999008199": {
        "text": "\u305D\u3046\u3067\u3059\u304B\u2026\u2026\n\u30DE\u30AF\u30C0\u3055\u3093\u306F\u3001\u8AB0\u304B\u306B\u30C1\u30E7\u30B3\u3092\u3042\u3052\u306A\u3044\u3093\u3067\u3059\u304B\uFF1F",
        "localizations": {
          "en": "I see...\nAre you giving chocolate to anyone, Magda?"
        }
