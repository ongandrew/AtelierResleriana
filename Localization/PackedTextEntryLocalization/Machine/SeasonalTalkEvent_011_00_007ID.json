  },
  {
    "id": 26,
    "properties": {
      "999008199": {
        "text": "\u304F\u3063\u304F\u3063\u304F\u3002\u30EA\u30F3\u30C7\u796D\u3067\u3001\u30DE\u30AF\u30C0\u69D8\u304C\u304A\u524D\u306B\n\u30C1\u30E7\u30B3\u3092\u7528\u610F\u3057\u3066\u308B\u3063\u3066\u8A71\u3055\u3002\u5149\u6804\u306B\u601D\u3048\u3088",
        "localizations": {
          "en": "Heh heh heh. Just that I\u0027m preparing chocolate for you\nat the Linde Festival. Consider yourself honored!"
        }
      },
      "2072370017": {
        "text": "\u30DE\u30AF\u30C0",
        "localizations": {
          "en": "Magda"
        }
      }
    }
  },
  {
    "id": 27,
    "properties": {
      "999008199": {
        "text": "\u306A\u3093\u3060\u2026\u2026\uFF1F\n\u3069\u3046\u3057\u305F\u3093\u3060\u3001\u30DE\u30AF\u30C0\uFF01",
        "localizations": {
          "en": "What\u0027s this...?\nWhat\u0027s gotten into you, Magda!"
