      "2072370017": {
        "text": "\u30BD\u30D5\u30A3\u30FC",
        "localizations": {
          "en": "Sophie"
        }
      }
    }
  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "\u3069\u3046\u3057\u305F\u3001\u305D\u3093\u306A\u8F9B\u6C17\u81ED\u3044\u9854\u3057\u3066\u3002\n\u3082\u3046\u3059\u3050\u30EA\u30F3\u30C7\u796D\u3060\u3063\u3066\u306E\u306B\u3088",
        "localizations": {
          "en": "Why the gloomy face?\nThe Linde Festival\u0027s just around the corner, y\u0027know!"
        }
      },
      "2072370017": {
        "text": "\u30DE\u30AF\u30C0",
        "localizations": {
          "en": "Magda"
        }
      }
    }
  },
  {
    "id": 4,
    "properties": {
      "999008199": {
        "text": "\u3053\u306E\u30DE\u30AF\u30C0\u69D8\u307F\u3066\u3048\u306B\u3001\n\u3082\u3063\u3068\u697D\u3057\u307E\u306A\u304D\u3083\u640D\u3060\u305E\uFF5E",
        "localizations": {
          "en": "You gotta enjoy yourself more,\njust like yours truly!"
        }
