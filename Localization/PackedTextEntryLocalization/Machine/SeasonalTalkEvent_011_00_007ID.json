      "2072370017": {
        "text": "\u30BD\u30D5\u30A3\u30FC",
        "localizations": {
          "en": "Sophie"
        }
      }
    }
  },
  {
    "id": 14,
    "properties": {
      "999008199": {
        "text": "\u307E\u3041\u3001\u4ED5\u4E8B\u4E0A\u3001\u6700\u8FD1\u3088\u304F\u7D44\u3093\u3067\u308B\u304B\u3089\u3088\u2026\u2026",
        "localizations": {
          "en": "Well, we\u0027ve been working together a lot lately..."
