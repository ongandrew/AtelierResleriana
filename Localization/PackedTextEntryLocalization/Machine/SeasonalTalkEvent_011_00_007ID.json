  {
    "id": 19,
    "properties": {
      "999008199": {
        "text": "\u574A\u3061\u3083\u3093\u306B\u6E21\u3059\u306E\u306F\u3044\u3064\u3082\u306E\u304A\u793C\u3063\u3066\u610F\u5473\u3060\u3002\n\u91CD\u8981\u306A\u610F\u5473\u304C\u542B\u307E\u308C\u3066\u3044\u308B\u308F\u3051\u3058\u3083\u306D\u3047\uFF01",
        "localizations": {
          "en": "I\u0027m just giving it to the young master as thanks.\nThere\u0027s no deeper meaning to it!"
