      "2072370017": {
        "text": "\u30DE\u30AF\u30C0",
        "localizations": {
          "en": "Magda"
        }
      }
    }
  },
  {
    "id": 5,
    "properties": {
      "999008199": {
        "text": "\u3042\u306F\u306F\u3001\u305D\u3046\u3067\u3059\u3088\u306D\u3002\n\u5B9F\u306F\u3001\u305D\u306E\u30EA\u30F3\u30C7\u796D\u306E\u3053\u3068\u3067\u60A9\u3093\u3067\u3044\u3066\u2026\u2026",
        "localizations": {
          "en": "Ahaha, you\u0027re right.\nActually, I\u0027ve been worrying about the Linde Festival..."
        }
      },
      "2072370017": {
        "text": "\u30BD\u30D5\u30A3\u30FC",
        "localizations": {
          "en": "Sophie"
        }
      }
    }
  },
  {
    "id": 6,
    "properties": {
      "999008199": {
        "text": "\u3078\u3048\uFF1F\u3000\u305D\u3046\u3044\u3046\u3053\u3068\u306A\u3089\u3001\n\u76F8\u8AC7\u306B\u3067\u3082\u4E57\u3063\u3066\u3084\u308D\u3046\u304B",
        "localizations": {
          "en": "Oh? Well in that case,\nwhy don\u0027t ya let me help you out?"
        }
      },
      "2072370017": {
        "text": "\u30DE\u30AF\u30C0",
        "localizations": {
          "en": "Magda"
        }
      }
    }
  },
  {
    "id": 7,
    "properties": {
      "999008199": {
        "text": "\u672C\u5F53\u3067\u3059\u304B\uFF1F\u3000\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\uFF01\n\u5B9F\u306F\u3067\u3059\u306D\u2026\u2026",
        "localizations": {
          "en": "Really? Thank you!\nWell, you see..."
        }
