    "properties": {
      "999008199": {
        "text": "\u3057\u3070\u3089\u304F\u898B\u307E\u305B\u3093\u3067\u3057\u305F\u306D\u3002\n\u3069\u3053\u3078\u884C\u3063\u3066\u3044\u305F\u306E\u3067\u3059\u304B\u3001\u30BD\u30D5\u30A3\u30FC\uFF1F",
        "localizations": {
          "en": "I haven\u0027t seen you in a while.\nWhere have you been, Sophie?"
        }
      },
      "2072370017": {
        "text": "\u30D7\u30E9\u30D5\u30BF",
        "localizations": {
          "en": "Plachta"
        }
      }
    }
  },
  {
    "id": 1,
    "properties": {
      "999008199": {
        "text": "\u2026\u2026\u5C11\u3057\u8003\u3048\u3054\u3068\u3092\uFF1F\u3000\u79C1\u304C\u3044\u308B\u306E\u306B\u3001\u3069\u3046\u3057\u3066\u4E00\u4EBA\u3067\n\u8003\u3048\u8FBC\u3080\u306E\u3067\u3059\uFF1F\u3000\u76F8\u8AC7\u3057\u3066\u304F\u308C\u308C\u3070\u2026\u2026",
        "localizations": {
          "en": "...Lost in thought? Why are you pondering alone when I\u0027m right here?\nYou know you can always talk to me..."
        }
      },
      "2072370017": {
        "text": "\u30D7\u30E9\u30D5\u30BF",
        "localizations": {
          "en": "Plachta"
        }
      }
    }
  },
  {
    "id": 2,
    "properties": {
      "999008199": {
        "text": "\u2026\u2026\u3042\u3002\u3042\u3042\u3001\u306A\u308B\u307B\u3069\u2026\u2026\u79C1\u3078\u306E\u30C1\u30E7\u30B3\u306B\u3064\u3044\u3066\n\u8003\u3048\u3066\u3044\u305F\u306E\u3067\u3059\u306D\u2026\u2026\u3075\u3075",
        "localizations": {
          "en": "...Ah. I see... You were thinking about chocolate for me...\n*chuckle*"
        }
      },
      "2072370017": {
        "text": "\u30D7\u30E9\u30D5\u30BF",
        "localizations": {
          "en": "Plachta"
        }
