[
  {
    "id": 0,
    "properties": {
      "999008199": {
        "text": "\u2026\u2026\u3048\uFF1F\n\u300C\u8D08\u308A\u3082\u306E\u306E\u304A\u793C\u306B\u30C1\u30E7\u30B3\u304C\u6B32\u3057\u3044\u300D\u3001\u3067\u3059\u304B\uFF1F",
        "localizations": {
          "en": "...Hm?\nYou want chocolate as thanks for your gift?"
        }
      },
      "2072370017": {
        "text": "\u30D7\u30E9\u30D5\u30BF",
        "localizations": {
          "en": "Plachta"
        }
      }
    }
  },
  {
    "id": 1,
    "properties": {
      "999008199": {
        "text": "\u6B21\u306E\u30EA\u30F3\u30C7\u796D\u307E\u3067\u304A\u9810\u3051\u3060\u3068\u8A00\u3044\u307E\u3057\u305F\u3088\u306D\u3002\n\u306D\u3060\u3063\u305F\u3063\u3066\u51FA\u307E\u305B\u3093",
        "localizations": {
          "en": "I told you we\u0027d have to wait until the next Linde Festival.\nNo amount of begging will change that."
        }
      },
      "2072370017": {
        "text": "\u30D7\u30E9\u30D5\u30BF",
        "localizations": {
          "en": "Plachta"
        }
      }
    }
  },
  {
    "id": 2,
    "properties": {
      "999008199": {
        "text": "\u307E\u305F\u6765\u5E74\u3001\u5FC5\u305A\u304A\u6E21\u3057\u3057\u307E\u3059\u304B\u3089\u3002\n\u305D\u306E\u6B21\u306E\u5E74\u3082\u3001\u305D\u306E\u307E\u305F\u6B21\u306E\u5E74\u3082\u2026\u2026",
        "localizations": {
          "en": "I\u0027ll definitely give you some next year.\nAnd the year after that, and the year after that..."
        }
      },
      "2072370017": {
        "text": "\u30D7\u30E9\u30D5\u30BF",
        "localizations": {
          "en": "Plachta"
        }
      }
    }
  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "\u3060\u304B\u3089\u3001\u305D\u306E\u2026\u2026\u305A\u3063\u3068\u4E00\u7DD2\u306B\u5C45\u307E\u3057\u3087\u3046",
        "localizations": {
          "en": "So... let\u0027s stay together, always."
        }
      },
      "2072370017": {
        "text": "\u30D7\u30E9\u30D5\u30BF",
        "localizations": {
          "en": "Plachta"
        }
      }
    }
  },
  {
    "id": 4,
    "properties": {
      "999008199": {
        "text": "\u2026\u2026\u3042\u3042\u3082\u3046\u3001\u79C1\u3060\u3063\u3066\u672C\u5F53\u306F\u3082\u3063\u3068\u3042\u306A\u305F\u306E\u30C1\u30E7\u30B3\u304C\n\u98DF\u3079\u305F\u3044\u3093\u3067\u3059\u304B\u3089",
        "localizations": {
          "en": "...Oh honestly, I really want to eat your chocolates too,\nyou know."
        }
      },
      "2072370017": {
        "text": "\u30D7\u30E9\u30D5\u30BF",
        "localizations": {
          "en": "Plachta"
        }
      }
    }
  },
  {
    "id": 5,
    "properties": {
      "999008199": {
        "text": "\u3067\u3082\u3001\u6B6F\u6B62\u3081\u304C\u52B9\u304B\u306A\u304F\u306A\u3063\u3066\u3057\u307E\u3044\u305D\u3046\u306A\u306E\u3067\u3002\n\u304D\u3063\u3068\u3053\u306E\u4F53\u306E\u98DF\u6B32\u306E\u305B\u3044\u3067\u3059",
        "localizations": {
          "en": "But I might not be able to control myself.\nIt must be this body\u0027s appetite."
        }
      },
      "2072370017": {
        "text": "\u30D7\u30E9\u30D5\u30BF",
        "localizations": {
          "en": "Plachta"
        }
      }
    }
  },
  {
    "id": 6,
    "properties": {
      "999008199": {
        "text": "\u3067\u3059\u304B\u3089\u305D\u306E\u3001\u307E\u305F\u6765\u5E74\u3002\u4E00\u7DD2\u306B\u307E\u305F\u98DF\u3079\u307E\u3057\u3087\u3046\u3002\n\u7D04\u675F\u3001\u3067\u3059\u3088",
        "localizations": {
          "en": "So, um, next year. Let\u0027s eat together again.\nIt\u0027s a promise."
        }
      },
      "2072370017": {
        "text": "\u30D7\u30E9\u30D5\u30BF",
        "localizations": {
          "en": "Plachta"
        }
      }
    }
  }
]