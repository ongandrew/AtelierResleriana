  },
  {
    "id": 14,
    "properties": {
      "999008199": {
        "text": "\u3060\u3068\u3059\u308B\u3068\u3001\u8EAB\u69CB\u3048\u3066\u305F\u5206\u3001\n\u306A\u3093\u304B\u624B\u6301\u3061\u7121\u6C99\u6C70\u306A\u2015\u2015",
