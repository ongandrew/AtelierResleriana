      "2072370017": {
        "text": "\u30ED\u30ED\u30CA",
        "localizations": {
          "en": "Rorona"
        }
      }
    }
  },
  {
    "id": 13,
    "properties": {
      "999008199": {
        "text": "\u3075\u3046\u2026\u2026\u305D\u3063\u304B\u305D\u3063\u304B\uFF5E\u2026\u2026\n\u5F53\u65E5\u307E\u3067\u901A\u5E38\u55B6\u696D\u304B\u30FC",
        "localizations": {
          "en": "*Sigh*... I see, I see... Business as usual until the festival, huh..."
