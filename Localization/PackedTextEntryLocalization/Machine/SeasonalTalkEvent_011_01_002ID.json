        "text": "\u30AF\u30E9\u30A6\u30C7\u30A3\u30A2\u306E\u898B\u8B58\u3092\u898B\u8FBC\u3093\u3067\u3001\n\u610F\u898B\u3092\u6C42\u3081\u3066\u304D\u305F\u3063\u3066\u3053\u3068\u306D",
