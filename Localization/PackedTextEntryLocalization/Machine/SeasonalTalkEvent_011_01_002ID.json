        "text": "\u305D\u3046\u3002\n\u3067\u3001\u3069\u3093\u306A\u3082\u306E\u3092\u58F2\u308B\u306E\u304C\u3044\u3044\u306E\u304B\u3063\u3066\u2026\u2026",
