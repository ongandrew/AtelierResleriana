  },
  {
    "id": 21,
    "properties": {
      "999008199": {
        "text": "\u3042\u30FC\u3001\u5927\u304D\u3044\u304A\u796D\u308A\u3060\u3057\u3001\n\u968A\u5546\u306E\u4EBA\u306B\u3068\u3063\u3066\u306F\u7D76\u597D\u306E\u5546\u6A5F\u3060\u3082\u3093\u306D",
