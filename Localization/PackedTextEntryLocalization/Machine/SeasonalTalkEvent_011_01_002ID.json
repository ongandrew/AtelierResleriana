  {
    "id": 20,
    "properties": {
      "999008199": {
        "text": "\u3046\u3093\u3002\u30EA\u30F3\u30C7\u796D\u306B\u5411\u3051\u3066\u3001\n\u30C1\u30E7\u30B3\u4EE5\u5916\u306E\u3082\u306E\u3092\u58F2\u308A\u51FA\u3057\u305F\u3044\u3093\u3060\u3063\u3066",
