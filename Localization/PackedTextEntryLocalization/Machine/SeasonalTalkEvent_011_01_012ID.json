        }
      }
    }
  },
  {
    "id": 45,
    "properties": {
      "999008199": {
        "text": "\uFF08\u3053\u3046\u3057\u3066\u307E\u305F\u3001\u3042\u305F\u3057\u305F\u3061\u306F\u4E8C\u4EBA\u3067\n\u3000\u65B0\u305F\u306A\u4F9D\u983C\u306B\u98DB\u3073\u51FA\u3057\u3066\u3044\u304F\uFF09",
        "localizations": {
