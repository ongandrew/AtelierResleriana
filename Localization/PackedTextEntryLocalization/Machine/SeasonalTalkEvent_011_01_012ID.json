      "2072370017": {
        "text": "\u30E9\u30A4\u30B6",
        "localizations": {
          "en": "Ryza"
        }
      }
    }
  },
  {
    "id": 43,
    "properties": {
      "999008199": {
        "text": "\u4E00\u7DD2\u306B\u6848\u51FA\u3057\uFF01\u3000\u624B\u4F1D\u3063\u3066\uFF01",
