        "text": "\u5546\u4EBA",
        "localizations": {
          "en": "Merchant"
        }
      }
    }
  },
  {
    "id": 42,
    "properties": {
      "999008199": {
        "text": "\u307E\u3042\u3001\u305D\u3053\u307E\u3067\u8A00\u3046\u306A\u3089\u3002\n\u3068\u3044\u3046\u308F\u3051\u3067\u3001\u30AF\u30E9\u30A6\u30C7\u30A3\u30A2\uFF01",
        "localizations": {
          "en": "Well, if you insist.\nSo, Klaudia!"
        }
