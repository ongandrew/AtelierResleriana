        "text": "\u3082\u3061\u308D\u3093\u3001\u5831\u916C\u306F\u5F3E\u307F\u307E\u3059\uFF01",
        "localizations": {
          "en": "Of course, I\u0027ll pay generously!"
        }
      },
      "2072370017": {
        "text": "\u5546\u4EBA",
        "localizations": {
          "en": "Merchant"
        }
      }
    }
  },
  {
    "id": 40,
    "properties": {
      "999008199": {
        "text": "\u30AF\u30E9\u30A6\u30C7\u30A3\u30A2\u3055\u3093\u3082\u4ECA\u65E5\u306E\u304A\u624B\u4F1D\u3044\u306F\u30CA\u30B7\u3067\u3001\n\u30E9\u30A4\u30B6\u3055\u3093\u306E\u304A\u624B\u4F1D\u3044\u306B\u56DE\u3063\u3066\u3044\u305F\u3060\u3044\u3066\u69CB\u3044\u307E\u305B\u3093\uFF01",
        "localizations": {
          "en": "Klaudia, you can skip today\u0027s duties.\nPlease help Ryza with this instead!"
        }
      },
      "2072370017": {
        "text": "\u5546\u4EBA",
        "localizations": {
          "en": "Merchant"
        }
      }
    }
  },
  {
    "id": 41,
    "properties": {
      "999008199": {
        "text": "\u3068\u3044\u3046\u308F\u3051\u3067\u3001\u305C\u3072\u3068\u3082\uFF01",
        "localizations": {
          "en": "So, what do you say?!"
