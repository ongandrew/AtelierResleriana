      "999008199": {
        "text": "\u300C\u968A\u5546\u306E\u4EBA\u305F\u3061\u306F\u5927\u5909\u300D\uFF1F\u3000\u78BA\u304B\u306B\u3001\u3044\u308D\u3093\u306A\u3068\u3053\u308D\u3092\n\u5927\u8377\u7269\u3067\u9032\u3080\u5FC5\u8981\u304C\u3042\u308B\u304B\u3089\u3001\u5927\u5909\u304B\u3082",
        "localizations": {
          "en": "\u0022Life is hard for merchants?\u0022 Well, I suppose it can be difficult, having to travel everywhere with such heavy loads..."
        }
      },
      "2072370017": {
        "text": "\u30AF\u30E9\u30A6\u30C7\u30A3\u30A2",
