      "2072370017": {
        "text": "ハイディ",
        "localizations": {
          "en": "Heidi"
        }
      }
    }
  },
  {
    "id": 61,
    "properties": {
      "999008199": {
        "text": "芸術は嗜んでるから。\nあなたこそ、ものすごいスピードで描けるのね",
        "localizations": {
          "en": "I've always had an appreciation for art. And you were quite impressive yourself, drawing at such incredible speed."
        }
