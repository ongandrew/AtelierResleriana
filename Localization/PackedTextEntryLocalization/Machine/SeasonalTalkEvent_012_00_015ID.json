      "2072370017": {
        "text": "ハイディ",
        "localizations": {
          "en": "Heidi"
        }
      }
    }
  },
  {
    "id": 63,
    "properties": {
      "999008199": {
        "text": "昨日の夕方から一晩かけて、\nみんなで協力して仕上げました",
        "localizations": {
          "en": "We all worked together to complete this, starting from yesterday evening and working through the night."
