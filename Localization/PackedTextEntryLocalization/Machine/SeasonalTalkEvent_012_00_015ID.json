      "2072370017": {
        "text": "ユナ",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 59,
    "properties": {
      "999008199": {
        "text": "私たちのチョークで描いた絵です。\n赤、白、黄色……と言えば、これですよね",
        "localizations": {
          "en": "This was drawn with our chalk. Red, white, yellow... take a look at what we're capable of."
