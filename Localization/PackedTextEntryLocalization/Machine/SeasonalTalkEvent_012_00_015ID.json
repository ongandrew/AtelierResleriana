      "2072370017": {
        "text": "ミミ",
        "localizations": {
          "en": "Mimi"
        }
      }
    }
  },
  {
    "id": 62,
    "properties": {
      "999008199": {
        "text": "手先は器用だからね！",
        "localizations": {
          "en": "I've always been good with my hands!"
