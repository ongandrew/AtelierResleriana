        "localizations": {
          "en": "Plachta"
        }
      }
    }
  },
  {
    "id": 60,
    "properties": {
      "999008199": {
        "text": "いやー、間に合った間に合った！\nミミ、やるじゃん！\u3000こんなデザインができるなんて",
        "localizations": {
          "en": "Phew, we made it just in time! Mimi, you're amazing! This design is unbelievable!"
