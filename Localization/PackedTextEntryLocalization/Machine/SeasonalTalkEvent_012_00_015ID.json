        "text": "プラフタ",
        "localizations": {
          "en": "Plachta"
        }
      }
    }
  },
  {
    "id": 70,
    "properties": {
      "999008199": {
        "text": "このように、普段は絵を描いてはいけないような\nところにも、絵を描くことができる",
        "localizations": {
