        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 58,
    "properties": {
      "999008199": {
        "text": "これは……壮観だな",
        "localizations": {
          "en": "This is... magnificent."
