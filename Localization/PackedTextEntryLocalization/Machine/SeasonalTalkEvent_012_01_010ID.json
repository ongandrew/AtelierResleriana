[
  {
    "id": 0,
    "properties": {
      "999008199": {
        "text": "――文化祭１週間前",
        "localizations": {
          "en": "—One week before the cultural festival"
        }
      },
      "2072370017": {
        "text": "字幕",
        "localizations": {
          "en": "Caption"
        }
      }
    }
  },
  {
    "id": 1,
    "properties": {
      "999008199": {
        "text": "ふう……",
        "localizations": {
          "en": "Phew..."
        }
      },
      "2072370017": {
        "text": "ハイディ",
        "localizations": {
          "en": "Heidi"
        }
      }
    }
  },
  {
    "id": 2,
    "properties": {
      "999008199": {
        "text": "あー、もうこんな時間か。\nフロッケ、お腹空かない？",
        "localizations": {
          "en": "Wow, look at the time. Getting hungry yet, Flocke?"
        }
      },
      "2072370017": {
        "text": "ハイディ",
        "localizations": {
          "en": "Heidi"
        }
      }
    }
  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "いえ、大丈夫です",
        "localizations": {
          "en": "No, I'm fine."
        }
      },
      "2072370017": {
        "text": "フロッケ",
        "localizations": {
          "en": "Flocke"
        }
      }
    }
  },
  {
    "id": 4,
    "properties": {
      "999008199": {
        "text": "ちょっとは休憩しなよー",
        "localizations": {
          "en": "Come on, take a break already."
        }
      },
      "2072370017": {
        "text": "ハイディ",
        "localizations": {
          "en": "Heidi"
        }
      }
    }
  },
  {
    "id": 5,
    "properties": {
      "999008199": {
        "text": "はい",
        "localizations": {
          "en": "Okay."
        }
      },
      "2072370017": {
        "text": "フロッケ",
        "localizations": {
          "en": "Flocke"
        }
      }
    }
  },
  {
    "id": 6,
    "properties": {
      "999008199": {
        "text": "失礼する",
        "localizations": {
          "en": "Excuse me?"
        }
      },
      "2072370017": {
        "text": "ユナ",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 7,
    "properties": {
      "999008199": {
        "text": "あれ、ユナさん。ロロナも。どしたの？",
        "localizations": {
          "en": "Juna, and Rorona too. What brings you here?"
        }
      },
      "2072370017": {
        "text": "ハイディ",
        "localizations": {
          "en": "Heidi"
        }
      }
    }
  },
  {
    "id": 8,
    "properties": {
      "999008199": {
        "text": "見回りだ。この時期はどこも深夜まで\n文化祭の準備をしているからな",
        "localizations": {
          "en": "Just doing rounds. Seems like everyone's up late getting ready for the festival."
        }
      },
      "2072370017": {
        "text": "ユナ",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 9,
    "properties": {
      "999008199": {
        "text": "先生方は黙認している手前、こうして実行委員が\n中心となって目を光らせているんだ",
        "localizations": {
          "en": "Since the teachers are turning a blind eye, we committee members are keeping watch instead."
        }
      },
      "2072370017": {
        "text": "ユナ",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 10,
    "properties": {
      "999008199": {
        "text": "わたしも委員長としてお手伝いを！",
        "localizations": {
          "en": "I'm helping out as committee chairperson!"
        }
      },
      "2072370017": {
        "text": "ロロナ",
        "localizations": {
          "en": "Rorona"
        }
      }
    }
  },
  {
    "id": 11,
    "properties": {
      "999008199": {
        "text": "そりゃお疲れさまですね……",
        "localizations": {
          "en": "Sounds like tough work..."
        }
      },
      "2072370017": {
        "text": "ハイディ",
        "localizations": {
          "en": "Heidi"
        }
      }
    }
  },
  {
    "id": 12,
    "properties": {
      "999008199": {
        "text": "特に困っていることはないか？",
        "localizations": {
          "en": "Everything going well?"
        }
      },
      "2072370017": {
        "text": "ユナ",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 13,
    "properties": {
      "999008199": {
        "text": "うん。ねえフロッケ――",
        "localizations": {
          "en": "Yeah. Hey, Flocke—"
        }
      },
      "2072370017": {
        "text": "ハイディ",
        "localizations": {
          "en": "Heidi"
        }
      }
    }
  },
  {
    "id": 14,
    "properties": {
      "999008199": {
        "text": "フロッケ！？",
        "localizations": {
          "en": "Flocke?!"
        }
      },
      "2072370017": {
        "text": "ハイディ",
        "localizations": {
          "en": "Heidi"
        }
      }
    }
  },
  {
    "id": 15,
    "properties": {
      "999008199": {
        "text": "大丈夫か！",
        "localizations": {
          "en": "Are you alright?!"
        }
      },
      "2072370017": {
        "text": "ユナ",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 16,
    "properties": {
      "999008199": {
        "text": "っ……",
        "localizations": {
          "en": "Ngh..."
        }
      },
      "2072370017": {
        "text": "フロッケ",
        "localizations": {
          "en": "Flocke"
        }
      }
    }
  },
  {
    "id": 17,
    "properties": {
      "999008199": {
        "text": "フロッケ！\u3000ちょっと！\u3000大丈夫！？",
        "localizations": {
          "en": "Flocke! Hey! Are you okay?!"
        }
      },
      "2072370017": {
        "text": "ハイディ",
        "localizations": {
          "en": "Heidi"
        }
      }
    }
  },
  {
    "id": 18,
    "properties": {
      "999008199": {
        "text": "たたた、大変……！",
        "localizations": {
          "en": "Oh no, this is bad...!"
        }
      },
      "2072370017": {
        "text": "ロロナ",
        "localizations": {
          "en": "Rorona"
        }
      }
    }
  },
  {
    "id": 19,
    "properties": {
      "999008199": {
        "text": "どこか安静になれる場所に……\n保健室の鍵を借りてくるか？",
        "localizations": {
          "en": "We need somewhere she can rest... Should I get the key to the infirmary?"
        }
      },
      "2072370017": {
        "text": "ユナ",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  },
  {
    "id": 20,
    "properties": {
      "999008199": {
        "text": "そ、それなら、錬金術部の部室に！\nすぐそこですから！",
        "localizations": {
          "en": "T-the Alchemy Club room is closer! Just over there!"
        }
      },
      "2072370017": {
        "text": "ロロナ",
        "localizations": {
          "en": "Rorona"
        }
      }
    }
  },
  {
    "id": 21,
    "properties": {
      "999008199": {
        "text": "ん……",
        "localizations": {
          "en": "Mm..."
        }
      },
      "2072370017": {
        "text": "フロッケ",
        "localizations": {
          "en": "Flocke"
        }
      }
    }
  },
  {
    "id": 22,
    "properties": {
      "999008199": {
        "text": "フロッケ！",
        "localizations": {
          "en": "Flocke!"
        }
      },
      "2072370017": {
        "text": "ハイディ",
        "localizations": {
          "en": "Heidi"
        }
      }
    }
  },
  {
    "id": 23,
    "properties": {
      "999008199": {
        "text": "よかったあ……目を覚まさなかったらどうしようかと",
        "localizations": {
          "en": "Thank goodness... I was so worried that she wouldn't wake up."
        }
      },
      "2072370017": {
        "text": "ロロナ",
        "localizations": {
          "en": "Rorona"
        }
      }
    }
  },
  {
    "id": 24,
    "properties": {
      "999008199": {
        "text": "縁起でもないこと言わないでください",
        "localizations": {
          "en": "Don't say things like that, it's bad luck."
        }
      },
      "2072370017": {
        "text": "ミミ",
        "localizations": {
          "en": "Mimi"
        }
      }
    }
  },
  {
    "id": 25,
    "properties": {
      "999008199": {
        "text": "辛いところはないですか？",
        "localizations": {
          "en": "Are you hurting anywhere?"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 26,
    "properties": {
      "999008199": {
        "text": "少し、ぼーっとします……けど……\n痛いところは特に……",
        "localizations": {
          "en": "My head's a bit... fuzzy... but nothing... particularly hurts..."
        }
      },
      "2072370017": {
        "text": "フロッケ",
        "localizations": {
          "en": "Flocke"
        }
      }
    }
  },
  {
    "id": 27,
    "properties": {
      "999008199": {
        "text": "風邪とかではなさそうだし……\nきっと疲れが溜まってたんだね",
        "localizations": {
          "en": "It doesn't seem like a cold... You're probably just exhausted."
        }
      },
      "2072370017": {
        "text": "ソフィー",
        "localizations": {
          "en": "Sophie"
        }
      }
    }
  },
  {
    "id": 28,
    "properties": {
      "999008199": {
        "text": "……すみません。ご心配をおかけしてしまって",
        "localizations": {
          "en": "...I'm sorry for worrying everyone."
        }
      },
      "2072370017": {
        "text": "フロッケ",
        "localizations": {
          "en": "Flocke"
        }
      }
    }
  },
  {
    "id": 29,
    "properties": {
      "999008199": {
        "text": "だから言ったんだよ……",
        "localizations": {
          "en": "This is exactly what I was talking about..."
        }
      },
      "2072370017": {
        "text": "ハイディ",
        "localizations": {
          "en": "Heidi"
        }
      }
    }
  },
  {
    "id": 30,
    "properties": {
      "999008199": {
        "text": "無理しないでって散々言ったじゃん！\nあんまり身体が強くないんだからさ！",
        "localizations": {
          "en": "I told you over and over not to push yourself! You know you don't have the strongest constitution!"
        }
      },
      "2072370017": {
        "text": "ハイディ",
        "localizations": {
          "en": "Heidi"
        }
      }
    }
  },
  {
    "id": 31,
    "properties": {
      "999008199": {
        "text": "……すみません",
        "localizations": {
          "en": "...I'm sorry."
        }
      },
      "2072370017": {
        "text": "フロッケ",
        "localizations": {
          "en": "Flocke"
        }
      }
    }
  },
  {
    "id": 32,
    "properties": {
      "999008199": {
        "text": "……今日はもう寝なよ",
        "localizations": {
          "en": "...Just go get some sleep."
        }
      },
      "2072370017": {
        "text": "ハイディ",
        "localizations": {
          "en": "Heidi"
        }
      }
    }
  },
  {
    "id": 33,
    "properties": {
      "999008199": {
        "text": "お、おい。待て！",
        "localizations": {
          "en": "H-hold on! Wait!"
        }
      },
      "2072370017": {
        "text": "ユナ",
        "localizations": {
          "en": "Juna"
        }
      }
    }
  }
]