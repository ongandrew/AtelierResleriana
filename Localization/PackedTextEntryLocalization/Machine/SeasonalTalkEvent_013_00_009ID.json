[
  {
    "id": 0,
    "properties": {
      "999008199": {
        "text": "あんたで最後ね！\u3000これで終わりよ！",
        "localizations": {
          "en": "You're the last one! This ends it!"
        }
      },
      "2072370017": {
        "text": "ヨハナ",
        "localizations": {
          "en": "Johanna"
        }
      }
    }
  },
  {
    "id": 1,
    "properties": {
      "999008199": {
        "text": "あ、こら、どこ行くのよ！",
        "localizations": {
          "en": "Hey, wait! Where are you going?!"
        }
      },
      "2072370017": {
        "text": "ヨハナ",
        "localizations": {
          "en": "Johanna"
        }
      }
    }
  },
  {
    "id": 2,
    "properties": {
      "999008199": {
        "text": "まずいですわ！\u3000アレはグランプリに必要なもの\nでしたのに……！",
        "localizations": {
          "en": "Oh no! That was something we needed for the Grand Prix...!"
        }
      },
      "2072370017": {
        "text": "ララ",
        "localizations": {
          "en": "Lara"
        }
      }
    }
  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "取り戻すわ……！",
        "localizations": {
          "en": "I'll get it back...!"
        }
      },
      "2072370017": {
        "text": "アンチュ",
        "localizations": {
          "en": "Antje"
        }
      }
    }
  },
  {
    "id": 4,
    "properties": {
      "999008199": {
        "text": "ヒュー！\u3000これなら追いつけるんじゃねえか？",
        "localizations": {
          "en": "Whew! At this rate, we might just catch up!"
        }
      },
      "2072370017": {
        "text": "ルアッカ",
        "localizations": {
          "en": "Scarlet"
        }
      }
    }
  },
  {
    "id": 5,
    "properties": {
      "999008199": {
        "text": "ダメ！\u3000相手も速度を上げたみたい！",
        "localizations": {
          "en": "No good! It's picking up speed too!"
        }
      },
      "2072370017": {
        "text": "アオナ",
        "localizations": {
          "en": "Azure"
        }
      }
    }
  },
  {
    "id": 6,
    "properties": {
      "999008199": {
        "text": "このままじゃ逃げられちまうぜ！",
        "localizations": {
          "en": "We're gonna lose it at this rate!"
        }
      },
      "2072370017": {
        "text": "ルアッカ",
        "localizations": {
          "en": "Scarlet"
        }
      }
    }
  },
  {
    "id": 7,
    "properties": {
      "999008199": {
        "text": "逃が、さない……！",
        "localizations": {
          "en": "I won't... let it escape...!"
        }
      },
      "2072370017": {
        "text": "アンチュ",
        "localizations": {
          "en": "Antje"
        }
      }
    }
  },
  {
    "id": 8,
    "properties": {
      "999008199": {
        "text": "使っちゃうの？\u3000とっておきの隠し玉なのに",
        "localizations": {
          "en": "Are you really going to use it? That's your secret weapon!"
        }
      },
      "2072370017": {
        "text": "アオナ",
        "localizations": {
          "en": "Azure"
        }
      }
    }
  },
  {
    "id": 9,
    "properties": {
      "999008199": {
        "text": "いいよ。だって、取り戻さないと……",
        "localizations": {
          "en": "It's fine. Because if I don't get it back..."
        }
      },
      "2072370017": {
        "text": "アンチュ",
        "localizations": {
          "en": "Antje"
        }
      }
    }
  },
  {
    "id": 10,
    "properties": {
      "999008199": {
        "text": "クリセルダに参加してほしいって言われてた、\nグランプリ自体が台無しになるから……！",
        "localizations": {
          "en": "The whole Grand Prix that Criselda wanted me to participate in will be ruined...!"
        }
      },
      "2072370017": {
        "text": "アンチュ",
        "localizations": {
          "en": "Antje"
        }
      }
    }
  },
  {
    "id": 11,
    "properties": {
      "999008199": {
        "text": "おねがい……当たって！",
        "localizations": {
          "en": "Please... hit your mark!"
        }
      },
      "2072370017": {
        "text": "アンチュ",
        "localizations": {
          "en": "Antje"
        }
      }
    }
  },
  {
    "id": 12,
    "properties": {
      "999008199": {
        "text": "やったぜ！",
        "localizations": {
          "en": "We got it!"
        }
      },
      "2072370017": {
        "text": "ルアッカ",
        "localizations": {
          "en": "Scarlet"
        }
      }
    }
  },
  {
    "id": 13,
    "properties": {
      "999008199": {
        "text": "そんな……！\u3000荷物が！",
        "localizations": {
          "en": "Oh no...! The cargo!"
        }
      },
      "2072370017": {
        "text": "アオナ",
        "localizations": {
          "en": "Azure"
        }
      }
    }
  },
  {
    "id": 14,
    "properties": {
      "999008199": {
        "text": "くっ……！",
        "localizations": {
          "en": "Damn...!"
        }
      },
      "2072370017": {
        "text": "アンチュ",
        "localizations": {
          "en": "Antje"
        }
      }
    }
  },
  {
    "id": 15,
    "properties": {
      "999008199": {
        "text": "（沈むのが早いけど……追いつける……！）",
        "localizations": {
          "en": "(It's sinking fast, but... I can catch up...!)"
        }
      },
      "2072370017": {
        "text": "アンチュ",
        "localizations": {
          "en": "Antje"
        }
      }
    }
  },
  {
    "id": 16,
    "properties": {
      "999008199": {
        "text": "（あと少し……苦しいけど……届いて！）",
        "localizations": {
          "en": "(Just a little more... It's hard to breathe, but... reach it!)"
        }
      },
      "2072370017": {
        "text": "アンチュ",
        "localizations": {
          "en": "Antje"
        }
      }
    }
  },
  {
    "id": 17,
    "properties": {
      "999008199": {
        "text": "！？\u3000ゲホ、ゴボ……！",
        "localizations": {
          "en": "!? *cough* *gasp*...!"
        }
      },
      "2072370017": {
        "text": "アンチュ",
        "localizations": {
          "en": "Antje"
        }
      }
    }
  },
  {
    "id": 18,
    "properties": {
      "999008199": {
        "text": "……気が付きましたわ！",
        "localizations": {
          "en": "...You're awake!"
        }
      },
      "2072370017": {
        "text": "ララ",
        "localizations": {
          "en": "Lara"
        }
      }
    }
  },
  {
    "id": 19,
    "properties": {
      "999008199": {
        "text": "ふう……まったく、あんたがあんな無茶するなんてね",
        "localizations": {
          "en": "Phew... Honestly, I never thought you'd do something so reckless."
        }
      },
      "2072370017": {
        "text": "ヨハナ",
        "localizations": {
          "en": "Johanna"
        }
      }
    }
  },
  {
    "id": 20,
    "properties": {
      "999008199": {
        "text": "ここは……荷物は！？",
        "localizations": {
          "en": "Where am I... What about the cargo?!"
        }
      },
      "2072370017": {
        "text": "アンチュ",
        "localizations": {
          "en": "Antje"
        }
      }
    }
  },
  {
    "id": 21,
    "properties": {
      "999008199": {
        "text": "そんなことよりも、自分の心配をしなさいな",
        "localizations": {
          "en": "Never mind that, you should be worried about yourself."
        }
      },
      "2072370017": {
        "text": "ララ",
        "localizations": {
          "en": "Lara"
        }
      }
    }
  },
  {
    "id": 22,
    "properties": {
      "999008199": {
        "text": "でも……",
        "localizations": {
          "en": "But..."
        }
      },
      "2072370017": {
        "text": "アンチュ",
        "localizations": {
          "en": "Antje"
        }
      }
    }
  },
  {
    "id": 23,
    "properties": {
      "999008199": {
        "text": "荷物は無事よ。やるじゃない",
        "localizations": {
          "en": "The cargo's safe. Nice work."
        }
      },
      "2072370017": {
        "text": "ヨハナ",
        "localizations": {
          "en": "Johanna"
        }
      }
    }
  },
  {
    "id": 24,
    "properties": {
      "999008199": {
        "text": "良かった……",
        "localizations": {
          "en": "Thank goodness..."
        }
      },
      "2072370017": {
        "text": "アンチュ",
        "localizations": {
          "en": "Antje"
        }
      }
    }
  },
  {
    "id": 25,
    "properties": {
      "999008199": {
        "text": "良かった……じゃないですわ！\nもう二度とこんなことはしないことです",
        "localizations": {
          "en": "'Thank goodness' nothing! You must never do something like that again."
        }
      },
      "2072370017": {
        "text": "ララ",
        "localizations": {
          "en": "Lara"
        }
      }
    }
  },
  {
    "id": 26,
    "properties": {
      "999008199": {
        "text": "……",
        "localizations": {
          "en": "..."
        }
      },
      "2072370017": {
        "text": "アンチュ",
        "localizations": {
          "en": "Antje"
        }
      }
    }
  },
  {
    "id": 27,
    "properties": {
      "999008199": {
        "text": "クリセルダに言いつけますわよ",
        "localizations": {
          "en": "I'm telling Criselda about this."
        }
      },
      "2072370017": {
        "text": "ララ",
        "localizations": {
          "en": "Lara"
        }
      }
    }
  },
  {
    "id": 28,
    "properties": {
      "999008199": {
        "text": "ごめんなさい",
        "localizations": {
          "en": "I'm sorry."
        }
      },
      "2072370017": {
        "text": "アンチュ",
        "localizations": {
          "en": "Antje"
        }
      }
    }
  },
  {
    "id": 29,
    "properties": {
      "999008199": {
        "text": "でも、これで……\n魔物もいなくなり、準備は整いました",
        "localizations": {
          "en": "But now... with the monsters gone and our preparations complete..."
        }
      },
      "2072370017": {
        "text": "ララ",
        "localizations": {
          "en": "Lara"
        }
      }
    }
  },
  {
    "id": 30,
    "properties": {
      "999008199": {
        "text": "いよいよ明日。\nグランプリ開催ですわ！",
        "localizations": {
          "en": "Tomorrow's the day. The Grand Prix begins!"
        }
      },
      "2072370017": {
        "text": "ララ",
        "localizations": {
          "en": "Lara"
        }
      }
    }
  }
]