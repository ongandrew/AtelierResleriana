        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 4,
    "properties": {
      "999008199": {
        "text": "それっ！",
        "localizations": {
          "en": "Here goes!"
        }
      },
      "2072370017": {
