        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 5,
    "properties": {
      "999008199": {
        "text": "バッチコーイ！",
        "localizations": {
          "en": "Bring it on!"
        }
      },
      "2072370017": {
