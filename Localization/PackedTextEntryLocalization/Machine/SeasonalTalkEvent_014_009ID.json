        }
      }
    }
  },
  {
    "id": 6,
    "properties": {
      "999008199": {
        "text": "お願いっ！",
        "localizations": {
          "en": "Please!"
        }
      },
      "2072370017": {
        "text": "マリー・ローズ",
        "localizations": {
          "en": "Marie Rose"
        }
      }
    }
  },
  {
    "id": 7,
    "properties": {
      "999008199": {
        "text": "ええいっ！",
        "localizations": {
          "en": "Hiyah!"
        }
      },
      "2072370017": {
        "text": "ほのか",
        "localizations": {
          "en": "Honoka"
        }
      }
    }
  },
  {
    "id": 8,
    "properties": {
      "999008199": {
        "text": "おとと……！\u3000レスナ！",
        "localizations": {
          "en": "Whoa...! Resna!"
        }
      },
      "2072370017": {
        "text": "アルビーナ",
        "localizations": {
          "en": "Alvina"
        }
      }
    }
  },
  {
    "id": 9,
    "properties": {
      "999008199": {
        "text": "やあああっ！！！",
        "localizations": {
          "en": "Yaaaaah!!!"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 10,
    "properties": {
      "999008199": {
        "text": "ナイスアタック！\u3000でもっ……！",
        "localizations": {
          "en": "Nice attack! But...!"
        }
      },
      "2072370017": {
        "text": "マリー・ローズ",
        "localizations": {
          "en": "Marie Rose"
        }
      }
    }
  },
  {
    "id": 11,
    "properties": {
      "999008199": {
        "text": "ナイスレシーブ！",
        "localizations": {
          "en": "Nice receive!"
        }
      },
      "2072370017": {
        "text": "ほのか",
        "localizations": {
          "en": "Honoka"
        }
      }
    }
  },
  {
    "id": 12,
    "properties": {
      "999008199": {
        "text": "いっけーーー！",
        "localizations": {
          "en": "Go get it!"
        }
      },
      "2072370017": {
        "text": "マリー・ローズ",
        "localizations": {
          "en": "Marie Rose"
        }
      }
    }
  },
  {
    "id": 13,
    "properties": {
      "999008199": {
        "text": "え、ちょ……！",
        "localizations": {
          "en": "Wait, hold on...!"
        }
      },
      "2072370017": {
        "text": "アルビーナ",
        "localizations": {
          "en": "Alvina"
        }
      }
    }
  },
  {
    "id": 14,
    "properties": {
      "999008199": {
        "text": "へぶっ！",
        "localizations": {
          "en": "Oof!"
        }
      },
      "2072370017": {
        "text": "アルビーナ",
        "localizations": {
          "en": "Alvina"
        }
      }
    }
  },
  {
    "id": 15,
    "properties": {
      "999008199": {
        "text": "あっ、ごめんなさい……！\nでも……ふふっ、マリーたちの勝ちですね",
        "localizations": {
          "en": "Oh, sorry...! But... hehe, looks like we win."
        }
      },
      "2072370017": {
        "text": "マリー・ローズ",
        "localizations": {
          "en": "Marie Rose"
        }
      }
    }
  },
  {
    "id": 16,
    "properties": {
      "999008199": {
        "text": "わあ……お二人とも、さすがです！",
        "localizations": {
          "en": "Wow... You two are amazing!"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 17,
    "properties": {
      "999008199": {
        "text": "えへへ～、やったあ",
        "localizations": {
          "en": "Ehehe, we did it!"
        }
      },
      "2072370017": {
        "text": "ほのか",
        "localizations": {
          "en": "Honoka"
        }
      }
    }
  },
  {
    "id": 18,
    "properties": {
      "999008199": {
        "text": "いたた……ちょっとは心配してくれても……",
        "localizations": {
          "en": "Ow ow... You could at least be a little concerned..."
        }
      },
      "2072370017": {
        "text": "アルビーナ",
        "localizations": {
          "en": "Alvina"
        }
      }
    }
  },
  {
    "id": 19,
    "properties": {
      "999008199": {
        "text": "でも、二人ともとっても強いし、かわいい！\nアタシにもその技、教えてください！",
        "localizations": {
          "en": "But wow, you two are so strong and cute! You've got to teach me those moves!"
        }
      },
      "2072370017": {
        "text": "アルビーナ",
        "localizations": {
          "en": "Alvina"
        }
      }
    }
  },
  {
    "id": 20,
    "properties": {
      "999008199": {
        "text": "ふふっ、いいですよ。マリーが特訓してあげます",
        "localizations": {
          "en": "Hehe, sure thing. Marie will give you some special training."
        }
      },
      "2072370017": {
        "text": "マリー・ローズ",
        "localizations": {
          "en": "Marie Rose"
        }
      }
    }
  },
  {
    "id": 21,
    "properties": {
      "999008199": {
        "text": "……なんだろう。大変な予感",
        "localizations": {
          "en": "...Something tells me I'm in for a rough time."
        }
      },
      "2072370017": {
        "text": "アルビーナ",
        "localizations": {
          "en": "Alvina"
        }
      }
    }
  },
  {
    "id": 22,
    "properties": {
      "999008199": {
        "text": "それにしても、こんな強い人たちが\nわんさかいるんでしょうか",
        "localizations": {
          "en": "Still, if there are tons of people this strong competing..."
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 23,
    "properties": {
      "999008199": {
        "text": "私の運動神経じゃ、優勝は夢のまた夢です……",
        "localizations": {
          "en": "With my athletic ability, winning is nothing but a pipe dream..."
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 24,
    "properties": {
      "999008199": {
        "text": "アタシたちの世界と常識が違うから、錬金術とかは\nあまり見せないほうがいいって言われちゃったしなあ",
        "localizations": {
          "en": "Since the rules are so different from our world, they told us we should probably avoid showing off too much alchemy."
        }
      },
      "2072370017": {
        "text": "アルビーナ",
        "localizations": {
          "en": "Alvina"
        }
      }
    }
  },
  {
    "id": 25,
    "properties": {
      "999008199": {
        "text": "きっと二人にとっては、錬金術があるのが\n当たり前なんですね",
        "localizations": {
          "en": "I guess for you two, having alchemy is just natural."
        }
      },
      "2072370017": {
        "text": "ほのか",
        "localizations": {
          "en": "Honoka"
        }
      }
    }
  },
  {
    "id": 26,
    "properties": {
      "999008199": {
        "text": "ゲームなら錬金術とかいっぱい使えるんだけどなあ～",
        "localizations": {
          "en": "If this were a game, you could use all sorts of alchemy..."
        }
      },
      "2072370017": {
        "text": "ほのか",
        "localizations": {
          "en": "Honoka"
        }
      }
    }
  },
  {
    "id": 27,
    "properties": {
      "999008199": {
        "text": "うーん、オーナーさんに頼んだら、\nゲームの技が現実で使えたりしないかなぁ……",
        "localizations": {
          "en": "Hmm, I wonder if the Owner could make game skills work in real life..."
        }
      },
      "2072370017": {
        "text": "ほのか",
        "localizations": {
          "en": "Honoka"
        }
      }
    }
  },
  {
    "id": 28,
    "properties": {
      "999008199": {
        "text": "もー、いくらオーナーさんでも、\nゲームを現実にってそんなこと……",
        "localizations": {
          "en": "Come on, even the Owner couldn't turn a game into reality like that..."
        }
      },
      "2072370017": {
        "text": "マリー・ローズ",
        "localizations": {
          "en": "Marie Rose"
        }
      }
    }
  },
  {
    "id": 29,
    "properties": {
      "999008199": {
        "text": "待って、ゲーム……もしかしたら……！\n少し時間をください！",
        "localizations": {
          "en": "Wait, a game... Maybe...! Give me a moment!"
        }
      },
      "2072370017": {
        "text": "マリー・ローズ",
        "localizations": {
          "en": "Marie Rose"
        }
      }
    }
  },
  {
    "id": 30,
    "properties": {
      "999008199": {
        "text": "マリー、どうしたんだろ……？",
        "localizations": {
          "en": "What's gotten into Marie...?"
        }
      },
      "2072370017": {
        "text": "アルビーナ",
        "localizations": {
          "en": "Alvina"
        }
      }
    }
  },
  {
    "id": 31,
    "properties": {
      "999008199": {
        "text": "さあ……？",
        "localizations": {
          "en": "Who knows...?"
        }
      },
      "2072370017": {
        "text": "ほのか",
        "localizations": {
          "en": "Honoka"
        }
      }
    }
  },
  {
    "id": 32,
    "properties": {
      "999008199": {
        "text": "お待たせしました！\u3000いい案を思いついたから、\nできそうかエレナ様に相談してきたんです",
        "localizations": {
          "en": "Sorry for the wait! I thought of a good idea, so I asked Lady Elena if it would work."
        }
      },
      "2072370017": {
        "text": "マリー・ローズ",
        "localizations": {
          "en": "Marie Rose"
        }
      }
    }
  },
  {
    "id": 33,
    "properties": {
      "999008199": {
        "text": "いい案……とな？",
        "localizations": {
          "en": "A good idea...?"
        }
      },
      "2072370017": {
        "text": "アルビーナ",
        "localizations": {
          "en": "Alvina"
        }
      }
    }
  },
  {
    "id": 34,
    "properties": {
      "999008199": {
        "text": "今回のフェスはネットの配信だけにするんです。\nオーナーさんも、それもおもしろそうだって",
        "localizations": {
          "en": "We'll make this festival online-only. The Owner said that sounded interesting too."
        }
      },
      "2072370017": {
        "text": "マリー・ローズ",
        "localizations": {
          "en": "Marie Rose"
        }
      }
    }
  },
  {
    "id": 35,
    "properties": {
      "999008199": {
        "text": "これなら、錬金術で不思議なことが起きても\nゲームみたいなＣＧだってごまかせます",
        "localizations": {
          "en": "That way, even if something strange happens with alchemy, we can just say it's CG from a game."
        }
      },
      "2072370017": {
        "text": "マリー・ローズ",
        "localizations": {
          "en": "Marie Rose"
        }
      }
    }
  },
  {
    "id": 36,
    "properties": {
      "999008199": {
        "text": "レスナさんやアルビーナさんも本気を出せるし、\nきっとフェスを見てくれる人も増えるかも",
        "localizations": {
          "en": "Resna and Alvina can go all out, and it might even bring in more viewers for the festival."
        }
      },
      "2072370017": {
        "text": "マリー・ローズ",
        "localizations": {
          "en": "Marie Rose"
        }
      }
    }
  },
  {
    "id": 37,
    "properties": {
      "999008199": {
        "text": "げーむ……ＣＧ？",
        "localizations": {
          "en": "Game... CG?"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 38,
    "properties": {
      "999008199": {
        "text": "よくわからないけど、それでなら全力を\n出せるってことね！",
        "localizations": {
          "en": "I don't really get it, but this means we can give it our all, right?"
        }
      },
      "2072370017": {
        "text": "アルビーナ",
        "localizations": {
          "en": "Alvina"
        }
      }
    }
  },
  {
    "id": 39,
    "properties": {
      "999008199": {
        "text": "私たちのために、ありがとうございます！",
        "localizations": {
          "en": "Thank you so much for doing this for us!"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 40,
    "properties": {
      "999008199": {
        "text": "配信なら、遠く離れた人にも見てもらえますよ～",
        "localizations": {
          "en": "With a stream, people far away can watch too!"
        }
      },
      "2072370017": {
        "text": "ほのか",
        "localizations": {
          "en": "Honoka"
        }
      }
    }
  },
  {
    "id": 41,
    "properties": {
      "999008199": {
        "text": "もしかしたら、レスナちゃんたちのことを\n知ってる人に届くかも！",
        "localizations": {
          "en": "Maybe someone who knows you will see it!"
        }
      },
      "2072370017": {
        "text": "ほのか",
        "localizations": {
          "en": "Honoka"
        }
      }
    }
  },
  {
    "id": 42,
    "properties": {
      "999008199": {
        "text": "なるほど……そういうものなのですね！\nであれば、気付いてもらえるよう、一層頑張ります！",
        "localizations": {
          "en": "I see... So that's how it works! In that case, I'll work even harder so people notice us!"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  }
]