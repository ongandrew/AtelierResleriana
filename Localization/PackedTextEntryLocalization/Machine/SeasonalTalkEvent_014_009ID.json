[
  {
    "id": 0,
    "properties": {
      "999008199": {
        "text": "それじゃあ、胸を借りるつもりで行くよ！\u3000",
        "localizations": {
          "en": "All right then, let's give this our best shot!"
        }
      },
      "2072370017": {
        "text": "アルビーナ",
        "localizations": {
          "en": "Alvina"
        }
      }
    }
  },
  {
    "id": 1,
    "properties": {
      "999008199": {
        "text": "は～い！",
        "localizations": {
          "en": "Okay!"
        }
      },
      "2072370017": {
