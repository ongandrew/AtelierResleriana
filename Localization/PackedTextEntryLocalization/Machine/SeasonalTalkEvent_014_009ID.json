        "text": "マリー・ローズ",
        "localizations": {
          "en": "Marie Rose"
        }
      }
    }
  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "で、では……",
        "localizations": {
          "en": "All right then..."
        }
