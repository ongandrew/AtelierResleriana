      "2072370017": {
        "text": "アルビーナ",
        "localizations": {
          "en": "Alvina"
        }
      }
    }
  },
  {
    "id": 15,
    "properties": {
      "999008199": {
        "text": "姉様の顔がこんなに近くに……！",
        "localizations": {
