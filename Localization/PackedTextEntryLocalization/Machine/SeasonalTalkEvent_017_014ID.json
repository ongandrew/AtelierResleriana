[
  {
    "id": 0,
    "properties": {
      "999008199": {
        "text": "えへへ！\u3000ワクワクしますね！",
        "localizations": {
          "en": "Ehehe! This is so exciting!"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 1,
    "properties": {
      "999008199": {
        "text": "残念でした！\u3000私が勝ってみせるわよ！",
        "localizations": {
          "en": "Too bad for you! I'm going to win this!"
        }
      },
      "2072370017": {
        "text": "ヨハナ",
        "localizations": {
          "en": "Johanna"
        }
      }
    }
  },
  {
    "id": 2,
    "properties": {
      "999008199": {
        "text": "御前試合はなんだかんだ出場しそびれちゃったし、\n思いっきり体を動かしたいよね",
        "localizations": {
          "en": "I ended up missing the tournament, so I really want to get some exercise in!"
        }
      },
      "2072370017": {
        "text": "ライザ",
        "localizations": {
          "en": "Ryza"
        }
      }
    }
  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "あんた欲がないわね。どうせなら、ぶっち切りで\n勝つとかなんとか言いなさいよ",
        "localizations": {
          "en": "You lack ambition. If you're going to do this, at least say you're going to win by a landslide or something."
        }
      },
      "2072370017": {
        "text": "ウィルベル",
        "localizations": {
          "en": "Wilbell"
        }
      }
    }
  },
  {
    "id": 4,
    "properties": {
      "999008199": {
        "text": "（いよいよだ。落ち着け、アルビちゃん！）",
        "localizations": {
          "en": "(This is it. Stay calm, Alvie!)"
        }
      },
      "2072370017": {
        "text": "アルビーナ",
        "localizations": {
          "en": "Alvina"
        }
      }
    }
  },
  {
    "id": 5,
    "properties": {
      "999008199": {
        "text": "気合入ってるみたいだね～",
        "localizations": {
          "en": "You seem pretty fired up."
        }
      },
      "2072370017": {
        "text": "シトリン",
        "localizations": {
          "en": "Citrine"
        }
      }
    }
  },
  {
    "id": 6,
    "properties": {
      "999008199": {
        "text": "げっ。新年早々厄が出た",
        "localizations": {
          "en": "Ugh. Running into bad luck on New Year's already."
        }
      },
      "2072370017": {
        "text": "アルビーナ",
        "localizations": {
          "en": "Alvina"
        }
      }
    }
  },
  {
    "id": 7,
    "properties": {
      "999008199": {
        "text": "ひどいなぁ。で、君の足で勝てるわけ？",
        "localizations": {
          "en": "How harsh. So, think you can win with those legs of yours?"
        }
      },
      "2072370017": {
        "text": "シトリン",
        "localizations": {
          "en": "Citrine"
        }
      }
    }
  },
  {
    "id": 8,
    "properties": {
      "999008199": {
        "text": "は？\u3000アタシの足が遅いって！？",
        "localizations": {
          "en": "Huh? Are you saying I'm slow?!"
        }
      },
      "2072370017": {
        "text": "アルビーナ",
        "localizations": {
          "en": "Alvina"
        }
      }
    }
  },
  {
    "id": 9,
    "properties": {
      "999008199": {
        "text": "でもお生憎様。アタシは頭を使って勝つんだからね！",
        "localizations": {
          "en": "Well, too bad for you. I'm winning with my brain, not my legs!"
        }
      },
      "2072370017": {
        "text": "アルビーナ",
        "localizations": {
          "en": "Alvina"
        }
      }
    }
  },
  {
    "id": 10,
    "properties": {
      "999008199": {
        "text": "へぇ。自信ありそうだね～",
        "localizations": {
          "en": "Oh? You sound confident."
        }
      },
      "2072370017": {
        "text": "シトリン",
        "localizations": {
          "en": "Citrine"
        }
      }
    }
  },
  {
    "id": 11,
    "properties": {
      "999008199": {
        "text": "そりゃぁ……",
        "localizations": {
          "en": "Of course I..."
        }
      },
      "2072370017": {
        "text": "アルビーナ",
        "localizations": {
          "en": "Alvina"
        }
      }
    }
  },
  {
    "id": 12,
    "properties": {
      "999008199": {
        "text": "あ、そろそろ始まる！\u3000アンタも応援してよね！",
        "localizations": {
          "en": "Oh, it's about to start! You better cheer for me!"
        }
      },
      "2072370017": {
        "text": "アルビーナ",
        "localizations": {
          "en": "Alvina"
        }
      }
    }
  },
  {
    "id": 13,
    "properties": {
      "999008199": {
        "text": "頑張れ、レスナちゃーん！",
        "localizations": {
          "en": "Go, Resna!"
        }
      },
      "2072370017": {
        "text": "イザナ",
        "localizations": {
          "en": "Izana"
        }
      }
    }
  },
  {
    "id": 14,
    "properties": {
      "999008199": {
        "text": "みんなやる気ね。私も出ればよかったかしら！",
        "localizations": {
          "en": "Everyone's so motivated. Maybe I should've entered too!"
        }
      },
      "2072370017": {
        "text": "ヴァレリア",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 15,
    "properties": {
      "999008199": {
        "text": "うぅ……誰が一番になるんだろう！",
        "localizations": {
          "en": "Ohhh... I wonder who's going to win!"
        }
      },
      "2072370017": {
        "text": "ロロナ",
        "localizations": {
          "en": "Rorona"
        }
      }
    }
  },
  {
    "id": 16,
    "properties": {
      "999008199": {
        "text": "レスナ……",
        "localizations": {
          "en": "Resna..."
        }
      },
      "2072370017": {
        "text": "アルビーナ",
        "localizations": {
          "en": "Alvina"
        }
      }
    }
  },
  {
    "id": 17,
    "properties": {
      "999008199": {
        "text": "（レスナには、いつも助けられてきた）",
        "localizations": {
          "en": "(She's always been there for me.)"
        }
      },
      "2072370017": {
        "text": "アルビーナ",
        "localizations": {
          "en": "Alvina"
        }
      }
    }
  },
  {
    "id": 18,
    "properties": {
      "999008199": {
        "text": "（強くて、優しくて、ホントに頼りになる人）",
        "localizations": {
          "en": "(Strong, kind, and someone I can really count on.)"
        }
      },
      "2072370017": {
        "text": "アルビーナ",
        "localizations": {
          "en": "Alvina"
        }
      }
    }
  },
  {
    "id": 19,
    "properties": {
      "999008199": {
        "text": "（だからこそ、今回は勝ちたい！）",
        "localizations": {
          "en": "(That's exactly why I want to win this time!)"
        }
      },
      "2072370017": {
        "text": "アルビーナ",
        "localizations": {
          "en": "Alvina"
        }
      }
    }
  },
  {
    "id": 20,
    "properties": {
      "999008199": {
        "text": "（絶対、負けられないんだ。だって）",
        "localizations": {
          "en": "(I absolutely can't lose. Because...)"
        }
      },
      "2072370017": {
        "text": "アルビーナ",
        "localizations": {
          "en": "Alvina"
        }
      }
    }
  },
  {
    "id": 21,
    "properties": {
      "999008199": {
        "text": "（これからも、アタシらしくレスナの隣に立つための\n\u3000意地がかかってるんだから！）",
        "localizations": {
          "en": "(My pride is on the line—the pride that lets me stand beside her as myself!)"
        }
      },
      "2072370017": {
        "text": "アルビーナ",
        "localizations": {
          "en": "Alvina"
        }
      }
    }
  },
  {
    "id": 22,
    "properties": {
      "999008199": {
        "text": "「福迎え」、始め！",
        "localizations": {
          "en": "Let the Blessing Race begin!"
        }
      },
      "2072370017": {
        "text": "鏑矢",
        "localizations": {
          "en": "Kaburaya"
        }
      }
    }
  },
  {
    "id": 23,
    "properties": {
      "999008199": {
        "text": "行くよ、ベップ！",
        "localizations": {
          "en": "Let's go, Bepp!"
        }
      },
      "2072370017": {
        "text": "アルビーナ",
        "localizations": {
          "en": "Alvina"
        }
      }
    }
  },
  {
    "id": 24,
    "properties": {
      "999008199": {
        "text": "はい、姉様！",
        "localizations": {
          "en": "Right behind you!"
        }
      },
      "2072370017": {
        "text": "ベップ",
        "localizations": {
          "en": "Bepp"
        }
      }
    }
  },
  {
    "id": 25,
    "properties": {
      "999008199": {
        "text": "嘘ぉ！？\u3000あんなのアリなの！？",
        "localizations": {
          "en": "No way! That's allowed?!"
        }
      },
      "2072370017": {
        "text": "イザナ",
        "localizations": {
          "en": "Izana"
        }
      }
    }
  },
  {
    "id": 26,
    "properties": {
      "999008199": {
        "text": "動じるな！\u3000「福迎え」の規約上、なんら問題はない！",
        "localizations": {
          "en": "Do not waver! Under the Blessing Race regulations, there is no issue whatsoever!"
        }
      },
      "2072370017": {
        "text": "鏑矢",
        "localizations": {
          "en": "Kaburaya"
        }
      }
    }
  },
  {
    "id": 27,
    "properties": {
      "999008199": {
        "text": "皆の勇姿、しかと見届けようではないか！",
        "localizations": {
          "en": "Now let us bear witness to their valiant efforts!"
        }
      },
      "2072370017": {
        "text": "鏑矢",
        "localizations": {
          "en": "Kaburaya"
        }
      }
    }
  }
]