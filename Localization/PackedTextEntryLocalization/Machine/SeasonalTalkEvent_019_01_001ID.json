  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "（みんなを楽しませたいという夢）",
        "localizations": {
          "en": "(A dream of bringing joy to everyone.)"
        }
      },
      "2072370017": {
        "text": "イザナ",
        "localizations": {
          "en": "Izana"
        }
      }
    }
  },
  {
    "id": 4,
    "properties": {
      "999008199": {
        "text": "（世界一のアイドルになるという夢）",
        "localizations": {
          "en": "(A dream of becoming the world's greatest idol.)"
        }
      },
      "2072370017": {
        "text": "ヨハナ",
        "localizations": {
          "en": "Johanna"
        }
      }
    }
  },
  {
    "id": 5,
    "properties": {
      "999008199": {
        "text": "（新しい自分になるという夢）",
        "localizations": {
          "en": "(A dream of becoming someone new.)"
        }
      },
      "2072370017": {
        "text": "鬼門",
        "localizations": {
          "en": "Kimon"
        }
      }
    }
  },
  {
    "id": 6,
    "properties": {
      "999008199": {
        "text": "（色とりどりの光が輝くステージで）",
        "localizations": {
          "en": "(On a stage where brilliant lights of every color shine—)"
        }
      },
      "2072370017": {
        "text": "イザナ",
        "localizations": {
          "en": "Izana"
        }
      }
    }
  },
  {
    "id": 7,
    "properties": {
      "999008199": {
        "text": "（私たちアイドルは、夢を見て）",
        "localizations": {
          "en": "(We idols dream our dreams.)"
        }
      },
      "2072370017": {
        "text": "ヨハナ",
        "localizations": {
          "en": "Johanna"
        }
      }
    }
  },
  {
    "id": 8,
    "properties": {
      "999008199": {
        "text": "（観客のみんなに夢を見せる）",
        "localizations": {
          "en": "(And share those dreams with our audience.)"
        }
      },
      "2072370017": {
        "text": "鬼門",
        "localizations": {
          "en": "Kimon"
        }
      }
    }
  },
  {
    "id": 9,
    "properties": {
      "999008199": {
        "text": "頑張ってね、みんな！",
        "localizations": {
          "en": "Do your best, everyone!"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 10,
    "properties": {
      "999008199": {
        "text": "あなたたちの歌と踊りで、\n観客を沸かせてみせなさい！",
        "localizations": {
          "en": "Captivate the audience with your singing and dancing!"
        }
      },
      "2072370017": {
        "text": "ララ",
        "localizations": {
          "en": "Lara"
        }
      }
    }
  },
  {
    "id": 11,
    "properties": {
      "999008199": {
        "text": "では、参ろうか！\u3000一世一代の大勝負に！",
        "localizations": {
          "en": "Then let us begin! The performance of a lifetime!"
        }
      },
      "2072370017": {
        "text": "鬼門",
        "localizations": {
          "en": "Kimon"
        }
      }
    }
  },
  {
    "id": 12,
    "properties": {
      "999008199": {
        "text": "いつも通りやるだけよ。\nだって、私はいつも完璧なんだから",
        "localizations": {
          "en": "I'll just do what I always do. After all, I'm always perfect."
        }
      },
      "2072370017": {
        "text": "ヨハナ",
        "localizations": {
          "en": "Johanna"
        }
      }
    }
  },
  {
    "id": 13,
    "properties": {
      "999008199": {
        "text": "目いっぱい盛り上げていこー！\u3000おー！",
        "localizations": {
          "en": "Let's get this crowd going! Yeah!"
        }
      },
      "2072370017": {
        "text": "イザナ",
        "localizations": {
          "en": "Izana"
        }
      }
    }
  },
