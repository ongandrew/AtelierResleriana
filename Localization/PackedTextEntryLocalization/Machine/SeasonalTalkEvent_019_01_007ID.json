[
  {
    "id": 0,
    "properties": {
      "999008199": {
        "text": "皆様、はじめまして！",
        "localizations": {
          "en": "Nice to meet you, everyone!"
        }
      },
      "2072370017": {
        "text": "鬼門",
        "localizations": {
          "en": "Kimon"
        }
      }
    }
  },
  {
    "id": 1,
    "properties": {
      "999008199": {
        "text": "拙者らは、本日デビューの新アイドルユニット、\n『Ｃｕｔｉｅ☆ＡｎｉｍａＬ』でございまする！",
        "localizations": {
          "en": "We are the newly debuted idol unit, Cutie☆AnimaL!"
        }
      },
      "2072370017": {
        "text": "鬼門",
        "localizations": {
          "en": "Kimon"
        }
      }
    }
  },
  {
    "id": 2,
    "properties": {
      "999008199": {
        "text": "よろしくお願いします！",
        "localizations": {
          "en": "We look forward to your support!"
        }
      },
      "2072370017": {
        "text": "三人",
        "localizations": {
          "en": "Group"
        }
      }
    }
  },
  {
