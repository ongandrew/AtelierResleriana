    "id": 0,
    "properties": {
      "999008199": {
        "text": "こんにちはー！\u3000今日は拙者らのライブに\n来てくれて、ありがとうございます！",
        "localizations": {
          "en": "Hello! Thank you all so much for coming to our live show today!"
        }
      },
      "2072370017": {
        "text": "鬼門",
        "localizations": {
          "en": "Kimon"
        }
      }
    }
  },
  {
    "id": 1,
    "properties": {
      "999008199": {
        "text": "ありがとうございます！",
        "localizations": {
