  {
    "id": 24,
    "properties": {
      "999008199": {
        "text": "（みんなの夢はなに？）",
        "localizations": {
          "en": "(What do you dream of?)"
        }
      },
      "2072370017": {
        "text": "イザナ",
        "localizations": {
          "en": "Izana"
        }
      }
    }
  },
  {
    "id": 25,
    "properties": {
      "999008199": {
        "text": "（光なんて１つもないステージでも）",
        "localizations": {
          "en": "(Even on a stage with not a single light—)"
        }
      },
      "2072370017": {
        "text": "ヨハナ",
        "localizations": {
          "en": "Johanna"
        }
      }
    }
  },
  {
    "id": 26,
    "properties": {
