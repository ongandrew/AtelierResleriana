[
  {
    "id": 0,
    "properties": {
      "999008199": {
        "text": "ふう……片付いたわね",
        "localizations": {
          "en": "Phew... that takes care of them."
        }
      },
      "2072370017": {
        "text": "ヨハナ",
        "localizations": {
          "en": "Johanna"
        }
      }
    }
  },
  {
    "id": 1,
    "properties": {
      "999008199": {
        "text": "今のところ何も変わったことは\n起こってないみたいだけど……",
        "localizations": {
          "en": "Nothing unusual seems to have happened so far..."
        }
      },
      "2072370017": {
        "text": "イルメリア",
        "localizations": {
          "en": "Ilmeria"
        }
      }
    }
  },
  {
    "id": 2,
    "properties": {
      "999008199": {
        "text": "一度村に戻ってみましょう",
        "localizations": {
          "en": "Let's head back to the village for now."
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "皆さん！\u3000狼の魔物は倒しましたよ！",
        "localizations": {
          "en": "Everyone! We defeated the wolf monsters!"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 4,
    "properties": {
      "999008199": {
        "text": "レスナちゃーん！",
        "localizations": {
          "en": "Resna!"
        }
      },
      "2072370017": {
        "text": "ロロナ",
        "localizations": {
          "en": "Rorona"
        }
      }
    }
  },
  {
    "id": 5,
    "properties": {
      "999008199": {
        "text": "ロロナ先輩方！",
        "localizations": {
          "en": "Miss Rorona and everyone!"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 6,
    "properties": {
      "999008199": {
        "text": "こちらも魔物の親玉を無事倒したぞ",
        "localizations": {
          "en": "We also successfully defeated the monster leader."
        }
      },
      "2072370017": {
        "text": "ステルク",
        "localizations": {
          "en": "Sterk"
        }
      }
    }
  },
  {
    "id": 7,
    "properties": {
      "999008199": {
        "text": "これでもう安全です！",
        "localizations": {
          "en": "It's safe now!"
        }
      },
      "2072370017": {
        "text": "トトリ",
        "localizations": {
          "en": "Totori"
        }
      }
    }
  },
  {
    "id": 8,
    "properties": {
      "999008199": {
        "text": "おぉ……。ありがたい……！\nこれで探索の範囲が広がる！",
        "localizations": {
          "en": "Oh...! Thank you so much! Now we can explore beyond the village confines!"
        }
      },
      "2072370017": {
        "text": "村の男",
        "localizations": {
          "en": "Village Man"
        }
      }
    }
  },
  {
    "id": 9,
    "properties": {
      "999008199": {
        "text": "あっ、そのことなんですけど……",
        "localizations": {
          "en": "Oh, about that..."
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 10,
    "properties": {
      "999008199": {
        "text": "えっ、ちょっと、なに……？",
        "localizations": {
          "en": "Huh? Wait, what...?"
        }
      },
      "2072370017": {
        "text": "ヨハナ",
        "localizations": {
          "en": "Johanna"
        }
      }
    }
  },
  {
    "id": 11,
    "properties": {
      "999008199": {
        "text": "もしかして……！\nヨハナちゃん、その本開いてみて！",
        "localizations": {
          "en": "Could it be...! Johanna, try opening that book!"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 12,
    "properties": {
      "999008199": {
        "text": "わ、分かった……",
        "localizations": {
          "en": "O-okay..."
        }
      },
      "2072370017": {
        "text": "ヨハナ",
        "localizations": {
          "en": "Johanna"
        }
      }
    }
  },
  {
    "id": 13,
    "properties": {
      "999008199": {
        "text": "この光……。\nアタシたちがこっちへ来たときのと似てる？",
        "localizations": {
          "en": "This light... it's similar to when we came here, isn't it?"
        }
      },
      "2072370017": {
        "text": "イザナ",
        "localizations": {
          "en": "Izana"
        }
      }
    }
  },
  {
    "id": 14,
    "properties": {
      "999008199": {
        "text": "ひょっとして、これが出口じゃないのかしら！？\n物語通りに魔物も倒したし！",
        "localizations": {
          "en": "Could this be the exit?! We defeated the monsters just like in the story!"
        }
      },
      "2072370017": {
        "text": "イルメリア",
        "localizations": {
          "en": "Ilmeria"
        }
      }
    }
  },
  {
    "id": 15,
    "properties": {
      "999008199": {
        "text": "試しにくぐってみたら分かるでしょ",
        "localizations": {
          "en": "We'll find out if we try going through it."
        }
      },
      "2072370017": {
        "text": "ヴァレリア",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 16,
    "properties": {
      "999008199": {
        "text": "あ、ちょ！\u3000ヴァレリア！",
        "localizations": {
          "en": "Ah, wait! Valeria!"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 17,
    "properties": {
      "999008199": {
        "text": "き、消えた！？",
        "localizations": {
          "en": "Sh-she disappeared?!"
        }
      },
      "2072370017": {
        "text": "ソフィー",
        "localizations": {
          "en": "Sophie"
        }
      }
    }
  },
  {
    "id": 18,
    "properties": {
      "999008199": {
        "text": "……ただいま！",
        "localizations": {
          "en": "...I'm back!"
        }
      },
      "2072370017": {
        "text": "ヴァレリア",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 19,
    "properties": {
      "999008199": {
        "text": "戻ってきた！？",
        "localizations": {
          "en": "She came back?!"
        }
      },
      "2072370017": {
        "text": "イザナ",
        "localizations": {
          "en": "Izana"
        }
      }
    }
  },
  {
    "id": 20,
    "properties": {
      "999008199": {
        "text": "これ、外に通じてるわよ！\n外にある本が出口になってるみたい",
        "localizations": {
          "en": "This leads outside! It looks like the book outside is the exit."
        }
      },
      "2072370017": {
        "text": "ヴァレリア",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 21,
    "properties": {
      "999008199": {
        "text": "やったー！\u3000じゃあこれでみんな元の世界へ帰れるね！",
        "localizations": {
          "en": "Yay! Now everyone can return to their own world!"
        }
      },
      "2072370017": {
        "text": "ソフィー",
        "localizations": {
          "en": "Sophie"
        }
      }
    }
  },
  {
    "id": 22,
    "properties": {
      "999008199": {
        "text": "あぁ……、あなたがたにはなんとお礼を申したら……！",
        "localizations": {
          "en": "Oh... how can we ever thank you...!"
        }
      },
      "2072370017": {
        "text": "村の女",
        "localizations": {
          "en": "Village Woman"
        }
      }
    }
  },
  {
    "id": 23,
    "properties": {
      "999008199": {
        "text": "いいってそんなこと。それより早く行きましょ、\n私についてきて！",
        "localizations": {
          "en": "Don't worry about it. More importantly, let's get going. Follow me!"
        }
      },
      "2072370017": {
        "text": "ヴァレリア",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 24,
    "properties": {
      "999008199": {
        "text": "ゆっくりで大丈夫ですからねー！",
        "localizations": {
          "en": "Take your time, there's no rush!"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 25,
    "properties": {
      "999008199": {
        "text": "今の人で最後みたいね",
        "localizations": {
          "en": "That looks like the last person."
        }
      },
      "2072370017": {
        "text": "ヨハナ",
        "localizations": {
          "en": "Johanna"
        }
      }
    }
  },
  {
    "id": 26,
    "properties": {
      "999008199": {
        "text": "じゃあ今度はアタシたちの番！",
        "localizations": {
          "en": "Now it's our turn!"
        }
      },
      "2072370017": {
        "text": "イザナ",
        "localizations": {
          "en": "Izana"
        }
      }
    }
  },
  {
    "id": 27,
    "properties": {
      "999008199": {
        "text": "本の中の世界とお別れはちょっと寂しいけど、\nロマンさんたちが心配しないよう、早く戻らないとね",
        "localizations": {
          "en": "It's a little sad saying goodbye to the world inside the book, but we need to get back quickly so Roman and the others don't worry."
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 28,
    "properties": {
      "999008199": {
        "text": "それじゃ、行くわよ！",
        "localizations": {
          "en": "All right then, let's go!"
        }
      },
      "2072370017": {
        "text": "イルメリア",
        "localizations": {
          "en": "Ilmeria"
        }
      }
    }
  },
  {
    "id": 29,
    "properties": {
      "999008199": {
        "text": "まだ何が起きるか分からない。\n私が殿を務めよう",
        "localizations": {
          "en": "We should be on our guard until we're all out. I'll bring up the rear."
        }
      },
      "2072370017": {
        "text": "ステルク",
        "localizations": {
          "en": "Sterk"
        }
      }
    }
  },
  {
    "id": 30,
    "properties": {
      "999008199": {
        "text": "じゃあわたしもステルクさんと一緒に\n最後にくぐりますね",
        "localizations": {
          "en": "Then I'll go through last with you too, Sterk."
        }
      },
      "2072370017": {
        "text": "ロロナ",
        "localizations": {
          "en": "Rorona"
        }
      }
    }
  },
  {
    "id": 31,
    "properties": {
      "999008199": {
        "text": "ふふっ。すっかり騎士とお姫様よね",
        "localizations": {
          "en": "Hehe. You two really are like a knight and princess."
        }
      },
      "2072370017": {
        "text": "ミミ",
        "localizations": {
          "en": "Mimi"
        }
      }
    }
  },
  {
    "id": 32,
    "properties": {
      "999008199": {
        "text": "うん。でもステルクさんと一緒なら安心かな",
        "localizations": {
          "en": "Yeah. But I feel safe knowing she's with Sterk."
        }
      },
      "2072370017": {
        "text": "トトリ",
        "localizations": {
          "en": "Totori"
        }
      }
    }
  },
  {
    "id": 33,
    "properties": {
      "999008199": {
        "text": "ステルクさん。じゃあわたしたちも……えっ",
        "localizations": {
          "en": "Sterk, shall we go too... huh?"
        }
      },
      "2072370017": {
        "text": "ロロナ",
        "localizations": {
          "en": "Rorona"
        }
      }
    }
  },
  {
    "id": 34,
    "properties": {
      "999008199": {
        "text": "ひ、光が消えちゃった！？",
        "localizations": {
          "en": "Th-the light disappeared?!"
        }
      },
      "2072370017": {
        "text": "ロロナ",
        "localizations": {
          "en": "Rorona"
        }
      }
    }
  },
  {
    "id": 35,
    "properties": {
      "999008199": {
        "text": "ど、どうしようステルクさん！\n出口も閉じちゃったみたいですよ！",
        "localizations": {
          "en": "Wh-what should we do, Sterk! It looks like the exit closed too!"
        }
      },
      "2072370017": {
        "text": "ロロナ",
        "localizations": {
          "en": "Rorona"
        }
      }
    }
  },
  {
    "id": 36,
    "properties": {
      "999008199": {
        "text": "やはりな",
        "localizations": {
          "en": "As I expected."
        }
      },
      "2072370017": {
        "text": "ステルク",
        "localizations": {
          "en": "Sterk"
        }
      }
    }
  },
  {
    "id": 37,
    "properties": {
      "999008199": {
        "text": "「やはり」って、そんなに落ち着いてる場合じゃ……",
        "localizations": {
          "en": "What do you mean? This isn't the time to be so calm..."
        }
      },
      "2072370017": {
        "text": "ロロナ",
        "localizations": {
          "en": "Rorona"
        }
      }
    }
  },
  {
    "id": 38,
    "properties": {
      "999008199": {
        "text": "大丈夫だ。助けは来る",
        "localizations": {
          "en": "It's all right. Help will come."
        }
      },
      "2072370017": {
        "text": "ステルク",
        "localizations": {
          "en": "Sterk"
        }
      }
    }
  }
]