[
  {
    "id": 0,
    "properties": {
      "999008199": {
        "text": "ロロナ先輩！\u3000ステルクさん！",
        "localizations": {
          "en": "Miss Rorona! Sterk!"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 1,
    "properties": {
      "999008199": {
        "text": "レスナちゃん！\u3000みんな！\u3000来てくれたんだぁ！\nよかったぁ～！",
        "localizations": {
          "en": "Resna! Everyone! You came for us! Thank goodness!"
        }
      },
      "2072370017": {
        "text": "ロロナ",
        "localizations": {
          "en": "Rorona"
        }
      }
    }
  },
  {
    "id": 2,
    "properties": {
      "999008199": {
        "text": "だから言っただろう？",
        "localizations": {
          "en": "Didn't I tell you so?"
        }
      },
      "2072370017": {
        "text": "ステルク",
        "localizations": {
          "en": "Sterk"
        }
      }
    }
  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "アルビーナちゃんたちまで来てくれたんだね",
        "localizations": {
          "en": "Even Alvina and the others came to help us."
        }
      },
      "2072370017": {
        "text": "ロロナ",
        "localizations": {
          "en": "Rorona"
        }
      }
    }
  },
  {
    "id": 4,
    "properties": {
      "999008199": {
        "text": "そりゃ心配になりますよ。駆け付けたっす！",
        "localizations": {
          "en": "Of course! We were worried so we rushed right over!"
        }
      },
      "2072370017": {
        "text": "アルビーナ",
        "localizations": {
          "en": "Alvina"
        }
      }
    }
  },
  {
    "id": 5,
    "properties": {
      "999008199": {
        "text": "大体の事情はヴァレリアから聞いたわ",
        "localizations": {
          "en": "Valeria filled us in on most of what happened."
        }
      },
      "2072370017": {
        "text": "ベップ",
        "localizations": {
          "en": "Bepp"
        }
      }
    }
  },
  {
    "id": 6,
    "properties": {
      "999008199": {
        "text": "本から出られなくても、入ることはできるみたい\nだったからね。こうして入ってきたのよ",
        "localizations": {
          "en": "Even though you couldn't get out of the book, we could still return. So here we are."
        }
      },
      "2072370017": {
        "text": "ヴァレリア",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 7,
    "properties": {
      "999008199": {
        "text": "まずは何が起きているのかを確かめなければ……",
        "localizations": {
          "en": "First we need to figure out what's going on..."
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 8,
    "properties": {
      "999008199": {
        "text": "あ！\u3000また本が光った！",
        "localizations": {
          "en": "Oh! The book is glowing again!"
        }
      },
      "2072370017": {
        "text": "ロロナ",
        "localizations": {
          "en": "Rorona"
        }
      }
    }
  },
  {
    "id": 9,
    "properties": {
      "999008199": {
        "text": "よし。今度こそみんなで戻れるかもしれないわ。\n今のうちに行くわよ",
        "localizations": {
          "en": "All right. This time we might all be able to get out together. Let's go while we can."
        }
      },
      "2072370017": {
        "text": "ヴァレリア",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 10,
    "properties": {
      "999008199": {
        "text": "もうちょーっと本の中の世界って\n見てみたかったんだけどな～",
        "localizations": {
          "en": "I was kinda hoping to explore the world inside the book a little more though..."
        }
      },
      "2072370017": {
        "text": "アルビーナ",
        "localizations": {
          "en": "Alvina"
        }
      }
    }
  },
  {
    "id": 11,
    "properties": {
      "999008199": {
        "text": "あっ！",
        "localizations": {
          "en": "Ow!"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 12,
    "properties": {
      "999008199": {
        "text": "やっぱりダメだったみたいね",
        "localizations": {
          "en": "It looks like we won't be getting out the same way as last time."
        }
      },
      "2072370017": {
        "text": "ヴァレリア",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  }
]