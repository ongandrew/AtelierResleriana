[
  {
    "id": 0,
    "properties": {
      "999008199": {
        "text": "\u3075\u30FC\u2026\u2026\u5C11\u3057\u306F\u697D\u3057\u3081\u305F\u3051\u3069\u3001\u305D\u306E\u7A0B\u5EA6\uFF1F",
        "localizations": {
          "en": "Hmm... That was somewhat entertaining, but is that all?"
        }
      },
      "2072370017": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 1,
    "properties": {
      "999008199": {
        "text": "\u306D\u3048\u30CF\u30A4\u30C7\u30A3\u3001\u4ECA\u306E\u304C\u8A0E\u4F10\u5BFE\u8C61\u306E\u9B54\u7269\u3063\u3066\u308F\u3051\u3058\u3083\n\u306A\u3044\u308F\u3088\u306D\uFF1F",
        "localizations": {
          "en": "Hey Heidi, those weren\u0027t our actual target monsters, were they?"
        }
      },
      "2072370017": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 2,
    "properties": {
      "999008199": {
        "text": "\u3082\u3061\u308D\u3093\u3002\u304A\u697D\u3057\u307F\u306F\u307E\u3060\u307E\u3060\u3053\u308C\u304B\u3089\u3063\u3066\u3053\u3068\u3067",
        "localizations": {
          "en": "Of course not. The real fun\u0027s just getting started!"
