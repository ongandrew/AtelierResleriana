      "2072370017": {
        "text": "\u30CF\u30A4\u30C7\u30A3",
        "localizations": {
          "en": "Heidi"
        }
      }
    }
  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "\u5F85\u3061\u304D\u308C\u306A\u3044\u3002\u65E9\u304F\u65E9\u304F\u2026\u2026\uFF01",
        "localizations": {
          "en": "Can\u0027t wait. Let\u0027s go, let\u0027s go...!"
