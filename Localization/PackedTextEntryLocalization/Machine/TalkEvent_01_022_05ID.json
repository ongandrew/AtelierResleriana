      "2072370017": {
        "text": "\u30F4\u30A1\u30EC\u30EA\u30A2",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 4,
    "properties": {
      "999008199": {
        "text": "\u7126\u3089\u306A\u3044\uFF01\n\u4F53\u3082\u6E29\u307E\u3063\u3066\u3061\u3087\u3046\u3069\u3088\u304B\u3063\u305F\u3067\u3057\u3087\uFF1F",
        "localizations": {
          "en": "Don\u0027t rush! \nThat was a good warm-up, wasn\u0027t it?"
