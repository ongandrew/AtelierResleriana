      }
    }
  },
  {
    "id": 5,
    "properties": {
      "999008199": {
        "text": "\u305D\u308C\u306B\u6CB9\u65AD\u3057\u306A\u3044\u3067\u3088\u3002\n\u4F9D\u983C\u306E\u9B54\u7269\u306F\u76F8\u5F53\u5384\u4ECB\u306A\u3084\u3064\u307F\u305F\u3044\u3060\u3057",
