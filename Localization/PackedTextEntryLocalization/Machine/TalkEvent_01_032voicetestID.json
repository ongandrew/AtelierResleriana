      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 11,
    "properties": {
      "999008199": {
        "text": "\u305D\u3046\u306A\u306E\u304B\u3002\u3058\u3083\u3042\u76F8\u5F53\u8155\u306B\u81EA\u4FE1\u304C\u3042\u308B\u3063\u3066\u3053\u3068\u3060\u306A",
        "localizations": {
