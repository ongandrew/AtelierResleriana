      "2072370017": {
        "text": "\u30AA\u30B9\u30AB\u30FC",
        "localizations": {
          "en": "Oskar"
        }
      }
    }
  },
  {
    "id": 8,
    "properties": {
      "999008199": {
        "text": "\u3075\u3080\u3075\u3080\u2026\u2026\u3069\u3046\u3084\u3089\u6628\u65E5\u306E\u591C\u3001\u5973\u306E\u5B50\u306E\u4E8C\u4EBA\u7D44\u304C\n\u3053\u3053\u3067\u4E00\u66B4\u308C\u3057\u305F\u307F\u305F\u3044\u3060",
        "localizations": {
          "en": "I see, I see... Apparently two girls were causing\nquite a commotion here last night."
        }
      },
      "2072370017": {
        "text": "\u30AA\u30B9\u30AB\u30FC",
        "localizations": {
          "en": "Oskar"
        }
      }
    }
  },
  {
    "id": 9,
    "properties": {
      "999008199": {
        "text": "\u6628\u65E5\u306E\u591C\u2026\u2026",
