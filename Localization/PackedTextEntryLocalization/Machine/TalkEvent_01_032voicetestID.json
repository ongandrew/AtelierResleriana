      "2072370017": {
        "text": "\u30AA\u30B9\u30AB\u30FC",
        "localizations": {
          "en": "Oskar"
        }
      }
    }
  },
  {
    "id": 7,
    "properties": {
      "999008199": {
        "text": "\u2026\u2026\u3093\uFF1F\u3000\u73CD\u3057\u3044\u3053\u3068\u306A\u3089\u3042\u3063\u305F\uFF1F\n\u3044\u3063\u305F\u3044\u306A\u3093\u3060\u3044\uFF1F",
        "localizations": {
          "en": "...Hm? Something unusual happened?\nWhat was it?"
