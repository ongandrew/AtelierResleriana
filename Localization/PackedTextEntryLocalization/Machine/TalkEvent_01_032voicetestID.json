      }
    }
  },
  {
    "id": 10,
    "properties": {
      "999008199": {
        "text": "\u3053\u306E\u6E7F\u5730\u3063\u3066\u591C\u306B\u306A\u308B\u3068\u5F37\u3044\u9B54\u7269\u304C\u51FA\u308B\u3093\u3058\u3083\n\u3042\u308A\u307E\u305B\u3093\u3067\u3057\u305F\u3063\u3051\uFF1F",
        "localizations": {
          "en": "Aren\u0027t there supposed to be really strong monsters\nhere at night?"
