      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 6,
    "properties": {
      "999008199": {
        "text": "\u3057\u3063\u3001\u3061\u3087\u3063\u3068\u9759\u304B\u306B",
        "localizations": {
          "en": "Shh, keep it down a bit."
