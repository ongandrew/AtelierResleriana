  },
  {
    "id": 12,
    "properties": {
      "999008199": {
        "text": "\u3042\u308C\u3001\u30EC\u30B9\u30CA\u3061\u3083\u3093\uFF1F\u3000\u65E9\u304F\u5148\u884C\u304B\u306A\u3044\u306E\uFF1F",
