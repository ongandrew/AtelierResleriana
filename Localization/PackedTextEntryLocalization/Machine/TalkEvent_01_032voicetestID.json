[
  {
    "id": 0,
    "properties": {
      "999008199": {
        "text": "\u3075\u3046\u3001\u6628\u65E5\u3068\u540C\u3058\u5834\u6240\u307E\u3067\u306F\u6765\u3089\u308C\u307E\u3057\u305F\u306D",
        "localizations": {
          "en": "Phew, we\u0027ve made it back to the same spot as yesterday."
        }
      },
      "2072370017": {
        "text": "\u30EC\u30B9\u30CA",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 1,
    "properties": {
      "999008199": {
        "text": "\u3067\u3082\u3001\u4F9D\u983C\u306E\u690D\u7269\u306F\u3082\u3063\u3068\u5965\u307E\u3063\u305F\u5834\u6240\u3067\n\u898B\u304B\u3051\u305F\u3088\u3046\u3067\u3059\u306D",
        "localizations": {
          "en": "But I think the plant we\u0027re looking for was spotted\ndeeper inside..."
        }
      },
      "2072370017": {
        "text": "\u30B7\u30E3\u30EA\u30B9\u30C6\u30E9",
        "localizations": {
          "en": "Shallistera"
        }
      }
    }
  },
  {
    "id": 2,
    "properties": {
      "999008199": {
        "text": "\u3058\u3083\u3042\u65E9\u901F\u3001\u5965\u307E\u3067\u8ABF\u3079\u3066\u307F\u3088\u3046\uFF01",
        "localizations": {
          "en": "Then let\u0027s head deeper and check it out!"
        }
      },
      "2072370017": {
        "text": "\u30E9\u30A4\u30B6",
        "localizations": {
          "en": "Ryza"
        }
      }
    }
  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "\u307F\u3093\u306A\u3001\u4ECA\u65E5\u3082\u3088\u308D\u3057\u304F\u306A",
        "localizations": {
          "en": "Looking forward to working with you all today."
