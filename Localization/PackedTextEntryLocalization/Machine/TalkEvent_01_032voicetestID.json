      },
      "2072370017": {
        "text": "\u30AA\u30B9\u30AB\u30FC",
        "localizations": {
          "en": "Oskar"
        }
      }
    }
  },
  {
    "id": 4,
    "properties": {
      "999008199": {
        "text": "\u4ECA\u56DE\u306F\u3061\u3087\u3063\u3068\u73CD\u3057\u3044\u5B50\u3092\u63A2\u3057\u3066\u308B\u3093\u3060\u3002\n\u4F55\u304B\u77E5\u3063\u3066\u305F\u3089\u6559\u3048\u3066\u304A\u304F\u308C\u3088",
        "localizations": {
          "en": "We\u0027re looking for something quite rare this time.\nLet me know if you spot anything."
        }
      },
      "2072370017": {
        "text": "\u30AA\u30B9\u30AB\u30FC",
        "localizations": {
          "en": "Oskar"
        }
      }
    }
  },
  {
    "id": 5,
    "properties": {
      "999008199": {
        "text": "\u308F\u3042\u2026\u2026\u65E9\u901F\u3001\u690D\u7269\u3068\u4F1A\u8A71\u3057\u3066\u308B\u3093\u3067\u3059\u306D\uFF01",
        "localizations": {
          "en": "Wow... He\u0027s already talking with the plants!"
