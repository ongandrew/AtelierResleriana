[
  {
    "id": 0,
    "properties": {
      "999008199": {
        "text": "――来たのね、レスナ",
        "localizations": {
          "en": "So you've come, Resna."
        }
      },
      "2072370017": {
        "text": "ザスキア",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 1,
    "properties": {
      "999008199": {
        "text": "私たちの手を借りず外海を渡り切るための準備を終え、\n頂獣までをも倒して、ノーヴァ神聖国へ",
        "localizations": {
          "en": "You prepared to cross the outer seas without our help, even defeated an Apexi, and made it to the sacred lands of Nova."
        }
      },
      "2072370017": {
        "text": "ザスキア",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 2,
    "properties": {
      "999008199": {
        "text": "もっとも、私が手を回さなかったせいで、\n一部の仲間を欠いた状態ではあるけれど",
        "localizations": {
          "en": "You could have had more allies with my support..."
        }
      },
      "2072370017": {
        "text": "ザスキア",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "今のところは、よくやっているみたいね",
        "localizations": {
          "en": "But you seem to be managing well enough... for now."
        }
      },
      "2072370017": {
        "text": "ザスキア",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 4,
    "properties": {
      "999008199": {
        "text": "でも、これは果ての大陸への第一歩に過ぎない。\nこれからの旅、あなたに耐えられる？",
        "localizations": {
          "en": "This is just the first step toward World's End. Are you ready for what lies ahead?"
        }
      },
      "2072370017": {
        "text": "ザスキア",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 5,
    "properties": {
      "999008199": {
        "text": "戻りました",
        "localizations": {
          "en": "I've returned."
        }
      },
      "2072370017": {
        "text": "リーベ",
        "localizations": {
          "en": "Liebe"
        }
      }
    }
  },
  {
    "id": 6,
    "properties": {
      "999008199": {
        "text": "あら。ご苦労さま",
        "localizations": {
          "en": "Oh? Welcome back."
        }
      },
      "2072370017": {
        "text": "ザスキア",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 7,
    "properties": {
      "999008199": {
        "text": "「向こう」の準備は万全のようです。\n計画に変更はありません",
        "localizations": {
          "en": "Everything is ready on the other side. The plan is going smoothly."
        }
      },
      "2072370017": {
        "text": "リーベ",
        "localizations": {
          "en": "Liebe"
        }
      }
    }
  },
  {
    "id": 8,
    "properties": {
      "999008199": {
        "text": "そう。ありがと",
        "localizations": {
          "en": "I see. Thank you."
        }
      },
      "2072370017": {
        "text": "ザスキア",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 9,
    "properties": {
      "999008199": {
        "text": "行きましょう、母様",
        "localizations": {
          "en": "Are you ready, mother?"
        }
      },
      "2072370017": {
        "text": "ゴゥ",
        "localizations": {
          "en": "Gou"
        }
      }
    }
  },
  {
    "id": 10,
    "properties": {
      "999008199": {
        "text": "ええ",
        "localizations": {
          "en": "Yes."
        }
      },
      "2072370017": {
        "text": "ザスキア",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 11,
    "properties": {
      "999008199": {
        "text": "星の神の聖地――ノーヴァ神聖国へ",
        "localizations": {
          "en": "Nova—the sacred lands of the Star God."
        }
      },
      "2072370017": {
        "text": "ザスキア",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  }
]