        "text": "どうした？",
        "localizations": {
          "en": "What is it?"
        }
      },
      "2072370017": {
        "text": "ランツェ",
        "localizations": {
          "en": "Lanze"
        }
      }
    }
  },
  {
    "id": 17,
    "properties": {
