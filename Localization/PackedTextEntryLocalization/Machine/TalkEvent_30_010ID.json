      "2072370017": {
        "text": "ヘルト",
        "localizations": {
          "en": "Held"
        }
      }
    }
  },
  {
    "id": 12,
    "properties": {
      "999008199": {
        "text": "こんなのは拍子抜けもいいところだろ",
        "localizations": {
          "en": "This is a letdown, frankly."
