      "2072370017": {
        "text": "ヘルト",
        "localizations": {
          "en": "Held"
        }
      }
    }
  },
  {
    "id": 11,
    "properties": {
      "999008199": {
        "text": "今は、特に大きな災厄があるわけでもなし",
        "localizations": {
          "en": "But there's no great calamity to speak of right now."
