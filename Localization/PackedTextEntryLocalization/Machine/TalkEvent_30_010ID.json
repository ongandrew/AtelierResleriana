      "2072370017": {
        "text": "アルビーナ",
        "localizations": {
          "en": "Alvina"
        }
      }
    }
  },
  {
    "id": 8,
    "properties": {
      "999008199": {
        "text": "頭が混乱してるよ、そもそも……",
        "localizations": {
          "en": "My head's spinning, and besides..."
