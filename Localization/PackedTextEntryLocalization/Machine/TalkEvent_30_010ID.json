      },
      "2072370017": {
        "text": "シトリン",
        "localizations": {
          "en": "Citrine"
        }
      }
    }
  },
  {
    "id": 10,
    "properties": {
      "999008199": {
        "text": "俺とゼロが必要になるなど、いったい何ごとかと思えば……",
        "localizations": {
          "en": "I wondered what could possibly require me and Zero..."
