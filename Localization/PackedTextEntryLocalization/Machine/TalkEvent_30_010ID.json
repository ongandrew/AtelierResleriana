[
  {
    "id": 0,
    "properties": {
      "999008199": {
        "text": "何が管理よ、そんなのただの支配じゃない……！",
        "localizations": {
          "en": "Management? That's just control...!"
        }
      },
      "2072370017": {
        "text": "ヴァレリア",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 1,
    "properties": {
      "999008199": {
        "text": "だったら問答無用、力ずくで言うことを聞かせるか？",
        "localizations": {
          "en": "Then we'll skip the questions and make you obey by force?"
        }
      },
      "2072370017": {
        "text": "ヘルト",
        "localizations": {
          "en": "Held"
        }
      }
    }
  },
  {
    "id": 2,
    "properties": {
      "999008199": {
        "text": "分かりやすくて、その趣向望むところだが",
        "localizations": {
          "en": "That would be simple. I'd even welcome it."
        }
      },
      "2072370017": {
        "text": "ヘルト",
        "localizations": {
          "en": "Held"
        }
      }
    }
  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "うむ。てっきり襲ってきてくれるかと",
        "localizations": {
          "en": "Indeed. I was rather hoping you'd attack us."
