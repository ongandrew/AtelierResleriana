      "2072370017": {
        "text": "シトリン",
        "localizations": {
          "en": "Citrine"
        }
      }
    }
  },
  {
    "id": 9,
    "properties": {
      "999008199": {
        "text": "ヘルトがアウグストの言うことを素直に聞くなんて",
        "localizations": {
          "en": "Since when does Held willingly listen to August?"
