      "2072370017": {
        "text": "シトリン",
        "localizations": {
          "en": "Citrine"
        }
      }
    }
  },
  {
    "id": 10,
    "properties": {
      "999008199": {
        "text": "足を掬われるってのが相場だけどね",
        "localizations": {
          "en": "...are always the first ones to trip over their own feet."
