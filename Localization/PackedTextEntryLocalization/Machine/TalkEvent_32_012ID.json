[
  {
    "id": 0,
    "properties": {
      "999008199": {
        "text": "ふっ！",
        "localizations": {
          "en": "Ha!"
        }
      },
      "2072370017": {
        "text": "ヨハナ",
        "localizations": {
          "en": "Johanna"
        }
      }
    }
  },
  {
    "id": 1,
    "properties": {
      "999008199": {
        "text": "今ので最後だね。\nみんな、お疲れさま",
        "localizations": {
          "en": "That's the last of them. Nice work, everyone."
        }
      },
      "2072370017": {
        "text": "クレオ",
        "localizations": {
          "en": "Creo"
        }
      }
    }
  },
  {
    "id": 2,
    "properties": {
      "999008199": {
        "text": "ケガしていないかい？",
        "localizations": {
          "en": "Is anyone hurt?"
        }
      },
      "2072370017": {
        "text": "ロマン",
        "localizations": {
          "en": "Roman"
        }
      }
    }
  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "大丈夫！\u3000寒かったけどハンマーのおかげで\nあったまってきた！",
        "localizations": {
          "en": "All good! It was freezing, but swinging my hammer warmed me right up!"
        }
      },
      "2072370017": {
        "text": "イザナ",
        "localizations": {
          "en": "Izana"
        }
      }
    }
  },
  {
    "id": 4,
    "properties": {
      "999008199": {
        "text": "ヨハナちゃんも、相変わらずの技の冴え！",
        "localizations": {
          "en": "And Johanna, sharp as ever!"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 5,
    "properties": {
      "999008199": {
        "text": "これくらい当然よ、天才だからね！",
        "localizations": {
          "en": "Obviously. I am a genius, after all."
        }
      },
      "2072370017": {
        "text": "ヨハナ",
        "localizations": {
          "en": "Johanna"
        }
      }
    }
  },
  {
    "id": 6,
    "properties": {
      "999008199": {
        "text": "待って、まだ気配がするわ！",
        "localizations": {
          "en": "Wait—I'm still sensing something!"
        }
      },
      "2072370017": {
        "text": "メーヴェ",
        "localizations": {
          "en": "Mowen"
        }
      }
    }
  },
  {
    "id": 7,
    "properties": {
      "999008199": {
        "text": "こっち！\u3000船に取り付いてるよ！",
        "localizations": {
          "en": "Over here! Something's latched onto the hull!"
        }
      },
      "2072370017": {
        "text": "クレオ",
        "localizations": {
          "en": "Creo"
        }
      }
    }
  },
  {
    "id": 8,
    "properties": {
      "999008199": {
        "text": "させない！！\u3000レスナと、レスナの夢は私が守る！！",
        "localizations": {
          "en": "Not on my watch!! Resna and her dream—I'll protect them both!!"
        }
      },
      "2072370017": {
        "text": "メーヴェ",
        "localizations": {
          "en": "Mowen"
        }
      }
    }
  },
  {
    "id": 9,
    "properties": {
      "999008199": {
        "text": "速っ……！",
        "localizations": {
          "en": "She's so fast...!"
        }
      },
      "2072370017": {
        "text": "イザナ",
        "localizations": {
          "en": "Izana"
        }
      }
    }
  },
  {
    "id": 10,
    "properties": {
      "999008199": {
        "text": "や、やるじゃない……ちょっと認めざるを得ないかも",
        "localizations": {
          "en": "O-okay... I'll admit, that was impressive."
        }
      },
      "2072370017": {
        "text": "ヨハナ",
        "localizations": {
          "en": "Johanna"
        }
      }
    }
  },
  {
    "id": 11,
    "properties": {
      "999008199": {
        "text": "さすが「閃光」の異名を持つ冒険者。\nとんでもない切れ味ね！",
        "localizations": {
          "en": "The adventurer they call 'Lightning'—now I see why. That was razor sharp!"
        }
      },
      "2072370017": {
        "text": "クレオ",
        "localizations": {
          "en": "Creo"
        }
      }
    }
  },
  {
    "id": 12,
    "properties": {
      "999008199": {
        "text": "子を想う母は強いから",
        "localizations": {
          "en": "A mother fighting for her child doesn't leave room for weakness."
        }
      },
      "2072370017": {
        "text": "メーヴェ",
        "localizations": {
          "en": "Mowen"
        }
      }
    }
  },
  {
    "id": 13,
    "properties": {
      "999008199": {
        "text": "それに……同じ空の下、どこかにいる愛するユリウスも\nきっと力を貸してくれている、そんな気がするの",
        "localizations": {
          "en": "And... I have a feeling Julius is out there somewhere under the same sky, lending me his strength too."
        }
      },
      "2072370017": {
        "text": "メーヴェ",
        "localizations": {
          "en": "Mowen"
        }
      }
    }
  },
  {
    "id": 14,
    "properties": {
      "999008199": {
        "text": "お母さんに、お父さん……友達に、先輩、\n王族の人まで、助けてくれる……",
        "localizations": {
          "en": "My mom, my dad... my friends, my seniors, even royalty—everyone stepping up for me..."
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 15,
    "properties": {
      "999008199": {
        "text": "私って、恵まれてるなぁ。\n皆さん、改めて、感謝申し上げます！！",
        "localizations": {
          "en": "I'm really so lucky. From the bottom of my heart—thank you all, truly!!"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 16,
    "properties": {
      "999008199": {
        "text": "何を言っているんだい。私たちをこうして引き合わせて\n繋ぎとめているのはレスナ、君じゃないか",
        "localizations": {
          "en": "What are you talking about? The one who brought us all together and kept us here—that's you, Resna."
        }
      },
      "2072370017": {
        "text": "ロマン",
        "localizations": {
          "en": "Roman"
        }
      }
    }
  },
  {
    "id": 17,
    "properties": {
      "999008199": {
        "text": "レスナが恵まれてるって言うなら、それはきっと\nここまでレスナがみんなに恵んだからよ",
        "localizations": {
          "en": "If you're lucky, it's because you've given so much to everyone around you first."
        }
      },
      "2072370017": {
        "text": "ヨハナ",
        "localizations": {
          "en": "Johanna"
        }
      }
    }
  },
  {
    "id": 18,
    "properties": {
      "999008199": {
        "text": "……ほんとに、ありがとう！",
        "localizations": {
          "en": "...Thank you. Really, truly, thank you!"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 19,
    "properties": {
      "999008199": {
        "text": "みんなが手伝ってくれて、応援してくれてる。\nだから、あと少し……果ての大陸まで、絶対！",
        "localizations": {
          "en": "With everyone helping and cheering me on—just a little further. I will make it to World's End!"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 20,
    "properties": {
      "999008199": {
        "text": "また魔物、上がって来るよ！\nハンマーで海の藻屑にしてあげる！",
        "localizations": {
          "en": "More monsters climbing up! I'll send them straight to the bottom of the sea!"
        }
      },
      "2072370017": {
        "text": "イザナ",
        "localizations": {
          "en": "Izana"
        }
      }
    }
  },
  {
    "id": 21,
    "properties": {
      "999008199": {
        "text": "――たどり着いてみせる！！",
        "localizations": {
          "en": "—And I will get us there!!"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  }
]