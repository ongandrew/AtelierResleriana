[
  {
    "id": 0,
    "properties": {
      "999008199": {
        "text": "ただいま戻りました……",
        "localizations": {
          "en": "I'm back..."
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 1,
    "properties": {
      "999008199": {
        "text": "あ、レスナちゃん！\u3000おかえり！",
        "localizations": {
          "en": "Oh, Resna! Welcome back!"
        }
      },
      "2072370017": {
        "text": "ソフィー",
        "localizations": {
          "en": "Sophie"
        }
      }
    }
  },
  {
    "id": 2,
    "properties": {
      "999008199": {
        "text": "待っていましたよ",
        "localizations": {
          "en": "We've been waiting for you."
        }
      },
      "2072370017": {
        "text": "プラフタ",
        "localizations": {
          "en": "Plachta"
        }
      }
    }
  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "え、どうかしたんですか？",
        "localizations": {
          "en": "Huh? Did something happen?"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 4,
    "properties": {
      "999008199": {
        "text": "あたしたち、ちょっと素材の採取に\n出かけようとしてたんだけど……",
        "localizations": {
          "en": "We were just about to head out to gather some materials..."
        }
      },
      "2072370017": {
        "text": "ソフィー",
        "localizations": {
          "en": "Sophie"
        }
      }
    }
  },
  {
    "id": 5,
    "properties": {
      "999008199": {
        "text": "ただ、彼女を一人にするわけにもいきませんでしたので",
        "localizations": {
          "en": "But we didn't want to leave her alone."
        }
      },
      "2072370017": {
        "text": "プラフタ",
        "localizations": {
          "en": "Plachta"
        }
      }
    }
  },
  {
    "id": 6,
    "properties": {
      "999008199": {
        "text": "ああ……はい。どうぞお願いします",
        "localizations": {
          "en": "Ah... yes. Please go ahead."
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 7,
    "properties": {
      "999008199": {
        "text": "それじゃあ、また後でね！",
        "localizations": {
          "en": "See you later then!"
        }
      },
      "2072370017": {
        "text": "ソフィー",
        "localizations": {
          "en": "Sophie"
        }
      }
    }
  },
  {
    "id": 8,
    "properties": {
      "999008199": {
        "text": "…………",
        "localizations": {
          "en": "..."
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 9,
    "properties": {
      "999008199": {
        "text": "ねぇ、ヴァレリア",
        "localizations": {
          "en": "Hey, Valeria..."
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 10,
    "properties": {
      "999008199": {
        "text": "本当に、ちゃんと元通りになるのかな……",
        "localizations": {
          "en": "Will you really go back to being yourself...?"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 11,
    "properties": {
      "999008199": {
        "text": "ヴァレリアは、私なら治せるって言ってくれたけど……",
        "localizations": {
          "en": "You said I could heal you, but..."
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 12,
    "properties": {
      "999008199": {
        "text": "私なんかに、できるのかな……",
        "localizations": {
          "en": "Can someone like me really do it...?"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 13,
    "properties": {
      "999008199": {
        "text": "師匠は、何も教えてくれない……っ",
        "localizations": {
          "en": "Miss Saskia, won't tell me anything..."
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 14,
    "properties": {
      "999008199": {
        "text": "このアトリエだけ残して、勝手にいなくなって……！",
        "localizations": {
          "en": "Just leaving this atelier behind and disappearing...!"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 15,
    "properties": {
      "999008199": {
        "text": "ヴァレリアの気持ちが作り物だなんて、\n勝手なことばかり言って……！",
        "localizations": {
          "en": "Saying such cruel things about your feelings being artificial...!"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 16,
    "properties": {
      "999008199": {
        "text": "どうして……",
        "localizations": {
          "en": "Why..."
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 17,
    "properties": {
      "999008199": {
        "text": "どうして、こんなことをするの……",
        "localizations": {
          "en": "Why would they do this...?"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 18,
    "properties": {
      "999008199": {
        "text": "嫌だよ……",
        "localizations": {
          "en": "I hate this..."
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 19,
    "properties": {
      "999008199": {
        "text": "ヴァレリアがいなくなっちゃうなんて、嫌……",
        "localizations": {
          "en": "I can't stand the thought of losing you..."
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 20,
    "properties": {
      "999008199": {
        "text": "……レスナちゃん",
        "localizations": {
          "en": "...Resna."
        }
      },
      "2072370017": {
        "text": "イザナ",
        "localizations": {
          "en": "Izana"
        }
      }
    }
  },
  {
    "id": 21,
    "properties": {
      "999008199": {
        "text": "……！\u3000イザナ、ちゃん……",
        "localizations": {
          "en": "...! Izana..."
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 22,
    "properties": {
      "999008199": {
        "text": "大丈夫。大丈夫だから",
        "localizations": {
          "en": "It's okay. Everything will be okay."
        }
      },
      "2072370017": {
        "text": "イザナ",
        "localizations": {
          "en": "Izana"
        }
      }
    }
  },
  {
    "id": 23,
    "properties": {
      "999008199": {
        "text": "っ……",
        "localizations": {
          "en": "*sniff*..."
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 24,
    "properties": {
      "999008199": {
        "text": "ぐすっ……わあぁぁぁっ……！",
        "localizations": {
          "en": "*sob* Waaaaaah...!"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 25,
    "properties": {
      "999008199": {
        "text": "私ね、ヴァレリアが私と友達になって、\n隣にいてくれることが嬉しくてたまらなかった",
        "localizations": {
          "en": "I was so happy when Valeria became my friend... just having her by my side meant everything to me."
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 26,
    "properties": {
      "999008199": {
        "text": "でも、それは私を好きになるよう刷り込まれて\n創られていたからだったんだなって",
        "localizations": {
          "en": "But now I realize she was conditioned to like me... created that way from the very beginning..."
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 27,
    "properties": {
      "999008199": {
        "text": "仕組まれてなくたって、ヴァレリアはきっと\nレスナちゃんを好きになったよ",
        "localizations": {
          "en": "Whether she was conditioned to or not, I'm sure Valeria would've liked you anyway. She made plenty of other friends too, didn't she?"
        }
      },
      "2072370017": {
        "text": "イザナ",
        "localizations": {
          "en": "Izana"
        }
      }
    }
  },
  {
    "id": 28,
    "properties": {
      "999008199": {
        "text": "だってヴァレリアはアタシや色んな人たちと\nちゃんと友達になってたもん",
        "localizations": {
          "en": "I mean, she became friends with me and everyone else all on her own!"
        }
      },
      "2072370017": {
        "text": "イザナ",
        "localizations": {
          "en": "Izana"
        }
      }
    }
  },
  {
    "id": 29,
    "properties": {
      "999008199": {
        "text": "私、ちゃんとヴァレリアと友達になりたい。\n私にとって、ヴァレリアとの日々は嘘じゃない",
        "localizations": {
          "en": "I want to be real friends with Valeria. Everything we shared together... it wasn't a lie to me."
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 30,
    "properties": {
      "999008199": {
        "text": "うん",
        "localizations": {
          "en": "Yeah."
        }
      },
      "2072370017": {
        "text": "イザナ",
        "localizations": {
          "en": "Izana"
        }
      }
    }
  },
  {
    "id": 31,
    "properties": {
      "999008199": {
        "text": "でもヴァレリア自身、すごく辛かったんだと思う。\n自分の道が勝手に決められてたんだから",
        "localizations": {
          "en": "But Valeria must have been in so much pain... having her path decided for her like that."
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 32,
    "properties": {
      "999008199": {
        "text": "自分が操られて大切な人を傷つけるのは許せないって。\nだから、こんなに無茶なことを……",
        "localizations": {
          "en": "She couldn't bear being controlled and hurting those she cared about. That's why she did something so reckless..."
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 33,
    "properties": {
      "999008199": {
        "text": "そうだね。ヴァレリアが起きたら、\nうんと叱ってあげなきゃ",
        "localizations": {
          "en": "You're right. When she wakes up, we'll have to scold her properly!"
        }
      },
      "2072370017": {
        "text": "イザナ",
        "localizations": {
          "en": "Izana"
        }
      }
    }
  },
  {
    "id": 34,
    "properties": {
      "999008199": {
        "text": "レスナちゃんに心配かけちゃダメでしょ！ってね",
        "localizations": {
          "en": "She can't go around making you worry like that!"
        }
      },
      "2072370017": {
        "text": "イザナ",
        "localizations": {
          "en": "Izana"
        }
      }
    }
  },
  {
    "id": 35,
    "properties": {
      "999008199": {
        "text": "ふふっ……うん",
        "localizations": {
          "en": "*giggle*... Yeah."
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 36,
    "properties": {
      "999008199": {
        "text": "ありがと、イザナちゃん……",
        "localizations": {
          "en": "Thanks, Izana..."
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 37,
    "properties": {
      "999008199": {
        "text": "…………",
        "localizations": {
          "en": "..."
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 38,
    "properties": {
      "999008199": {
        "text": "もう、レスナちゃんも人のこと言えないじゃん。\n無茶ばっかりするんだから",
        "localizations": {
          "en": "Hey, you're one to talk! Always pushing yourself too hard."
        }
      },
      "2072370017": {
        "text": "イザナ",
        "localizations": {
          "en": "Izana"
        }
      }
    }
  },
  {
    "id": 39,
    "properties": {
      "999008199": {
        "text": "ちゃんと休んでね。おやすみ、レスナちゃん",
        "localizations": {
          "en": "Make sure you get some rest. Good night, Resna."
        }
      },
      "2072370017": {
        "text": "イザナ",
        "localizations": {
          "en": "Izana"
        }
      }
    }
  }
]