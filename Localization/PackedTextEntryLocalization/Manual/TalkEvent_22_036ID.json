      "2072370017": {
        "text": "ザスキア",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 43,
    "properties": {
      "999008199": {
        "text": "でも、あなたたちなら、それを再びたどることができる",
        "localizations": {
          "en": "But you two might just be able to walk it once again."
        }
      },
      "2072370017": {
        "text": "ザスキア",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 44,
    "properties": {
      "999008199": {
        "text": "師匠。先ほどお伝えした通りです",
        "localizations": {
          "en": "As I said before..."
