      },
      "2072370017": {
        "text": "ザスキア",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 40,
    "properties": {
      "999008199": {
        "text": "かつて、この世界には星の恵みが降り注いだ",
        "localizations": {
          "en": "Long ago, this world was blessed by starlight."
        }
