      },
      "2072370017": {
        "text": "ヴァレリア",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 50,
    "properties": {
      "999008199": {
        "text": "うん……",
        "localizations": {
          "en": "Yeah..."
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 51,
    "properties": {
      "999008199": {
        "text": "師匠！\u3000行きます！",
        "localizations": {
          "en": "Miss Saskia! Here we come!"
        }
