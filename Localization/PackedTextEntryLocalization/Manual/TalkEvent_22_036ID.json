      },
      "2072370017": {
        "text": "ヴァレリア",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 39,
    "properties": {
      "999008199": {
        "text": "星に導かれた者同士、ふさわしい舞台でしょう？",
        "localizations": {
          "en": "A fitting stage for those guided by the stars, wouldn't you say?"
