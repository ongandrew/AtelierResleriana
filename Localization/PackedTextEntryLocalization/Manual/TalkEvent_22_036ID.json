[
  {
    "id": 0,
    "properties": {
      "999008199": {
        "text": "師匠。私を、私たちを、認めてください！",
        "localizations": {
          "en": "Miss Saskia, please acknowledge me—acknowledge us!"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 1,
    "properties": {
      "999008199": {
        "text": "この程度の腕で？\u3000まだまだよ、レスナ！",
        "localizations": {
          "en": "With skills like that? You're still not ready, Resna!"
        }
      },
      "2072370017": {
        "text": "ザスキア",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 2,
    "properties": {
      "999008199": {
        "text": "そんなものでは！\u3000やはり私がいないと心配ね！",
        "localizations": {
          "en": "That's nowhere near enough! This is exactly why I worry when I'm not around!"
        }
      },
      "2072370017": {
        "text": "ザスキア",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "何が心配ですか！\u3000私がいないと！",
        "localizations": {
          "en": "What's there to worry about?! You're the one who needs me!"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 4,
    "properties": {
      "999008199": {
        "text": "掃除もできないくせに！",
        "localizations": {
          "en": "You can't even clean up after yourself!"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 5,
    "properties": {
      "999008199": {
        "text": "それは関係ないでしょう！",
        "localizations": {
          "en": "That has nothing to do with this!"
        }
      },
      "2072370017": {
        "text": "ザスキア",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 6,
    "properties": {
      "999008199": {
        "text": "掃除をするのも私！",
        "localizations": {
          "en": "I'm the one who does the cleaning!"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 7,
    "properties": {
      "999008199": {
        "text": "ご飯を作るのも私！",
        "localizations": {
          "en": "I'm the one who cooks!"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 8,
    "properties": {
      "999008199": {
        "text": "師匠がいないと私はダメ？",
        "localizations": {
          "en": "You think I can't manage without you?"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 9,
    "properties": {
      "999008199": {
        "text": "師匠の方が、私がいないとダメなんでしょ！",
        "localizations": {
          "en": "You're the one who can't manage without me!"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 10,
    "properties": {
      "999008199": {
        "text": "口の利き方に気をつけなさい！",
        "localizations": {
          "en": "Mind your tongue!"
        }
      },
      "2072370017": {
        "text": "ザスキア",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 11,
    "properties": {
      "999008199": {
        "text": "くぁ……っ！",
        "localizations": {
          "en": "Agh...!"
