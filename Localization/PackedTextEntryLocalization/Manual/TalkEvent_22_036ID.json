      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 45,
    "properties": {
      "999008199": {
        "text": "私たちは私たちの道を歩みます",
        "localizations": {
          "en": "We'll forge our own path!"
