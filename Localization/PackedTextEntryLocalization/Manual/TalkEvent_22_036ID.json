      "2072370017": {
        "text": "ヴァレリア",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 48,
    "properties": {
      "999008199": {
        "text": "でも……なんでかしら。この身体が言ってるのよ",
        "localizations": {
          "en": "But... somehow... my body is telling me..."
        }
      },
      "2072370017": {
        "text": "ヴァレリア",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 49,
    "properties": {
      "999008199": {
        "text": "レスナについていきなさい、って",
        "localizations": {
          "en": "To follow you, Resna"
