      "2072370017": {
        "text": "ザスキア",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 41,
    "properties": {
      "999008199": {
        "text": "私たちはそれを力に変え、文明を発展させた",
        "localizations": {
          "en": "We transformed that blessing into power, advancing our civilization."
        }
