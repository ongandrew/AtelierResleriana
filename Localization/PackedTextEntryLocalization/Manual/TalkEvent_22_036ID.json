      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 47,
    "properties": {
      "999008199": {
        "text": "ええ。私はまだ、自分が何者なのか分からない",
        "localizations": {
          "en": "Yes. I still don't know who I really am..."
