      "2072370017": {
        "text": "ヴァレリア",
        "localizations": {
          "en": "Valeria"
        }
      }
    }
  },
  {
    "id": 33,
    "properties": {
      "999008199": {
        "text": "全力を超えた、全身全霊で行きます。師匠",
        "localizations": {
          "en": "I'm going all out—beyond my limits, with everything I've got!"
        }
      },
      "2072370017": {
        "text": "レスナ",
        "localizations": {
          "en": "Resna"
        }
      }
    }
  },
  {
    "id": 34,
    "properties": {
      "999008199": {
        "text": "その石……しっかりと解析して使いこなしているわね",
        "localizations": {
          "en": "That stone... you've analyzed it thoroughly and mastered its use..."
        }
