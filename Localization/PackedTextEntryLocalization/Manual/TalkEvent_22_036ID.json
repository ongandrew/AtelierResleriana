  },
  {
    "id": 37,
    "properties": {
      "999008199": {
        "text": "私も敬意を払わないとね",
        "localizations": {
          "en": "Then I should show you proper respect."
        }
      },
      "2072370017": {
        "text": "ザスキア",
        "localizations": {
          "en": "Saskia"
        }
      }
    }
  },
  {
    "id": 38,
    "properties": {
      "999008199": {
        "text": "ここは……",
        "localizations": {
          "en": "This place is..."
