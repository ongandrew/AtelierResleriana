[
  {
    "id": 0,
    "properties": {
      "999008199": {
        "text": "くっ！\u3000野郎、海の中なら優位に立てると踏んだか",
        "localizations": {
          "en": "Tch! The bastard thinks it's got the upper hand underwater, eh?"
        }
      },
      "2072370017": {
        "text": "ランツェ",
        "localizations": {
          "en": "Lanze"
        }
      }
    }
  },
  {
    "id": 1,
    "properties": {
      "999008199": {
        "text": "厄介ですね……\nこのままでは、一方的にやられてしまいます",
        "localizations": {
          "en": "This is troublesome... At this rate, we'll be completely overwhelmed."
        }
      },
      "2072370017": {
        "text": "プラフタ",
        "localizations": {
          "en": "Plachta"
        }
      }
    }
  },
  {
    "id": 2,
    "properties": {
      "999008199": {
        "text": "ちょっとでも上に上がってきたときを狙って……\n撃つ！\u3000撃つ！",
        "localizations": {
          "en": "If you even surface by a little... Fire! Keep firing!"
        }
      },
      "2072370017": {
        "text": "ライザ",
        "localizations": {
          "en": "Ryza"
        }
      }
    }
  },
  {
    "id": 3,
    "properties": {
      "999008199": {
        "text": "ダメです！\u3000効いてません！\n船底に取り付けてある武器も、効果が薄いようです",
        "localizations": {
          "en": "It's no good! Nothing's working! Even the hull-mounted weapons barely seem to affect it!"
        }
      },
      "2072370017": {
        "text": "フロッケ",
        "localizations": {
          "en": "Flocke"
        }
      }
    }
  },
  {
    "id": 4,
    "properties": {
      "999008199": {
        "text": "くっ……こうなったら、飛び込んで直接殴ろうかしら！",
        "localizations": {
          "en": "Ngh... Maybe I should just dive in and punch it!"
